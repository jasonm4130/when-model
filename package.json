{
  "name": "when-model",
  "version": "0.0.1",
  "private": true,
  "description": "Frontier AI model release intelligence dashboard: DROPCON from Polymarket odds, OpenRouter listings, Hugging Face, Hacker News and lab feeds",
  "homepage": "https://whenmodel.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonm4130/when-model.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "validate": "pnpm lint && pnpm check && pnpm test --coverage && pnpm build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "backtest": "tsx scripts/backtest/run.ts",
    "backtest:replay": "tsx scripts/backtest/replay.ts",
    "brand": "tsx scripts/brand/render.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.22.0"
}
