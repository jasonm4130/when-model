&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; clarify approximate web search location defaults (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3953&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3953/hovercard&quot;&gt;#3953&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/a95c95ed372476168e9893723ff694ead5db8586&quot;&gt;a95c95e&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; clarify Realtime modality array definitions (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3954&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3954/hovercard&quot;&gt;#3954&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/e79cf53878b1d8580fac3a46e375eb98d9ca161d&quot;&gt;e79cf53&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; correct fine-tuning bounds and Realtime response reference (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3949&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3949/hovercard&quot;&gt;#3949&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/325a948a545add0201e082e778ca11b90ddb9426&quot;&gt;325a948&lt;/a&gt;)&lt;/li&gt;
