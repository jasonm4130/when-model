  <entry>
    <id>tag:github.com,2008:Repository/307213173/v3.19.0</id>
    <updated>2026-09-23T00:08:02Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/openai/openai-python/releases/tag/v3.19.0"/>
    <title>v3.19.0</title>
    <content type="html">&lt;h2&gt;&lt;a href=&quot;https://github.com/openai/openai-python/compare/v3.18.0...v3.19.0&quot;&gt;3.19.0&lt;/a&gt; (2026-09-22)&lt;/h2&gt;
&lt;h3&gt;Features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add GCP external storage support (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3943&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3943/hovercard&quot;&gt;#3943&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/d12d60fff9f5624f2dc50ade3d832028f4fecaa7&quot;&gt;d12d60f&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add GPT-Rosalind research model (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3940&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3940/hovercard&quot;&gt;#3940&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/d041d736f75f03f6c87aa77f932823011691bac5&quot;&gt;d041d73&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;_utils/_transform:&lt;/strong&gt; propagate &lt;strong&gt;api_exclude&lt;/strong&gt; in _async_transform_recursive (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3324&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3324/hovercard&quot;&gt;#3324&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/161ae65ea676a000a156ba0dacfd904532b52473&quot;&gt;161ae65&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; handle omission markers in queued WebSocket events (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3944&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3944/hovercard&quot;&gt;#3944&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/63e46169a7c6525ec90c7f2815a05d56e795cbcf&quot;&gt;63e4616&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;client:&lt;/strong&gt; retry only replayable request content (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3771&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3771/hovercard&quot;&gt;#3771&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/6e0c2beeb639e42ff74f14135151d8bcb1e5b245&quot;&gt;6e0c2be&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;client:&lt;/strong&gt; tolerate older optional aiohttp installations (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3941&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3941/hovercard&quot;&gt;#3941&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/0d91efbe5084c2f572688e8e9a05c0a91c8c0319&quot;&gt;0d91efb&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;helpers:&lt;/strong&gt; use asyncio.get_running_loop() inside async methods (&lt;a href=&quot;https://github.com/openai/openai-python/issues/3289&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/3289/hovercard&quot;&gt;#3289&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/bac3545eee5a0dfd348a6766bca3e904308792dd&quot;&gt;bac3545&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
