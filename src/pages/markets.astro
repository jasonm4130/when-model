---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHead from '../components/PageHead.astro';
import Markets from '../components/Markets.astro';
import Footer from '../components/Footer.astro';
import { loadDashboard } from '../app/load-dashboard';
import { pageMeta } from '../ui/site';
import { usd } from '../ui/format';

const d = await loadDashboard();
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=900');
const view = { page: 'markets' } as const;
const meta = pageMeta(view);
const traded = d.markets.reduce((sum, m) => sum + (m.vol24 || 0), 0);
---
<Layout title={meta.title} description={meta.description}>
  <Header d={d} view={view} />
  <main id="main">
    <PageHead
      title="Markets"
      kicker="Polymarket"
      intro="Every release market on Polymarket, by line: what traders will pay to be right about a launch date."
      fact={d.markets.length ? { figure: usd(traded), caption: `traded in 24 hours across ${d.markets.length} markets` } : undefined}
    />
    <div class="wrap page-body">
      <Markets d={d} />
    </div>
  </main>
  <Footer generatedAt={d.generatedAt} d={d} />
</Layout>
