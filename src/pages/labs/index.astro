---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHead from '../../components/PageHead.astro';
import Labs from '../../components/Labs.astro';
import Footer from '../../components/Footer.astro';
import { loadDashboard } from '../../app/load-dashboard';
import { labPath, pageMeta } from '../../ui/site';
import { lineName } from '../../ui/lines';
import Bullet from '../../components/Bullet.astro';

const d = await loadDashboard();
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=900');
const view = { page: 'labs' } as const;
const meta = pageMeta(view);
// The busiest line, as the network ranks it.
const busiest = d.labs[0];
---
<Layout title={meta.title} description={meta.description}>
  <Header d={d} view={view} />
  <main id="main">
    <PageHead
      title="The network"
      kicker="Lines"
      intro="Every lab is a line. Ranked by heat; the odds are the market's chance of a release within seven days, shown only where the market is deep enough to trust."
      fact={busiest && { figure: String(busiest.heat), caption: `heat on the ${lineName(busiest.name)}, the busiest`, href: labPath(busiest.id) }}
    >
      {busiest && <Bullet slot="bullet" id={busiest.id} name={busiest.name} size="lg" decorative />}
    </PageHead>
    <div class="wrap page-body">
      <Labs d={d} />
    </div>
  </main>
  <Footer generatedAt={d.generatedAt} d={d} />
</Layout>
