---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHead from '../../components/PageHead.astro';
import Labs from '../../components/Labs.astro';
import Footer from '../../components/Footer.astro';
import { loadDashboard } from '../../app/load-dashboard';
import { pageMeta } from '../../ui/site';

const d = await loadDashboard();
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=900');
const view = { page: 'labs' } as const;
const meta = pageMeta(view);
---
<Layout title={meta.title} description={meta.description}>
  <Header d={d} view={view} />
  <main id="main">
    <PageHead title="The network" kicker="Lines" intro="Every lab is a line. Ranked by heat; the odds are the market's chance of a release within seven days, shown only where the market is deep enough to trust." />
    <div class="wrap page-body">
      <Labs d={d} />
    </div>
  </main>
  <Footer generatedAt={d.generatedAt} d={d} />
</Layout>
