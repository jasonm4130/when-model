---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHead from '../../components/PageHead.astro';
import Labs from '../../components/Labs.astro';
import Footer from '../../components/Footer.astro';
import { loadDashboard } from '../../app/load-dashboard';
import { pageMeta } from '../../ui/site';
import { timetableState } from '../../ui/departures';

const d = await loadDashboard();
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=900');
const view = { page: 'labs' } as const;
const meta = pageMeta(view);
// The page's question is when each line ships: its fact is how many lines the markets can time at all.
const oddsAvailable = d.measurement.inputs.oddsAvailable;
const timed = d.labs.filter((l) => timetableState(l, oddsAvailable) === 'scheduled').length;
const fact = oddsAvailable && d.labs.length
  ? { figure: String(timed), unit: ` of ${d.labs.length}`, caption: "lines with a 7-day timetable" }
  : undefined;
---
<Layout title={meta.title} description={meta.description}>
  <Header d={d} view={view} />
  <main id="main">
    <PageHead
      title="The network"
      kicker="Lines"
      intro="Every lab is a line. Ranked by heat; the odds are the market's chance of a release within seven days, shown only where the market is deep enough to trust."
      fact={fact}
    />
    <div class="wrap page-body">
      <Labs d={d} />
    </div>
  </main>
  <Footer generatedAt={d.generatedAt} d={d} />
</Layout>
