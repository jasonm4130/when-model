---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Dropcon from '../components/Dropcon.astro';
import Labs from '../components/Labs.astro';
import Markets from '../components/Markets.astro';
import Drops from '../components/Drops.astro';
import Feed from '../components/Feed.astro';
import History from '../components/History.astro';
import Footer from '../components/Footer.astro';
import Signals from '../components/Signals.astro';
import { loadDashboard, loadHistoryForPage } from '../app/load-dashboard';
import { dropconTitle } from '../ui/odds';

// History shares /api/history.json's 15-minute memo and never throws; it only feeds the strip.
const [d, history] = await Promise.all([loadDashboard(), loadHistoryForPage()]);
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=900');
const title = dropconTitle(d.dropcon);
---
<Layout title={title} description="Real-time frontier AI model release intelligence. Polymarket release odds read into one DROPCON level, with early warnings and fresh launches from OpenRouter, Hacker News, lab blogs, YouTube and the transformers registry.">
  <Header d={d} />
  <main id="main">
    <Dropcon d={d} history={history} />
    <Signals d={d} />
    <Labs d={d} />
    <Markets d={d} />
    <Drops d={d} />
    <Feed d={d} />
    <History />
  </main>
  <Footer generatedAt={d.generatedAt} />
</Layout>
