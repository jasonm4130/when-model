---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ServiceStatus from '../components/ServiceStatus.astro';
import DepartureSign from '../components/DepartureSign.astro';
import DepartureBoard from '../components/DepartureBoard.astro';
import Arrivals from '../components/Arrivals.astro';
import NetworkNotice from '../components/NetworkNotice.astro';
import Footer from '../components/Footer.astro';
import { loadDashboard } from '../app/load-dashboard';
import { dropconTitle } from '../ui/odds';

// The answer only: the level's week is drawn on /about, beside how the score adds up.
const d = await loadDashboard();
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=900');
const title = dropconTitle(d.dropcon);
---
<Layout title={title} description="Real-time frontier AI model release intelligence. Polymarket release odds read into the next model departing and one DROPCON level, with early warnings and fresh launches from OpenRouter, Hacker News, lab blogs, YouTube and the transformers registry.">
  <Header d={d} view={{ page: 'home' }} />
  <ServiceStatus c={d.dropcon} />
  <main id="main">
    <DepartureSign d={d} />
    <div class="wrap page-body">
      <div class="cols">
        <DepartureBoard d={d} />
        <div class="side">
          <Arrivals d={d} />
          <NetworkNotice d={d} />
        </div>
      </div>
    </div>
  </main>
  <Footer generatedAt={d.generatedAt} d={d} />
</Layout>
<style>
  .side { display: grid; gap: var(--s7); align-content: start; }
</style>
<script>
  // The site was one long page whose sections had hash anchors. A hash never reaches the server,
  // so an old link (#lab-anthropic, #markets) moves on to the page that now holds it.
  import { legacyHashTarget } from '../ui/site';

  const target = legacyHashTarget(location.hash);
  if (target) location.replace(target);
</script>
