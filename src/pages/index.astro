---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Dropcon from '../components/Dropcon.astro';
import Labs from '../components/Labs.astro';
import Markets from '../components/Markets.astro';
import Drops from '../components/Drops.astro';
import Feed from '../components/Feed.astro';
import History from '../components/History.astro';
import Footer from '../components/Footer.astro';
import { loadDashboard } from '../app/load-dashboard';

const d = await loadDashboard();
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=900');
const title = `DROPCON ${d.dropcon.level} · ${d.dropcon.name} — whenmodel`;
---
<Layout title={title} description="Real-time frontier AI model release intelligence. Polymarket odds, OpenRouter listings, Hugging Face trending, lab blogs and Hacker News fused into one DROPCON level.">
  <Header d={d} />
  <main id="main">
    <Dropcon d={d} />
    <Labs d={d} />
    <Markets d={d} />
    <Drops d={d} />
    <Feed d={d} />
    <History />
  </main>
  <Footer generatedAt={d.generatedAt} />
</Layout>
