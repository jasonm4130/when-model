---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHead from '../components/PageHead.astro';
import Signals from '../components/Signals.astro';
import RadarArrivals from '../components/RadarArrivals.astro';
import Drops from '../components/Drops.astro';
import Feed from '../components/Feed.astro';
import Footer from '../components/Footer.astro';
import { loadDashboard } from '../app/load-dashboard';
import { pageMeta } from '../ui/site';

const d = await loadDashboard();
// The page's one clock read: every panel ages its pill and relative times against this instant.
const now = Date.now();
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=900');
const view = { page: 'radar' } as const;
const meta = pageMeta(view);
const w = d.earlyWarnings;
const warnings = w.stealth.items.length + w.leaks.items.length + w.broadcasts.items.length + w.architectures.items.length + w.events.items.length;
// The page's figure counts every notice; Early warnings names each one, the unmarked train included.
const fact = { figure: String(warnings), caption: `early warning${warnings === 1 ? '' : 's'} posted, none scored`, href: '#warnings' };
---
<Layout title={meta.title} description={meta.description}>
  <Header d={d} view={view} />
  <main id="main">
    <PageHead title="Service notices" kicker="Radar" intro="What has come before launches, each with its track record, then the launches that already came. None of it moves the level." fact={fact} />
    <div class="wrap page-body">
      <Signals d={d} now={now} />
      <RadarArrivals d={d} now={now} />
      <Drops d={d} now={now} show="listings" />
      <Feed d={d} now={now} show="feed" />
      <details class="fold elsewhere" id="elsewhere">
        <summary class="fold-summary"><span>Elsewhere on the network <span class="what">open weights, papers, the X watchlist</span></span></summary>
        <div class="radar-pair inner">
          <Drops d={d} now={now} show="open" />
          <Feed d={d} now={now} show="watch" />
        </div>
      </details>
    </div>
  </main>
  <Footer generatedAt={d.generatedAt} d={d} />
</Layout>
<style>
  /* Fresh drops and the feed run full width, one above the other: their lengths never match, so
     side by side one always left a hole. The folded extras are short enough to pair. */
  .radar-pair { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s8); }
  .radar-pair > :global(*) { min-width: 0; }
  @media (min-width: 1100px) {
    .radar-pair { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
  @media (max-width: 900px) {
    .radar-pair { gap: var(--s7); }
  }
  .elsewhere > .fold-summary { border-top: 2px solid var(--rule); border-bottom-width: 1px; min-height: 56px; font-size: var(--t-sm); }
  .elsewhere .what { margin-left: var(--s3); font-weight: 500; letter-spacing: 0.04em; color: var(--ink-2); }
  .elsewhere .inner { padding-top: var(--s6); }
  @media (max-width: 640px) {
    .elsewhere .what { display: block; margin-left: 0; margin-top: var(--s1); }
  }
</style>
