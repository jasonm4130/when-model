---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHead from '../components/PageHead.astro';
import Bullet from '../components/Bullet.astro';
import { LABS } from '../domain/lab';
import { labPath } from '../ui/site';
---
<Layout title="Line not found — whenmodel" description="Not found" robots="noindex">
  <Header view={{ page: 'not-found' }} />
  <main id="main">
    <PageHead kicker="404" title="Line not found" intro="This model has not been released yet. No service runs from this address." />
    <div class="wrap nf">
      <p>Back to <a href="/">the departures</a>, or pick a line:</p>
      <div class="map">{LABS.map((l) => <Bullet id={l.id} name={l.name} size="lg" href={labPath(l.id)} />)}</div>
    </div>
  </main>
</Layout>
<style>
  .nf { padding-top: var(--s7); padding-bottom: var(--s8); font-size: var(--t-md); line-height: 28px; }
  .map { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s4); }
</style>
