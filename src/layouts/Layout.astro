---
import '../styles/global.css';
import '../styles/fonts.css';
interface Props { title: string; description: string; robots?: string }
const { title, description, robots } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://whenmodel.com').href;
const ogImage = new URL('/og-card-v2.png', Astro.site ?? 'https://whenmodel.com').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="whenmodel" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="whenmodel — DROPCON, a frontier AI release radar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="whenmodel — DROPCON, a frontier AI release radar" />
    <meta name="theme-color" content="#07060f" />
    <link rel="preload" href="/fonts/vt323.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/press-start-2p.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/json" href="/api/dashboard.json" title="whenmodel dashboard JSON" />
    <script is:inline defer src="https://app.skopia.dev/skopia.js" data-site="whenmodel" data-endpoint="https://app.skopia.dev/e"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
