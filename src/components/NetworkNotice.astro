---
/**
 * The home page's one service notice: the newest unmarked train (an anonymous OpenRouter slot), with
 * the track record of past ones. Absent when there is none.
 */
import type { Dashboard } from '../domain/dashboard';
import { dayLabel } from '../ui/departures';
import { ctx } from '../ui/format';
import { TRACK_LINES } from '../ui/signals';
interface Props { d: Dashboard }
const { d } = Astro.props;
const slot = d.earlyWarnings.stealth.items[0];
const built = Date.parse(d.generatedAt);
const more = d.earlyWarnings.stealth.items.length - 1;
---
{slot && (
  <aside class="notice" aria-labelledby="notice-title">
    <span class="notice-label">Service notice</span>
    <h3 id="notice-title">Unmarked train on the network</h3>
    <p><a href={slot.url ?? '/radar#ew-stealth'} target="_blank" rel="noopener"><b>{slot.name}</b></a> has been running since {dayLabel(Date.parse(slot.createdAt), built, false)} with no operator shown{slot.contextLength ? `, ${ctx(slot.contextLength)} context` : ''}.</p>
    <p class="quiet">{TRACK_LINES.stealth} <a class="keep" href="/radar#ew-stealth">{more > 0 ? `${more} more on Radar` : 'All notices on Radar'}</a></p>
  </aside>
)}
