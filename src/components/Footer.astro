---
interface Props {
  /** When the data on this page was produced: the dashboard build, or the backtest's raw pulls. */
  generatedAt: string;
  /** `backtest` says how to rebuild the page's data. */
  variant?: 'dashboard' | 'backtest';
}
const { generatedAt, variant = 'dashboard' } = Astro.props;
const REPO = 'https://github.com/jasonm4130/when-model';
const stamp = generatedAt.replace('T', ' ').slice(0, variant === 'backtest' ? 16 : 19);
---
<footer class="wrap foot">
  <p class="foot-note">For information and entertainment only: prediction market odds are crowd opinion, not lab roadmaps, and whenmodel is not affiliated with any lab. <a href="/about#disclaimer">The full disclaimer and every source</a>.</p>
  <div class="foot-row">
    {variant === 'backtest' ? (
      <span class="muted">DATA PULLED {stamp}Z · REPRODUCE: <a href="#reproduce"><code>pnpm backtest</code></a> · <a href={REPO} target="_blank" rel="noopener">source</a></span>
    ) : (
      <span class="muted">GENERATED {stamp}Z · EDGE-CACHED · <a href="/api/dashboard.json">dashboard.json</a> · <a href="/backtest">backtest</a> · <a href={REPO} target="_blank" rel="noopener">source</a></span>
    )}
    <span class="muted">whenmodel.com · built on Astro + Cloudflare Workers</span>
  </div>
</footer>
<style>
  .foot { margin: var(--s5) auto var(--s5); }
  .foot-note { padding-top: 16px; border-top: 3px solid var(--ink); }
  .foot-note { font-size: var(--fs-sm); line-height: 1.5; color: var(--ink-2); }
  .foot-row { display: flex; justify-content: space-between; gap: 8px 24px; flex-wrap: wrap; margin-top: 20px; padding-top: 12px; border-top: 1px solid var(--rule-soft); font-family: var(--font-label); font-size: var(--fs-pill); font-weight: 600; font-stretch: 112.5%; letter-spacing: 0.06em; }
  .foot-row code { font-size: 1.05em; letter-spacing: 0; }
</style>
