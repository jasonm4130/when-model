---
/**
 * The network: every line, ranked by heat, one row each linking to its line page. A row gives the
 * line's headline service, its 7-day odds (only when the market is deep enough to trust; a thin one
 * says "times unavailable", none says "no timetable"), its last arrival and any lead flags that
 * name it. One timing fact per row: the boarding window, which can open after the 7-day date, is on
 * the line's own page.
 */
import type { Dashboard } from '../domain/dashboard';
import { daysLabel, pct } from '../ui/format';
import { dayLabel, timetableState } from '../ui/departures';
import { lineName, serviceName } from '../ui/lines';
import { leadFlags } from '../ui/signals';
import { labPath } from '../ui/site';
import Bullet from './Bullet.astro';
interface Props { d: Dashboard }
const { d } = Astro.props;
const oddsAvailable = d.measurement.inputs.oddsAvailable;
const built = Date.parse(d.generatedAt);
const stealth = d.earlyWarnings.stealth.items.length;
const by = dayLabel(built + 7 * 86_400_000, built, false);
/** Odds under this are a long shot: printed quiet. */
const QUIET_BELOW = 0.1;
const STATE_TEXT = { 'times-unavailable': 'times unavailable', 'no-timetable': 'no timetable', offline: 'odds offline' } as const;
---
<section class="network" aria-labelledby="network-title">
  <div class="sec">
    <h2 id="network-title">All lines</h2>
    <span class="label">{d.labs.length} lines · busiest first</span>
  </div>
  <ol class="lines">
    <li class="lines-head" aria-hidden="true"><span>Line · service</span><span>Odds by {by}</span><span>Last arrival</span></li>
    {d.labs.map((l) => {
      const state = timetableState(l, oddsAvailable);
      const flags = leadFlags(d.earlyWarnings, l.id);
      return (
        <li class="line" id={`lab-${l.id}`}>
          <a class="lrow" href={labPath(l.id)}>
            <Bullet id={l.id} name={l.name} size="lg" decorative />
            <span class="who">
              <h3 class="lab-name">{lineName(l.name)}</h3>
              <span class="svc"><span class="fact">{l.odds ? serviceName(l.odds.family) : 'No release market'}</span> <span class="fact mono heat">· {l.status}</span> <span class="fact mono heat">· heat {l.heat}</span></span>
            </span>
            <span class:list={['odds', 'mono', { quiet: state !== 'scheduled', long: state === 'scheduled' && l.odds!.p7.p < QUIET_BELOW }]}>{state === 'scheduled' ? pct(l.odds!.p7.p) : STATE_TEXT[state]}</span>
            <span class="last"><span class="fact">{l.daysSince === undefined ? 'none listed' : l.daysSince === 0 ? 'today' : `${daysLabel(l.daysSince)} ago`}</span> <span class="fact mono">· {l.releases30d}/30d</span></span>
          </a>
          {flags.length > 0 && (
            <p class="flags">
              <span class="sr-only">Lead flags, shown but not scored:</span>
              {flags.map((f) => <a class="flag" href={f.href} title={f.detail}>{f.label}</a>)}
            </p>
          )}
        </li>
      );
    })}
  </ol>
  {stealth > 0 && (
    <p class="unmarked"><span class="notice-label">Service notice</span> {stealth} unmarked train{stealth === 1 ? '' : 's'} on the network, belonging to no line yet. <a href="/radar#ew-stealth">See Radar</a></p>
  )}
</section>
<style>
  .lines-head, .lrow { display: grid; grid-template-columns: 40px minmax(0, 1fr) 144px 144px; column-gap: var(--s4); align-items: center; }
  .lines-head { padding: var(--s3) 0; font-size: var(--t-xs); line-height: 16px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .lines-head span:first-child { grid-column: 1 / 3; }
  .lines-head span:not(:first-child) { text-align: right; }
  .line { border-top: 1px solid var(--rule-soft); }
  .line:last-child { border-bottom: 1px solid var(--rule-soft); }
  .lrow { padding: var(--s4) 0; text-decoration: none; }
  .lrow:hover { text-decoration: none; }
  .lrow:hover .lab-name { text-decoration: underline; text-underline-offset: 3px; }
  .who { min-width: 0; }
  .lab-name { font-size: var(--t-md); line-height: 28px; font-weight: 700; letter-spacing: -0.01em; }
  .svc { display: block; font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); overflow-wrap: anywhere; }
  .heat { font-size: var(--t-xs); }
  /* Each fact keeps its separator: a wrap never leaves a dot dangling at a line's end. */
  .fact { white-space: nowrap; }
  .svc .fact:first-child { white-space: normal; }
  .odds { text-align: right; font-size: var(--t-lg); line-height: 32px; font-weight: 500; }
  .odds.long { font-size: var(--t-md); line-height: 28px; font-weight: 400; color: var(--ink-2); }
  .odds.quiet { font-family: var(--sans); font-size: var(--t-sm); line-height: 20px; font-weight: 400; color: var(--ink-2); }
  .last { text-align: right; font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .flags { display: flex; flex-wrap: wrap; gap: var(--s2); margin: calc(var(--s2) * -1) 0 var(--s3) 56px; }
  .flag { padding: 0 6px; font-size: var(--t-xs); line-height: 20px; font-weight: 600; letter-spacing: 0.06em; background: var(--notice); color: var(--ink); }
  .unmarked { margin-top: var(--s5); font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .unmarked .notice-label { margin: 0 var(--s2) 0 0; }
  @media (max-width: 900px) {
    .lines-head { display: none; }
    .lrow { grid-template-columns: 32px minmax(0, 1fr) auto; grid-template-areas: 'b who odds' 'b last last'; column-gap: var(--s3); row-gap: 2px; padding: var(--s3) 0; }
    .lrow :global(.b) { grid-area: b; align-self: start; --d: 32px; }
    .who { grid-area: who; }
    .odds { grid-area: odds; align-self: start; font-size: var(--t-md); line-height: 28px; }
    .odds.quiet { font-size: var(--t-xs); line-height: 28px; }
    .last { grid-area: last; text-align: left; font-size: var(--t-xs); }
    .lab-name { font-size: var(--t-base); line-height: 28px; }
    .flags { margin-left: 44px; }
  }
</style>
