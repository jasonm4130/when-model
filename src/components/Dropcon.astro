---
import type { HistoryResponseBody } from '../app/load-dashboard';
import type { Dashboard } from '../domain/dashboard';
import { levelBandsText, WEIGHTS } from '../domain/dropcon';
import { SOURCE } from '../domain/sources';
import { dropconName, dropconPill, forecastAnswer, levelBaseRateText, topReadText } from '../ui/odds';
import { sourcePill } from '../ui/panels';
import DropconScope from './DropconScope.astro';
interface Props {
  d: Dashboard;
  /** The 30-day series; the instrument draws its last 7 days. Absent, it shows its offline state. */
  history?: HistoryResponseBody;
  now?: number;
}
const { d, history, now } = Astro.props;
const c = d.dropcon;
const colors: Record<number, string> = { 1: 'var(--red)', 2: 'var(--orange)', 3: 'var(--yellow)', 4: 'var(--cyan)', 5: 'var(--green)' };
// A floor or no signal is not a level reading: the number is muted, never a level's colour.
const color = c.state === 'ok' ? colors[c.level] : 'var(--muted)';
// A reading wears the markets panel's own Polymarket pill, so it turns STALE with the rest of the
// page; a floor or no signal says why there is no reading instead.
const pill = c.state === 'ok' ? sourcePill(d.sources, [SOURCE.polymarket], d.generatedAt, now ?? Date.now()) : dropconPill(c);
const hottest = d.labs[0];
const noLabData = c.state === 'no-signal';
const levelLine = c.state === 'ok' ? `LEVEL ${c.level} OF 5` : c.state === 'floor' ? 'NOT A MEASUREMENT' : 'NO SIGNAL';
---
<section class="section wrap reveal dc-hero" aria-labelledby="dc-title" style={`--lvl:${color}`}>
  <div class={`panel dropcon ${c.state}`}>
    <div class="panel-head">
      <h2 id="dc-title"><span aria-hidden="true">▣</span>DROPCON LEVEL</h2>
      <div class="pills">
        {d.landed.banner && <span class="pill warn" title={d.landed.bannerText}>MODELS JUST LANDED</span>}
        {'state' in pill ? (
          <span class={`pill ${pill.tone}`} title={pill.title} data-source-pill data-stale-at={pill.staleAt} data-stale-text={pill.staleText}>{pill.text}</span>
        ) : <span class={`pill ${pill.tone}`}>{pill.text}</span>}
      </div>
    </div>
    <div class="dc-lede">
      <p class="dc-name head"><span class="dc-of tiny">{levelLine}</span>{dropconName(c)}</p>
      <p class="dc-headline">{c.headline}</p>
    </div>

    <DropconScope d={d} history={history} now={now} />

  </div>

  <div class="panel dc-detail" id="dc-adds">
    <div class="dc-cols">
      <div>
        <h3 class="dc-sub tiny">HOW THE SCORE ADDS UP</h3>
        <ul class="dc-drivers" aria-label="How the score adds up">
          {c.provenance.map((row) => (
            <li>
              <span class="pts">{row.points}</span>
              <span class="why"><span class="tag lead">{row.tag}</span> {row.url ? <a href={row.url} target={row.url.startsWith('/') ? undefined : '_blank'} rel="noopener">{row.label}</a> : row.label} <span class="muted">({row.detail})</span></span>
            </li>
          ))}
          <li class="total"><span class="pts">{c.score}</span><span class="why">= LEAD SCORE <span class="muted">out of 100; the rows above add up to it</span></span></li>
        </ul>
        <p class="dc-bands muted">{levelBandsText()} Weights {WEIGHTS.market7d} / {WEIGHTS.market30dIncrement} / {WEIGHTS.repricing}, set by hand.</p>
        <p class="dc-blurb">{c.blurb}</p>
      </div>
      <div>
        {noLabData ? (
          <p class="dc-hot muted"><span class="tiny">HOTTEST LAB</span> No lab data: Polymarket and OpenRouter are both unreachable.</p>
        ) : hottest && (
          <a class="dc-hot" href={`#lab-${hottest.id}`} style={`--lab:${hottest.color}`}>
            <span class="tiny">HOTTEST LAB</span> <b><span aria-hidden="true">{hottest.glyph}</span> {hottest.name}</b> · heat {hottest.heat} · {topReadText(hottest, d.measurement.inputs.oddsAvailable)}
          </a>
        )}
        {d.landed.bannerText && <p class="dc-landed"><span aria-hidden="true">◆</span> {d.landed.bannerText} · <span class="muted">shown, not scored</span></p>}
        <div class="dc-honest">
          <p class="dc-q"><b>Is this a forecast?</b> No — it's a hand-weighted lead score, not a probability. <a href="/backtest">See /backtest</a></p>
          <p class="dc-base">{levelBaseRateText()}</p>
          <details class="dc-more">
            <summary class="tiny">WHY IT'S NOT A PROBABILITY</summary>
            <p>{forecastAnswer(d.forecast)}</p>
            <ul>{c.notes.map((n) => <li>{n}</li>)}</ul>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .dc-hero { display: grid; gap: var(--gap); }
  .dc-lede { display: grid; gap: 6px; margin-bottom: 14px; }
  .dc-name { font-size: var(--fs-head); line-height: 1.4; color: var(--lvl); text-shadow: 0 0 6px color-mix(in srgb, var(--lvl) 50%, transparent); }
  .dropcon:not(.ok) .dc-name { text-shadow: none; }
  .dc-of { display: block; margin-bottom: 6px; color: var(--text); text-shadow: none; }
  .dc-headline { font-size: var(--fs-lg); color: #fff; }

  .dc-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 12px 28px; }
  .dc-blurb { margin-top: 10px; color: var(--muted); }
  .dc-hot { display: block; padding: 6px 8px; border: 1px dashed var(--line2); color: var(--text); font-size: var(--fs-md); }
  .dc-hot b { font-weight: 400; color: var(--lab, var(--text)); }
  a.dc-hot:hover { border-color: var(--lab, var(--cyan)); color: #fff; text-shadow: none; background: rgba(0, 229, 255, 0.04); }
  .dc-hot .tiny { color: var(--muted); margin-right: 6px; }
  .dc-landed { margin: 8px 0 0; color: var(--yellow); font-size: var(--fs-md); }
  .dc-sub { margin: 0 0 8px; color: var(--muted); }
  .dc-drivers { color: var(--muted); font-size: var(--fs-sm); display: grid; gap: 4px; }
  .dc-drivers li { display: grid; grid-template-columns: 3ch minmax(0, 1fr); gap: 10px; align-items: baseline; }
  .dc-drivers .why { overflow-wrap: anywhere; }
  .dc-drivers .pts { color: var(--lvl); text-align: right; font-variant-numeric: tabular-nums; }
  .dc-drivers .total { border-top: 1px dotted var(--line2); padding-top: 4px; color: var(--text); }
  .dc-bands { margin-top: 6px; font-size: var(--fs-xs); }
  .tag.lead { color: var(--cyan); padding: 2px 4px; margin-right: 2px; vertical-align: 2px; }
  .dc-honest { margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--line2); display: grid; gap: 6px; font-size: var(--fs-md); }
  .dc-q b { font-weight: 400; color: var(--yellow); }
  .dc-base { color: var(--muted); }
  .dc-more summary { color: var(--cyan); padding: 4px 0; }
  .dc-more summary::before { content: '+ '; }
  .dc-more[open] summary::before { content: '- '; }
  .dc-more p, .dc-more li { color: var(--muted); margin-top: 6px; }
  @media (max-width: 640px) {
    .dc-headline { font-size: var(--fs-body); }
  }
</style>
