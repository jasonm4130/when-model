---
import type { BroadcastRow } from '../../scripts/backtest/build';
import { signedHours, utcMinute } from '../../scripts/backtest/view';

interface Props {
  broadcasts: readonly BroadcastRow[];
  misses: readonly { model: string; note: string }[];
}
const { broadcasts, misses } = Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label="Scheduled broadcasts table">
  <table>
    <caption class="sr-only">OpenAI scheduled livestreams: when the upcoming-stream placeholder was published and when it started.</caption>
    <thead>
      <tr>
        <th scope="col">Launch</th>
        <th scope="col">Stream</th>
        <th scope="col" class="num">Placeholder published</th>
        <th scope="col" class="num">Starts</th>
        <th scope="col" class="num">Warning</th>
        <th scope="col">Evidence</th>
      </tr>
    </thead>
    <tbody>
      {broadcasts.map((b) => (
        <tr>
          <th scope="row">{b.model}</th>
          <td><a href={b.url} rel="noopener" target="_blank">{b.title}</a><span class="muted small block">{b.note}</span></td>
          <td class="num">{utcMinute(b.publishedAt)}</td>
          <td class="num">{utcMinute(b.startsAt)}</td>
          <td class="num">{signedHours(b.leadH)}</td>
          <td>{b.captureUrl ? <a href={b.captureUrl} rel="noopener" target="_blank">Wayback, upcoming</a> : <span class="muted">no capture</span>}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<h3 class="tiny sub">Launches a broadcast watch would have missed</h3>
<ul class="misses">
  {misses.map((m) => (
    <li><span class="miss">{m.model}</span> <span class="muted">{m.note}</span></li>
  ))}
</ul>
<style>
  th[scope='row'] { white-space: nowrap; }
  .block { display: block; }
  .sub { color: var(--muted); margin: 18px 0 8px; }
  .misses li { padding: 4px 0; border-bottom: 1px dotted var(--line-soft); }
  .miss { color: #fff; }
</style>
