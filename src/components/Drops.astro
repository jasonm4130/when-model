---
import type { Dashboard } from '../domain/dashboard';
import { SOURCE } from '../domain/sources';
import { ago, ctx, num, shortDate } from '../ui/format';
import { MOBILE_DROPS, PANEL_ROWS, dropPrice, sourceOk, sourcePill, stealthIds } from '../ui/panels';
import DropItem from './DropItem.astro';
interface Props { d: Dashboard }
const { d } = Astro.props;
const now = Date.now();
const FRESH_MS = 3 * 86_400_000;
const stealth = stealthIds(d);
const rows = d.drops.slice(0, PANEL_ROWS.drops).map((x) => {
  const lab = d.labs.find((l) => l.id === x.labId);
  const fresh = now - Date.parse(x.createdAt) < FRESH_MS;
  return {
    x,
    lab: lab ? lab.short : x.lab,
    fresh,
    when: fresh ? ago(x.createdAt, now) : shortDate(x.createdAt),
    price: dropPrice(x),
    vision: !!x.modality?.includes('image'),
    stealth: stealth.has(x.id),
  };
});
const papers = d.papers.slice(0, PANEL_ROWS.papers);
const pills = {
  drops: sourcePill(d.sources, [SOURCE.openrouter], d.generatedAt, now),
  trending: sourcePill(d.sources, [SOURCE.hfTrending], d.generatedAt, now),
  papers: sourcePill(d.sources, [SOURCE.hfPapers], d.generatedAt, now),
};
const papersUp = sourceOk(d.sources, SOURCE.hfPapers);
const item = (r: (typeof rows)[number]) => ({
  name: r.x.name,
  url: r.x.url,
  lab: r.lab,
  ctx: ctx(r.x.context),
  price: r.price,
  free: r.x.free,
  vision: r.vision,
  stealth: r.stealth,
  fresh: r.fresh,
  when: r.when,
  createdAt: r.x.createdAt,
});
/** Trending repos shown before the fold. */
const TRENDING_SHOWN = 6;
---
<section class="drops" id="drops" aria-label="New listings and open weights">
  <div class="grid dr-grid">
    <div class="panel">
      <div class="panel-head">
        <h2>Fresh drops</h2>
        <span class={`pill ${pills.drops.tone}`} title={pills.drops.title} data-source-pill data-stale-at={pills.drops.staleAt} data-stale-text={pills.drops.staleText}>{pills.drops.text}</span>
      </div>
      {rows.length ? (
        <div class="drop-stack">
          <div class="drop-cols tiny" aria-hidden="true"><span>Landed</span><span>Model</span><span>Lab</span><span class="num">Ctx</span><span class="num">$/M in / out</span></div>
          <ol class="drop-list">
            {rows.slice(0, MOBILE_DROPS).map((r) => <DropItem {...item(r)} />)}
          </ol>
          {rows.length > MOBILE_DROPS && (
            <details class="fold">
              <summary class="fold-summary">{rows.length - MOBILE_DROPS} MORE LISTINGS</summary>
              <ol class="drop-list" start={MOBILE_DROPS + 1}>
                {rows.slice(MOBILE_DROPS).map((r) => <DropItem {...item(r)} />)}
              </ol>
            </details>
          )}
        </div>
      ) : <p class="empty">{sourceOk(d.sources, SOURCE.openrouter) ? 'No new listings on OpenRouter.' : 'OpenRouter unreachable. Listings return when it does.'}</p>}
    </div>

    <div class="panel">
      <div class="panel-head">
        <h2>Open weights trending</h2>
        <span class={`pill ${pills.trending.tone}`} title={pills.trending.title} data-source-pill data-stale-at={pills.trending.staleAt} data-stale-text={pills.trending.staleText}>{pills.trending.text}</span>
      </div>
      {d.trending.length ? (
        <>
          <ol class="trend-list">
            {d.trending.slice(0, TRENDING_SHOWN).map((t, i) => (
              <li class="trend">
                <span class="t-rank">{i + 1}</span>
                <a class="repo" href={t.url} target="_blank" rel="noopener">{t.id}</a>
                <span class="t-meta"><span class="t-likes">{num(t.likes)}<span class="sr-only"> likes</span><span aria-hidden="true"> ♥</span></span> <span class="muted">{num(t.downloads)} DLs · {ago(t.createdAt, now).replace(' ago', '')}</span></span>
              </li>
            ))}
          </ol>
          {d.trending.length > TRENDING_SHOWN && (
            <details class="fold">
              <summary class="fold-summary">{d.trending.length - TRENDING_SHOWN} MORE REPOS</summary>
              <ol class="trend-list" start={TRENDING_SHOWN + 1}>
                {d.trending.slice(TRENDING_SHOWN).map((t, i) => (
                  <li class="trend">
                    <span class="t-rank">{i + TRENDING_SHOWN + 1}</span>
                    <a class="repo" href={t.url} target="_blank" rel="noopener">{t.id}</a>
                    <span class="t-meta"><span class="t-likes">{num(t.likes)}<span class="sr-only"> likes</span><span aria-hidden="true"> ♥</span></span> <span class="muted">{num(t.downloads)} DLs · {ago(t.createdAt, now).replace(' ago', '')}</span></span>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </>
      ) : <p class="empty">{sourceOk(d.sources, SOURCE.hfTrending) ? 'Nothing trending right now.' : 'Hugging Face unreachable.'}</p>}
      {(papers.length > 0 || !papersUp) && (
        <>
          <div class="panel-head sub-head">
            <h2>Papers of the day</h2>
            <span class={`pill ${pills.papers.tone}`} title={pills.papers.title} data-source-pill data-stale-at={pills.papers.staleAt} data-stale-text={pills.papers.staleText}>{pills.papers.text}</span>
          </div>
          {papers.length ? (
            <ul class="list papers">
              {papers.map((p) => <li><span class="up">▲{p.upvotes}</span> <a href={p.url} target="_blank" rel="noopener">{p.title}</a></li>)}
            </ul>
          ) : <p class="empty">Hugging Face papers unreachable.</p>}
        </>
      )}
    </div>
  </div>
</section>
<style>
  .drops { scroll-margin-top: 16px; }
  .dr-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  @media (max-width: 960px) {
    .dr-grid { grid-template-columns: minmax(0, 1fr); }
  }
  .drop-list { list-style: none; margin: 0; padding: 0; }
  .drop-cols { display: none; }
  /* Wide enough for columns: the stacked rows line up as a table, with a header to match. */
  @media (min-width: 700px) {
    .drop-cols { display: grid; grid-template-columns: 76px minmax(0, 1fr) 96px 64px 104px; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--ink); color: var(--ink-2); font-size: var(--fs-pill); }
  }
  .trend-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .trend { display: grid; grid-template-columns: 28px minmax(0, 1fr); column-gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--rule-soft); }
  .t-rank { grid-row: span 2; font-family: var(--font-display); font-weight: 800; font-stretch: 62.5%; font-size: 22px; line-height: 1; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .repo { overflow-wrap: anywhere; font-size: var(--fs-md); text-decoration: none; }
  .repo:hover { text-decoration: underline; }
  .t-meta { font-size: var(--fs-xs); color: var(--ink-2); }
  .t-likes { color: var(--ink); }
  .papers { font-size: var(--fs-sm); line-height: 1.4; border-top: 1px solid var(--ink); }
  .papers li { padding: 10px 0; }
  .papers a { text-decoration: none; }
  .papers a:hover { text-decoration: underline; }
  .up { font-family: var(--font-label); font-size: var(--fs-pill); font-weight: 700; margin-right: 6px; color: var(--ink-2); }
</style>
