---
/**
 * Service history: the DROPCON level's last 7 days. The 5-level scale is the plot's vertical axis,
 * the lead score's week runs across it, and the line ends at the NOW edge. The level itself is posted
 * above, in the service status (`ServiceStatus.astro`). Server-rendered SVG and HTML; the script below
 * turns the plot into a slider whose readout names each hour, and never touches the posted level.
 */
import type { HistoryResponseBody } from '../app/load-dashboard';
import type { Dashboard } from '../domain/dashboard';
import { LEVEL_BANDS, type DropconLevel } from '../domain/dropcon';
import { INSTRUMENT_WIDTH, LAUNCH_NEAR_MS, buildInstrument, type ScrubPoint } from '../domain/instrument';
import { stripDay, stripHour } from '../domain/history';
import { LEVEL_NAMES } from '../domain/levels';
import { SOURCE } from '../domain/sources';
import { estimateFlagWidth, flagCandidates, placeLabels, type Box } from '../ui/labels';
import { dropconNumber } from '../ui/odds';
import { lineBullet } from '../ui/lines';
import { nowReadout, type ScrubData, type ScrubKind } from '../ui/readout';
interface Props {
  d: Dashboard;
  history?: HistoryResponseBody;
  now?: number;
}
const { d, history, now = Date.now() } = Astro.props;
const c = d.dropcon;
const launchesOk = d.sources.find((s) => s.name === SOURCE.openrouter)?.ok ?? false;
const inst = buildInstrument({
  points: history?.points ?? [],
  ok: history?.ok ?? false,
  now,
  currentVersion: d.measurement.algorithmVersion,
  live: { state: c.state, score: c.score, level: c.level, at: d.generatedAt },
  launches: d.landed.releases.map((r) => ({ at: r.firstListedAt, labId: r.labId, lab: r.lab, name: r.name })),
  launchesOk,
});
const ok = c.state === 'ok';
// Band edges top to bottom: 100–75 is level 1, …, 15–0 is level 5.
const edges = [100, ...LEVEL_BANDS, 0];
const bands = edges.slice(0, -1).map((top, i) => ({ level: (i + 1) as DropconLevel, top, bottom: edges[i + 1] }));
const pct = (x: number) => `${(x / INSTRUMENT_WIDTH) * 100}%`;
const segClass = (n: number) => {
  if (c.state === 'no-signal') return 'seg dim';
  if (c.state === 'floor') return `seg dim${n === c.level ? ' floor' : ''}`;
  return `seg${n === c.level ? ' on' : ''}`;
};
const scaleLabel =
  c.state === 'no-signal'
    ? 'DROPCON: no signal'
    : c.state === 'floor'
      ? `DROPCON floor: ${c.level} of 5 with the odds offline`
      : `DROPCON ${c.level} of 5`;
const bandRange = (b: { top: number; bottom: number }) =>
  b.top === 100 ? `${b.bottom}+` : b.bottom === 0 ? `below ${b.top}` : `${b.bottom}–${b.top - 1}`;

// What each hatched or empty stretch says, at three widths: the plot picks the one that fits whole.
const zoneText = (z: (typeof inst.zones)[number]) =>
  z.kind === 'old'
    ? { head: `v${z.version} · OLD SCALE`, sub: 'another formula, not comparable', min: `v${z.version}` }
    : z.kind === 'outage'
      ? { head: 'ODDS OFFLINE', sub: 'level held, not measured', min: '✕' }
      : { head: 'NO RECORD', sub: z.start ? `captures start ${stripDay(z.to)}` : 'no captures', min: '' };

// The scrubber's data and the readout it starts from (the same functions the browser runs).
const K: Record<ScrubPoint['kind'], ScrubKind> = { current: 'c', old: 'o', outage: 'x' };
const data: ScrubData = {
  from: inst.from,
  to: inst.to,
  version: inst.currentVersion,
  history: inst.state,
  launchesOk: inst.launchesOk,
  ...(inst.recordedFrom ? { recordFrom: Date.parse(inst.recordedFrom) } : {}),
  ...(inst.lastReading ? { last: Date.parse(inst.lastReading) } : {}),
  near: LAUNCH_NEAR_MS,
  pts: inst.scrub.map((p) => [K[p.kind], p.h, p.e, p.score, p.level ?? 0, p.held ? 1 : 0, p.version]),
  // A launch carries its line's bullet: the letter in the readout, the fill on the flag.
  launches: inst.launches.map((l) => {
    const b = lineBullet(l.labId ?? '');
    return [Date.parse(l.at), l.name, l.lab, b.letter, b.fill];
  }),
  live: { state: c.state, at: Date.parse(d.generatedAt), score: c.score, level: c.level },
};
const rest = nowReadout(data);

// The current version's start: a quiet tag once its line explains itself, a callout while it is young.
const cur = inst.current;
const v3 = cur && cur.x > INSTRUMENT_WIDTH * 0.03 ? cur : undefined;
const readings = cur ? `${cur.count} hourly reading${cur.count === 1 ? '' : 's'}` : '';
const youngBelow = (cur?.y ?? inst.now.y) < 58;
// The series is hourly, and the hour a version changed in holds both: its start is an hour, not a minute.
const hhmm = inst.currentSince ? stripHour(inst.currentSince).slice(-6) : '';

// First paint places launch names on a reference 1000 x 236 px plot with estimated widths; the
// script measures the real plot and places them again (src/ui/labels.ts either way).
const REF: Box = { left: 0, top: 0, right: INSTRUMENT_WIDTH, bottom: 236 };
const flagText = (l: (typeof inst.launches)[number]) => `${lineBullet(l.labId ?? '').letter} ${l.name}`;
const dirTop: Box = { left: 0, top: 0, right: 180, bottom: 24 };
const changeBoxes: Box[] = inst.changes.map((ch) => {
  const w = ch.text.length * 8 + 12;
  const y = (ch.y / 100) * REF.bottom;
  const left = ch.side === 'left' ? ch.x - w : ch.x;
  return ch.hang === 'above'
    ? { left, right: left + w, top: y - 28, bottom: y - 8 }
    : { left, right: left + w, top: y + 8, bottom: y + 28 };
});
const rows = placeLabels(
  inst.launches.map((l) => flagCandidates(l.x, estimateFlagWidth(flagText(l)), l.flip)),
  REF,
  [dirTop, ...changeBoxes],
);

const tableRows = inst.scrub.slice().reverse();
---
<div
  class:list={['scope', c.state, `hist-${inst.state}`, { young: cur?.young, low: inst.now.y > 55, high: inst.now.y < 20 }]}
  data-scope={JSON.stringify(data)}
  style={`--y:${inst.now.y}`}
>
  <div class="sc-readout" data-readout data-tone={rest.tone} style={rest.tone === 'ok' && rest.level ? `--rl:var(--l${rest.level})` : undefined}>
    <p class="sc-r1">
      <span class="sc-rw">
        <b class="sc-when" data-r-when>{rest.when}</b>
        <span class="sc-what"><span data-r-what></span><span class="sc-rname" data-r-name></span></span>
      </span>
      <span class="sc-hint tiny" data-hint hidden aria-hidden="true"><span class="h-long">◀ ▶ HOVER, DRAG OR ARROW KEYS</span><span class="h-short">◀ TAP<span class="h-drag"> OR DRAG</span> ▶</span></span>
    </p>
    <p class="sc-r2" data-r-near></p>
  </div>

  <span class="sc-cap sc-cap-level tiny" aria-hidden="true">LEVEL</span>
  <span class="sc-cap sc-cap-plot tiny" aria-hidden="true">LEAD SCORE <span class="muted">0–100 · HOURLY · LAST 7 DAYS</span></span>
  <span class="sc-cap sc-cap-now tiny" aria-hidden="true">NOW</span>

  <div class="dc-scale" role="img" aria-label={scaleLabel}>
    {bands.map((b, i) => (
      <div class={`${segClass(b.level)} l${b.level}`} data-seg={b.level} style={`--c:${ok ? `var(--l${b.level})` : 'var(--muted)'}; --i:${i}`} title={`DROPCON ${b.level} · ${LEVEL_NAMES[b.level]} · score ${bandRange(b)}`}>
        <span>{b.level}</span>
      </div>
    ))}
  </div>
  <div class="sc-ticks" aria-hidden="true">
    {edges.map((v) => <span class:list={[{ end: v === 100 || v === 0 }]} style={`top:${100 - v}%`}>{v}</span>)}
  </div>

  <div class="sc-stage">
    <div class="sc-plot" data-plot role="img" aria-label={inst.summary}>
      <svg class="sc-bg" viewBox={`0 0 ${INSTRUMENT_WIDTH} 100`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {bands.map((b) => (
          <rect class:list={['sc-band', `l${b.level}`, { on: ok && b.level === c.level }]} x="0" y={100 - b.top} width={INSTRUMENT_WIDTH} height={b.top - b.bottom} />
        ))}
        {LEVEL_BANDS.map((edge) => <line class="sc-guide" x1="0" x2={INSTRUMENT_WIDTH} y1={100 - edge} y2={100 - edge} />)}
        {inst.ticks.map((t) => <line class="sc-day" x1={t.x} x2={t.x} y1="0" y2="100" />)}
      </svg>
      {inst.zones.map((z) => {
        const t = zoneText(z);
        return (
          <div class={`sc-zone ${z.kind}`} style={`left:${pct(z.x)}; width:${pct(z.w)}`} aria-hidden="true">
            <span class="sc-zlabel" data-label="zone">
              <span class="zl-full"><b>{t.head}</b><span>{t.sub}</span></span>
              <b class="zl-head">{t.head}</b>
              {t.min && <b class="zl-min">{t.min}</b>}
            </span>
          </div>
        );
      })}
      <span class="sc-dir top l1 tiny" data-label="fixed" aria-hidden="true">▲ 1 · RELEASE SURGE</span>
      <span class="sc-dir bottom l5 tiny" data-label="fixed" aria-hidden="true">▼ 5 · QUIET ORBIT</span>
      {/* Labels sit under the ink, so a high or low trace is never hidden behind one. */}
      {inst.launches.map((l, i) => (
        <span
          class:list={['sc-flag', { flip: l.flip, unplaced: rows[i] === undefined }]}
          style={`left:${pct(l.x)}; --row:${rows[i] ?? 0}`}
          data-launch={i}
          data-label="flag"
          aria-hidden="true"
        ><i style={`--c:${lineBullet(l.labId ?? '').fill};--fg:${lineBullet(l.labId ?? '').ink}`}>{lineBullet(l.labId ?? '').letter}</i> {l.name}</span>
      ))}
      {v3 && <span class="sc-vline" style={`left:${pct(v3.x)}`} aria-hidden="true"></span>}
      {v3 && (v3.young ? (
        <span class:list={['sc-v3 young', youngBelow ? 'below' : 'above']} style={`left:${pct(v3.x)}; --vy:${v3.y}`} data-label="fixed" aria-hidden="true">
          <b><span class="yl-long">v{inst.currentVersion} SCALE FROM THE {stripHour(inst.currentSince!).toUpperCase()} HOUR</span><span class="yl-short">v{inst.currentVersion} FROM {hhmm} HOUR</span></b>
          <span>{readings} so far{inst.now.joined && <span class="yl-long"> · updates every 15 min</span>}</span>
        </span>
      ) : (
        <span class="sc-v3" style={`left:${pct(v3.x)}`} data-label="fixed" aria-hidden="true"><b>v{inst.currentVersion} SCALE</b></span>
      ))}
      <div class="sc-ink" aria-hidden="true">
        <svg viewBox={`0 0 ${INSTRUMENT_WIDTH} 100`} preserveAspectRatio="none" focusable="false">
          <defs>
            <linearGradient id="sc-level-ink" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="100">
              {bands.flatMap((b) => [
                <stop class={`l${b.level}`} offset={`${100 - b.top}%`} />,
                <stop class={`l${b.level}`} offset={`${100 - b.bottom}%`} />,
              ])}
            </linearGradient>
          </defs>
          {inst.launches.map((l, i) => (
            <line class="sc-launch" data-launch={i} x1={l.x} x2={l.x} y1="0" y2="100" />
          ))}
          {inst.traces.map((t) => <path class="sc-area" d={t.area} />)}
          {inst.traces.map((t) => <path class="sc-glow" d={t.line} />)}
          {inst.traces.map((t) => <path class="sc-line" d={t.line} />)}
        </svg>
      </div>
      {/* Level changes sit over the ink, beside the step where the line was not. */}
      {inst.changes.map((ch) => {
        const words = ch.text.split(' ');
        return (
          <span
            class:list={['sc-change', `l${ch.level}`, ch.side]}
            style={`left:${pct(ch.x)}; top:${ch.y}%`}
            data-side={ch.hang}
            data-side0={ch.hang}
            data-label="fixed"
            aria-hidden="true"
          ><span class="cf-dir">{words.slice(0, 2).join(' ')}</span><span class="cf-when"> {words.slice(2).join(' ')}</span></span>
        );
      })}
      <span class="sc-nowline" aria-hidden="true"></span>
      <span class="sc-sweep" aria-hidden="true"></span>
      <div class="sc-cursor" data-cursor hidden aria-hidden="true">
        <span class="sc-probe" data-probe hidden></span>
      </div>
      {inst.state !== 'ok' && (
        <div class="sc-empty" aria-hidden="true">
          <div class="sc-veil" data-veil>
            <b class="head">{inst.state === 'unavailable' ? 'HISTORY OFFLINE' : inst.lastReading ? 'NO RECENT READINGS' : 'NO READINGS YET'}</b>
            <span>{inst.state === 'unavailable'
              ? 'The score series could not be read.'
              : inst.lastReading
                ? `Nothing captured in these 7 days; the last reading was ${stripHour(inst.lastReading)}.`
                : `v${inst.currentVersion} history starts ${stripDay(now)}: the 15-minute capture writes the first point.`}{inst.state === 'empty' && !inst.lastReading ? '' : <span class="v-live"> The level shown is live.</span>}</span>
          </div>
        </div>
      )}
    </div>
    {c.state !== 'no-signal' && <span class:list={['sc-dot', { joined: inst.now.joined }]} aria-hidden="true"></span>}
    {c.state !== 'no-signal' && (
      <span class="sc-nowtag tiny" aria-hidden="true">NOW <b>{dropconNumber(c)}</b></span>
    )}
  </div>

  <div class="sc-rail" aria-hidden="true">
    {inst.launches.map((l, i) => (
      <span class="sc-mark" data-launch={i} style={`left:${pct(l.x)}`} title={`${l.name} · ${l.lab} · ${stripHour(l.at)}`}>{lineBullet(l.labId ?? '').letter}</span>
    ))}
    {!inst.launchesOk && <span class="sc-rail-note tiny">LAUNCH LISTINGS OFFLINE</span>}
  </div>
  <div class="sc-days" aria-hidden="true">
    {inst.ticks.map((t) => {
      const [day, mon] = t.label.split(' ');
      return <span class:list={['sc-daylabel', { late: t.x > 930 }]} style={`left:${pct(t.x)}`}>{day}<span class="mon"> {mon}</span></span>;
    })}
    <span class="sc-ctag" data-ctag hidden></span>
  </div>

<p class="dc-what">
  <span class="w-long">The line is DROPCON's lead score, 0 to 100, read hourly from Polymarket's release odds; its band sets the level, 5 (quiet) to 1 (release surge).</span><span class="w-short">The line is the 0–100 lead score; its band sets the level, 5 quiet to 1 surge.</span> A lead score, not a forecast. <a href="/about#score">How it adds up</a> · <a href="/backtest">The backtest</a>
</p>
<p class="dc-key">
  <span class="k-item"><i class="k-line" aria-hidden="true"></i>lead score</span>
  <span class="k-item"><i class="k-launch" aria-hidden="true">A</i>a line's launch, first listed on OpenRouter: context, not scored</span>
  <span class="k-item"><i class="k-hatch" aria-hidden="true"></i>older scoring, not comparable</span>
</p>

<details class="sc-table">
  <summary class="fold-summary">The week as a table</summary>
  <div class="table-scroll" role="region" tabindex="0" aria-label="DROPCON readings and launches, last 7 days">
    <table>
      <caption class="sr-only">DROPCON hourly readings, newest first, and frontier launches in the same 7 days</caption>
      <thead><tr><th scope="col">HOUR (UTC)</th><th scope="col">SCORE</th><th scope="col">LEVEL</th></tr></thead>
      <tbody>
        {ok && <tr><td>NOW · {stripHour(d.generatedAt)}</td><td>{c.score}</td><td>{c.level}</td></tr>}
        {tableRows.map((p) => (
          <tr class:list={[{ old: p.kind === 'old' }]}>
            <td>{stripHour(new Date(p.h).toISOString())}</td>
            <td>{p.kind === 'outage' ? 'odds offline' : p.kind === 'old' ? `${p.score} (v${p.version}, old scale)` : p.score}</td>
            <td>{p.kind === 'old' ? '—' : `${p.level}${p.held ? ' (held)' : ''}`}</td>
          </tr>
        ))}
        {!tableRows.length && (
          <tr><td colspan="3">{inst.state === 'unavailable' ? 'The score series could not be read.' : 'No readings recorded in these 7 days.'}</td></tr>
        )}
      </tbody>
    </table>
    {inst.launches.length > 0 && (
      <table>
        <caption class="sr-only">Frontier launches listed on OpenRouter in the same 7 days</caption>
        <thead><tr><th scope="col">LISTED (UTC)</th><th scope="col">LAUNCH</th><th scope="col">LAB</th></tr></thead>
        <tbody>
          {[...inst.launches].reverse().map((l) => <tr><td>{stripHour(l.at)}</td><td>{l.name}</td><td>{l.lab}</td></tr>)}
        </tbody>
      </table>
    )}
  </div>
</details>
</div>

<style>
  /* The level ramp on paper, in ink and greys so no level reads as a line's colour: a surge and a
     strong lead in ink (a surge's marks are filled), a lead the notice yellow's dark twin (the yellow
     itself is too light for a line on paper), and the quiet levels grey. Each clears 3:1 on paper. */
  .scope {
    --l1: var(--ink);
    --l2: var(--ink);
    --l3: #7a6200;
    --l4: var(--ink-2);
    --l5: #8a867c;
    --plot-h: 220px;
    --sweep: 1200ms;
    position: relative;
    display: grid;
    grid-template-columns: 32px 28px minmax(0, 1fr);
    grid-template-rows: auto auto var(--plot-h) 28px auto auto auto auto;
    grid-template-areas:
      'read read read'
      'lcap lcap pcap'
      'rail ticks stage'
      '. . marks'
      '. . days'
      'what what what'
      'key key key'
      'table table table';
    column-gap: var(--s2);
    margin-top: var(--s5);
  }
  .l1 { --lc: var(--l1); }
  .l2 { --lc: var(--l2); }
  .l3 { --lc: var(--l3); }
  .l4 { --lc: var(--l4); }
  .l5 { --lc: var(--l5); }

  /* The readout: what the cursor is on, in two lines behind a rule the level's colour. */
  .sc-readout { --rl: var(--ink); grid-area: read; display: grid; grid-template-rows: 24px 20px; align-content: center; gap: 2px; min-width: 0; height: 60px; margin-bottom: var(--s4); padding-left: var(--s3); border-left: 4px solid var(--rl); }
  .sc-readout[data-tone='old'], .sc-readout[data-tone='none'] { --rl: var(--line2); }
  .sc-readout[data-tone='outage'] { --rl: var(--notice); }
  .sc-readout.is-scrub { --rl: var(--ink); }
  /* The reading comes first: when it and the hint do not both fit, the hint wraps onto a second
     line the row clips, so it shows whole or not at all and never squeezes the reading. */
  .sc-r1 { display: flex; flex-wrap: wrap; align-content: flex-start; align-items: baseline; column-gap: var(--s4); min-width: 0; height: 24px; white-space: nowrap; overflow: hidden; }
  .sc-rw { display: flex; flex: 0 1 auto; align-items: baseline; gap: var(--s3); min-width: 0; }
  .sc-when { flex: none; font-family: var(--mono); font-size: var(--t-xs); font-weight: 500; color: var(--ink); }
  .sc-what { min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: var(--t-base); line-height: 24px; font-weight: 600; color: var(--ink); }
  .sc-readout[data-tone='old'] .sc-what, .sc-readout[data-tone='none'] .sc-what { color: var(--ink-2); }
  .sc-rname { font-weight: 400; color: var(--ink-2); }
  .sc-hint { margin-left: auto; flex: none; color: var(--ink-2); }
  .sc-hint[hidden] { display: none; }
  .sc-hint .h-short { display: none; }
  .sc-r2 { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }

  .sc-cap { padding-bottom: var(--s2); color: var(--ink-2); white-space: nowrap; overflow: hidden; }
  .sc-cap-level { grid-area: lcap; }
  .sc-cap-plot { grid-area: pcap; color: var(--ink); }
  .sc-cap-plot .muted { font-weight: 500; }
  .sc-cap-now { display: none; }

  /* The DROPCON scale, standing up: each level's segment as tall as its score band. */
  .dc-scale { grid-area: rail; display: grid; grid-template-rows: 25fr 20fr 20fr 20fr 15fr; gap: 2px; }
  .seg { display: grid; place-items: center; font-size: var(--t-xs); font-weight: 700; color: var(--ink-2); background: var(--paper-2); outline: 2px solid transparent; outline-offset: 1px; transition: outline-color var(--fast) var(--ease); }
  .seg.on { background: var(--ink); color: var(--paper); }
  .seg.on.l3 { background: var(--notice); color: var(--ink); }
  .seg.on.l1 { background: var(--ink); color: var(--notice); }
  .seg.dim { background: transparent; border: 1px dashed var(--line2); }
  .seg.floor { border: 2px solid var(--ink-2); }
  .seg.is-probe { outline-color: var(--ink); }

  .sc-ticks { grid-area: ticks; position: relative; font-family: var(--mono); font-size: 11px; color: var(--ink-2); }
  .sc-ticks span { position: absolute; right: 0; transform: translateY(-50%); line-height: 1; }

  .sc-stage { grid-area: stage; position: relative; min-width: 0; }
  .sc-plot { position: absolute; inset: 0; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); overflow: hidden; touch-action: pan-y; }
  .sc-plot[role='slider'] { cursor: crosshair; }
  .sc-plot:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .sc-plot svg, .sc-ink { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* Level bands: the busy levels tinted faintly, the current band a little more. */
  .sc-band { fill: transparent; }
  .sc-band.l1 { fill: var(--ink); opacity: 0.06; }
  .sc-band.l2 { fill: var(--ink); opacity: 0.04; }
  .sc-band.l3 { fill: var(--notice); opacity: 0.16; }
  .sc-band.on { opacity: 0.3; }
  .sc-band.on.l4, .sc-band.on.l5 { fill: var(--ink); opacity: 0.05; }
  .sc-band.on.l2 { opacity: 0.08; }
  .sc-band.on.l1 { opacity: 0.12; }
  .sc-guide { stroke: var(--line2); stroke-width: 1; stroke-dasharray: 1 4; vector-effect: non-scaling-stroke; }
  .sc-day { stroke: var(--rule-soft); stroke-width: 1; vector-effect: non-scaling-stroke; }
  #sc-level-ink stop { stop-color: var(--lc); }
  .sc-area { fill: url(#sc-level-ink); opacity: 0.06; shape-rendering: crispEdges; }
  .sc-glow { display: none; }
  .sc-line { fill: none; stroke: url(#sc-level-ink); stroke-width: 3; stroke-linejoin: miter; vector-effect: non-scaling-stroke; }
  .sc-launch { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0.6; vector-effect: non-scaling-stroke; transition: opacity var(--fast) var(--ease); }
  .sc-launch.is-near { opacity: 1; stroke: var(--ink); stroke-dasharray: none; }

  /* Stretches with no line on this axis: hatched or blank. The label shows whole, or not at all. */
  .sc-zone { position: absolute; top: 0; bottom: 0; overflow: hidden; border-right: 1px dashed var(--line2); container: zone / inline-size; }
  .sc-zone.unrecorded { background: var(--paper-2); }
  .sc-zone.old { background: repeating-linear-gradient(135deg, rgba(17, 17, 17, 0.1) 0 1px, transparent 1px 7px), var(--paper); }
  .sc-zone.outage { background: repeating-linear-gradient(45deg, rgba(252, 204, 10, 0.45) 0 2px, transparent 2px 8px), var(--paper); }
  .sc-zlabel { position: absolute; left: 8px; bottom: 28px; max-width: calc(100% - 16px); }
  .sc-zlabel > * { display: none; white-space: nowrap; }
  .sc-zlabel b { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--ink-2); }
  .zl-full { gap: 2px; }
  .zl-full span { font-size: var(--t-xs); color: var(--ink-2); }
  @container zone (min-width: 250px) {
    .sc-zlabel > .zl-full { display: grid; }
  }
  @container zone (min-width: 140px) and (max-width: 249.98px) {
    .sc-zlabel > .zl-head { display: block; }
  }
  @container zone (min-width: 40px) and (max-width: 139.98px) {
    .sc-zlabel > .zl-min { display: block; }
  }
  /* The script may pick a shorter variant than the zone's width allows, when the longer one meets a label. */
  .sc-zlabel[data-pick] > * { display: none; }
  .sc-zlabel[data-pick='full'] > .zl-full { display: grid; }
  .sc-zlabel[data-pick='head'] > .zl-head, .sc-zlabel[data-pick='min'] > .zl-min { display: block; }

  /* Which way is busy, at the plot's top and bottom edges. */
  .sc-dir { position: absolute; left: 8px; padding: 2px 4px; font-size: 11px; color: var(--ink-2); background: var(--paper); white-space: nowrap; }
  .sc-dir.l1 { color: var(--ink); }
  .sc-dir.top { top: 6px; }
  .sc-dir.bottom { bottom: 6px; }

  /* Launch names, stacked in rows at the top of the plot, each with its line's bullet. */
  .sc-flag { position: absolute; top: calc(6px + var(--row) * 22px); height: 18px; margin-left: 4px; padding: 0 6px 0 2px; font-size: 13px; line-height: 18px; font-weight: 500; color: var(--ink); white-space: nowrap; background: var(--paper); border-left: 2px solid var(--ink); transition: color var(--fast) var(--ease), background var(--fast) var(--ease); }
  .sc-flag i { display: inline-grid; place-items: center; width: 14px; height: 14px; margin-right: 2px; border-radius: 50%; vertical-align: -2px; font-size: 9px; line-height: 1; font-weight: 700; font-style: normal; color: var(--fg); background: var(--c); }
  .sc-flag.flip { margin-left: 0; padding: 0 2px 0 6px; transform: translateX(calc(-100% - 4px)); border-left: 0; border-right: 2px solid var(--ink); }
  .sc-flag.is-near { color: var(--paper); background: var(--ink); }
  .scope:not(.fitted) .sc-flag.unplaced { display: none; }
  .is-cut { visibility: hidden; }

  /* Where the current scale starts, and while its line is young, how much of it there is. */
  .sc-vline { position: absolute; top: 0; bottom: 0; border-left: 1px dashed var(--ink-2); }
  .sc-v3 { position: absolute; bottom: 6px; display: grid; gap: 2px; padding: 2px 6px; border-left: 2px solid var(--ink); white-space: nowrap; background: var(--paper); }
  .sc-v3 b { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--ink); }
  .sc-v3 > span { font-size: 12px; line-height: 16px; color: var(--ink-2); }
  .sc-v3.young { --off: 36px; bottom: auto; top: calc(var(--vy) * 1%); transform: translate(calc(-100% - 10px), calc(-100% - var(--off))); border-left: 0; border-right: 2px solid var(--ink); text-align: right; }
  .sc-v3.young.below { transform: translate(calc(-100% - 10px), var(--off)); }
  .sc-v3 .yl-short { display: none; }

  /* Level changes on the line: where it crossed a band and stayed. A tick joins the label to the step. */
  .sc-change { position: absolute; z-index: 2; --tx: -100%; --ty: calc(-100% - 8px); transform: translate(var(--tx), var(--ty)); padding: 2px 6px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--ink); white-space: nowrap; background: var(--paper); border: 2px solid var(--lc); }
  .sc-change.l3 { background: var(--notice); border-color: var(--ink); }
  .sc-change.l1 { color: var(--notice); background: var(--ink); border-color: var(--ink); }
  .sc-change.right { --tx: 0px; }
  .sc-change[data-side='below'] { --ty: 8px; }
  .sc-change::after { content: ''; position: absolute; right: -2px; top: 100%; height: 8px; border-right: 2px solid var(--lc); }
  .sc-change.right::after { right: auto; left: -2px; border-right: 0; border-left: 2px solid var(--lc); }
  .sc-change[data-side='below']::after { top: auto; bottom: 100%; }
  .sc-change[data-side='above']:not([data-side0='above'])::after, .sc-change[data-side='below']:not([data-side0='below'])::after { display: none; }

  /* NOW: the right edge, a square at the live score, and a tag naming it. None of it takes the
     pointer, so hovering the edge reads the plot underneath. */
  .sc-nowline { position: absolute; top: 0; bottom: 0; right: 0; width: 0; border-right: 2px solid var(--ink); }
  .sc-dot { position: absolute; z-index: 4; right: -6px; top: calc(var(--y) * 1%); width: 12px; height: 12px; margin-top: -6px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 2px var(--paper); pointer-events: none; }
  .scope:not(.ok) .sc-dot { background: var(--paper); border: 2px dashed var(--ink-2); }
  .sc-nowtag { display: block; position: absolute; z-index: 4; right: 12px; top: calc(var(--y) * 1%); transform: translateY(calc(-100% - 6px)); padding: 2px 6px; color: var(--paper); background: var(--ink); pointer-events: none; }
  .sc-nowtag b { font-weight: 700; }
  .scope:not(.ok) .sc-nowtag { color: var(--ink-2); background: var(--paper); border: 1px dashed var(--ink-2); }
  .scope.high .sc-nowtag { transform: translateY(8px); }

  .sc-rail { grid-area: marks; position: relative; }
  .sc-mark { position: absolute; top: 6px; transform: translateX(-50%); font-size: 11px; line-height: 1; font-weight: 700; color: var(--ink); transition: transform var(--fast) var(--ease); }
  .sc-mark::before { content: ''; position: absolute; left: 50%; top: -6px; height: 5px; border-left: 1px solid currentColor; }
  .sc-mark.is-near { transform: translateX(-50%) scale(1.3); }
  .sc-rail-note { position: absolute; left: 6px; top: 6px; color: var(--ink-2); }
  .sc-days { grid-area: days; container: days / inline-size; position: relative; height: 16px; margin-top: 4px; font-family: var(--mono); font-size: 11px; color: var(--ink-2); }
  /* A day is about a seventh of the axis: under about 80px a day, "25 SEP" meets "26 SEP" (the script
     drops any label that still meets its neighbour). */
  @container days (max-width: 559.98px) {
    .sc-days .mon { display: none; }
  }
  .sc-days > span { position: absolute; top: 0; white-space: nowrap; }
  .sc-daylabel { transform: translateX(-50%); }
  .sc-daylabel.late { transform: translateX(-100%); }
  .sc-days > .sc-ctag { z-index: 2; top: -3px; padding: 2px 6px; color: var(--paper); background: var(--ink); }
  .sc-ctag[hidden] { display: none; }

  /* Scrubber: a hairline and a probe on the reading; the words go in the readout. */
  .sc-cursor { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .sc-cursor[hidden] { display: none; }
  .sc-cursor::before { content: ''; position: absolute; top: 0; bottom: 0; left: var(--cx); border-left: 1px solid var(--ink); }
  .sc-probe { position: absolute; left: var(--cx); top: calc(var(--cy) * 1%); width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--probe, var(--ink)); outline: 2px solid var(--paper); }
  .sc-probe[hidden] { display: none; }

  /* No series: the plot pales under a card. Launch names and the direction labels do not depend on
     the series, so they stay above it at full contrast (the script keeps them off the card). */
  .sc-empty { position: absolute; inset: 0; display: grid; place-content: center; padding: 12px; background: color-mix(in srgb, var(--paper) 70%, transparent); z-index: 1; }
  .sc-veil { display: grid; justify-items: center; gap: 4px; max-width: 40ch; padding: 8px 16px; text-align: center; background: var(--paper); border: 2px solid var(--ink); }
  .sc-veil b { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; color: var(--ink); }
  .sc-veil span { font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .scope:not(.hist-ok) .sc-flag, .scope:not(.hist-ok) .sc-dir { z-index: 2; }

  .sc-sweep { display: none; }

  .dc-what { grid-area: what; max-width: 72ch; margin-top: var(--s5); font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .dc-what .w-short { display: none; }
  .dc-key { grid-area: key; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s1) var(--s5); margin-top: var(--s3); font-size: var(--t-xs); line-height: 16px; color: var(--ink-2); }
  .k-item i { display: inline-block; margin-right: var(--s2); font-style: normal; }
  .k-line { width: 24px; height: 3px; vertical-align: 3px; background: var(--ink); }
  .k-launch { display: inline-grid !important; place-items: center; width: 14px; height: 14px; border-radius: 50%; vertical-align: -3px; font-size: 9px; font-weight: 700; color: #fff; background: var(--ink); }
  .k-hatch { width: 16px; height: 12px; vertical-align: -1px; border: 1px dashed var(--line2); background: repeating-linear-gradient(135deg, rgba(17, 17, 17, 0.25) 0 1px, transparent 1px 5px); }
  .sc-table { grid-area: table; margin-top: var(--s5); min-width: 0; }
  .sc-table .table-scroll { max-height: 300px; overflow: auto; margin-top: var(--s2); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--s5); align-items: start; }
  .sc-table tr.old td { color: var(--ink-2); }

  @media (prefers-reduced-motion: no-preference) {
    /* The week draws itself once, left to right, behind a hairline; then the level's marks appear. */
    .sc-sweep { display: block; position: absolute; top: 0; bottom: 0; left: 0; width: 1px; z-index: 2; background: var(--ink); opacity: 0; animation: sc-sweep var(--sweep) cubic-bezier(0.45, 0, 0.2, 1) 250ms both; }
    .sc-ink { animation: sc-ink var(--sweep) cubic-bezier(0.45, 0, 0.2, 1) 250ms both; }
    .sc-change, .sc-v3, .sc-dot { animation: sc-fade 360ms var(--ease) calc(var(--sweep) + 200ms) both; }
    @keyframes sc-sweep {
      0% { left: 0; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { left: 100%; opacity: 0; }
    }
    @keyframes sc-ink {
      from { clip-path: inset(0 100% 0 0); }
      to { clip-path: inset(0 0 0 0); }
    }
    @keyframes sc-fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }

  @media (max-width: 1023.98px) {
    .scope { --plot-h: 200px; }
  }

  /* Touch screens cannot hover: the hint says tap. */
  @media (max-width: 640px), (hover: none) {
    .sc-hint .h-long { display: none; }
    .sc-hint .h-short { display: inline; }
    .scope.scrubbed .sc-hint { display: none; }
  }
  @media (max-width: 379.98px) {
    .sc-hint .h-drag { display: none; }
  }

  @media (max-width: 640px) {
    .scope {
      --plot-h: 160px;
      grid-template-columns: 20px 22px minmax(0, 1fr);
      grid-template-rows: auto var(--plot-h) 24px auto auto auto auto;
      grid-template-areas:
        'read read read'
        'rail ticks stage'
        '. . marks'
        '. . days'
        'what what what'
        'key key key'
        'table table table';
      column-gap: 4px;
    }
    .sc-readout { height: 80px; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: 16px 24px 32px; gap: 2px 8px; padding-left: 10px; }
    /* Inter Tight's caps run wider than the riso face's did: at 11px "▲ 1 · RELEASE SURGE" took the
       top row's room from a launch name on a 360px phone. */
    .sc-dir { font-size: 10px; padding: 2px 3px; }
    .sc-r1, .sc-rw { display: contents; }
    .sc-when { grid-area: 1 / 1; min-width: 0; overflow: hidden; }
    .sc-hint { grid-area: 1 / 2; margin-left: 0; align-self: center; }
    .sc-what { grid-area: 2 / 1 / 3 / -1; white-space: nowrap; }
    .sc-rname { display: none; }
    .sc-r2 { grid-column: 1 / -1; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 16px; font-size: var(--t-xs); }
    .sc-cap { display: none; }
    .sc-ticks span.end { display: none; }
    .sc-dir.top, .sc-dir.bottom { left: 4px; }
    .scope:not(.fitted) .sc-flag { display: none; }
    .dc-what .w-long { display: none; }
    .dc-what .w-short { display: inline; }
    .sc-veil { gap: 2px; padding: 6px 10px; }
    .sc-veil .v-live { display: none; }
    .dc-key { gap: 2px 16px; }
    .sc-v3 .yl-long, .sc-change .cf-when { display: none; }
    .sc-v3 .yl-short { display: inline; }
  }
</style>

<script>
  import { FLAG_PITCH, placeLabels, type Box } from '../ui/labels';
  import { REST_LINE, launchLine, nearLine, nowReadout, readout, readoutText, type Readout, type ScrubData } from '../ui/readout';

  const HOUR = 3_600_000;
  /** A pointer this close to the NOW edge (px) reads NOW; anywhere else reads the record. */
  const EDGE_PX = 6;
  /** A pointer this close to a launch's mark (px) lands on it. */
  const SNAP_PX = 8;

  for (const scope of document.querySelectorAll<HTMLElement>('[data-scope]')) {
    let data: ScrubData;
    try {
      data = JSON.parse(scope.dataset.scope ?? '');
    } catch {
      continue;
    }
    const one = <T extends Element = HTMLElement>(sel: string) => scope.querySelector<T>(sel)!;
    const all = <T extends Element = HTMLElement>(sel: string) => [...scope.querySelectorAll<T>(sel)];
    const plot = one('[data-plot]');
    const cursor = one('[data-cursor]');
    const probe = one('[data-probe]');
    const ctag = one('[data-ctag]');
    const box = one('[data-readout]');
    const rWhen = one('[data-r-when]');
    const rWhat = one('[data-r-what]');
    const rName = one('[data-r-name]');
    const rNear = one('[data-r-near]');
    const segs = all('[data-seg]');
    const span = data.to - data.from;
    const max = Math.round(span / HOUR);
    let t: number | null = null;

    // Enhance the static picture into a slider. The series summary becomes its description, once:
    // a hidden paragraph is read only through aria-describedby, never again in reading order.
    const summary = document.createElement('p');
    summary.id = `sc-summary-${Math.random().toString(36).slice(2, 8)}`;
    summary.hidden = true;
    summary.textContent = plot.getAttribute('aria-label') ?? '';
    plot.after(summary);
    plot.setAttribute('role', 'slider');
    plot.setAttribute('tabindex', '0');
    plot.setAttribute('aria-label', 'DROPCON history, last 7 days: move through it with the arrow keys');
    plot.setAttribute('aria-describedby', summary.id);
    plot.setAttribute('aria-valuemin', '0');
    plot.setAttribute('aria-valuemax', String(max));
    one('[data-hint]').hidden = false;

    const paint = (r: Readout, x: number | null) => {
      // At rest the readout names the time only: the level is posted above the sign, and the
      // week's launches are listed under Recent arrivals. A cursor on any hour, NOW included, reads it.
      const resting = x === null;
      rWhen.textContent = r.when;
      rWhat.textContent = resting ? '' : r.what;
      rName.textContent = !resting && r.name ? ` · ${r.name}` : '';
      rNear.textContent = resting ? REST_LINE : r.now ? launchLine(data) : nearLine(data, r);
      box.dataset.tone = r.tone;
      if (r.tone === 'ok' && r.level) box.style.setProperty('--rl', `var(--l${r.level})`);
      else box.style.removeProperty('--rl');
      box.classList.toggle('is-scrub', x !== null && !r.now);
      for (const s of segs) s.classList.toggle('is-probe', x !== null && !r.now && Number(s.dataset.seg) === r.level);
      const near = new Set(r.near.map((l) => String(data.launches.indexOf(l))));
      for (const el of all('[data-launch]')) el.classList.toggle('is-near', x !== null && near.has(el.dataset.launch!));
      if (x === null) {
        cursor.hidden = true;
        ctag.hidden = true;
        return;
      }
      cursor.hidden = false;
      cursor.style.setProperty('--cx', `${x}%`);
      probe.hidden = r.score === undefined;
      if (r.score !== undefined) {
        cursor.style.setProperty('--cy', String(100 - r.score));
        probe.style.setProperty('--probe', r.level ? `var(--l${r.level})` : 'var(--paper)');
      }
      // The time tag rides the day axis under the cursor, kept inside it.
      ctag.hidden = false;
      ctag.textContent = r.now ? 'NOW' : r.when;
      const w = plot.clientWidth;
      const tw = ctag.offsetWidth;
      ctag.style.left = `${Math.min(Math.max((x / 100) * w - tw / 2, 0), w - tw)}px`;
    };

    const show = (at: number) => {
      scope.classList.add('scrubbed');
      t = Math.min(data.to, Math.max(data.from, at));
      const r = readout(data, t);
      paint(r, ((t - data.from) / span) * 100);
      plot.setAttribute('aria-valuenow', String(Math.round((t - data.from) / HOUR)));
      plot.setAttribute('aria-valuetext', readoutText(r));
    };
    const reset = () => {
      t = null;
      const r = nowReadout(data);
      paint(r, null);
      plot.setAttribute('aria-valuenow', String(max));
      plot.setAttribute('aria-valuetext', readoutText(r));
    };
    reset();

    const fromPointer = (e: PointerEvent) => {
      const b = plot.getBoundingClientRect();
      const px = Math.min(b.width, Math.max(0, e.clientX - b.left));
      if (px >= b.width - EDGE_PX) return show(data.to);
      const snap = data.launches.find((l) => Math.abs(((l[0] - data.from) / span) * b.width - px) <= SNAP_PX);
      // Anywhere short of the edge is the record, never the live reading.
      show(Math.min(snap ? snap[0] : data.from + (px / b.width) * span, data.to - 1));
    };
    plot.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || e.buttons) fromPointer(e);
    });
    plot.addEventListener('pointerdown', fromPointer);
    plot.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && document.activeElement !== plot) reset();
    });
    document.addEventListener('pointerdown', (e) => {
      if (t !== null && !plot.contains(e.target as Node)) reset();
    });
    plot.addEventListener('focus', () => show(t ?? data.to));
    plot.addEventListener('blur', reset);
    plot.addEventListener('keydown', (e) => {
      const at = t ?? data.to;
      const step = e.shiftKey ? 24 * HOUR : HOUR;
      const moves: Record<string, number> = {
        ArrowLeft: at - step,
        ArrowDown: at - step,
        ArrowRight: at + step,
        ArrowUp: at + step,
        PageDown: at - 24 * HOUR,
        PageUp: at + 24 * HOUR,
        Home: data.from,
        End: data.to,
        Escape: data.to,
      };
      if (!(e.key in moves)) return;
      e.preventDefault();
      show(moves[e.key]);
    });

    // Place the plot's labels on the plot as drawn: in priority order, each whole or not at all.
    const fit = () => {
      const P = plot.getBoundingClientRect();
      if (!P.width) return;
      // Lift the pre-fit hiding before measuring. A flag still display: none has no box, so it would
      // be skipped here and then shown unplaced; with the fonts cached (the 5-minute reload) this
      // runs once, not twice, and nothing would repair it.
      scope.classList.add('fitted');
      const rel = (el: Element): Box => {
        const r = el.getBoundingClientRect();
        return { left: r.left - P.left, top: r.top - P.top, right: r.right - P.left, bottom: r.bottom - P.top };
      };
      const shown = (el: HTMLElement) => getComputedStyle(el).display !== 'none';
      const labels = all('[data-label]');
      const dayLabels = all('.sc-daylabel');
      for (const el of [...labels, ...dayLabels]) el.classList.remove('is-cut');
      for (const el of all('[data-side0]')) el.dataset.side = el.dataset.side0;
      const flags = all('[data-label="flag"]');
      for (const f of flags) f.style.setProperty('--row', '0');
      const nowTag = scope.querySelector<HTMLElement>('.sc-nowtag');
      const veil = scope.querySelector<HTMLElement>('[data-veil]');
      const taken = [nowTag, veil].filter((el): el is HTMLElement => !!el && shown(el)).map(rel);
      // Fixed labels (direction, the current scale, level changes: latest first), launch names, zones.
      const fixed = all('[data-label="fixed"]');
      const changes = fixed.filter((el) => el.classList.contains('sc-change')).reverse();
      const order = [...fixed.filter((el) => !el.classList.contains('sc-change')), ...changes];
      // A zone label offers the variant its zone's width shows and each shorter one after it.
      const VARIANTS = ['full', 'head', 'min'] as const;
      const zoneLabels = all('[data-label="zone"]');
      for (const z of zoneLabels) delete z.dataset.pick;
      const zones = zoneLabels.flatMap((z) => {
        const variant = (k: (typeof VARIANTS)[number]) => z.querySelector<HTMLElement>(`.zl-${k}`);
        const first = VARIANTS.findIndex((k) => {
          const v = variant(k);
          return !!v && shown(v);
        });
        if (first === -1) return [];
        const picks = VARIANTS.slice(first).filter((k) => variant(k));
        const boxes = picks.map((k) => {
          z.dataset.pick = k;
          return rel(variant(k)!);
        });
        delete z.dataset.pick;
        return [{ el: z, boxes, picks }];
      });
      // A level-change flag may take the other side of its step when its own side is taken.
      const mirrored = (b: Box, below: boolean): Box => {
        const h = b.bottom - b.top;
        return below
          ? { ...b, bottom: b.top - 16, top: b.top - 16 - h }
          : { ...b, top: b.bottom + 16, bottom: b.bottom + 16 + h };
      };
      const items: { el: HTMLElement; boxes: Box[]; flag?: boolean; picks?: readonly string[] }[] = [
        ...order.filter(shown).map((el) => {
          const b = rel(el);
          return { el, boxes: el.dataset.side0 ? [b, mirrored(b, el.dataset.side0 === 'below')] : [b] };
        }),
        ...flags.filter(shown).map((el) => {
          const b = rel(el);
          return {
            el,
            flag: true,
            boxes: [0, 1, 2].map((row) => ({ ...b, top: b.top + row * FLAG_PITCH, bottom: b.bottom + row * FLAG_PITCH })),
          };
        }),
        ...zones,
      ];
      const bounds: Box = { left: 0, top: 0, right: P.width, bottom: P.height };
      const choice = placeLabels(
        items.map((i) => i.boxes),
        bounds,
        taken,
      );
      items.forEach((item, i) => {
        const c = choice[i];
        if (c === undefined) item.el.classList.add('is-cut');
        else if (item.flag) item.el.style.setProperty('--row', String(c));
        else if (item.picks) {
          if (c > 0) item.el.dataset.pick = item.picks[c];
        }
        else if (c === 1) item.el.dataset.side = item.el.dataset.side0 === 'below' ? 'above' : 'below';
      });
      // A flag that could not be measured is never shown unplaced.
      for (const f of flags) if (!shown(f)) f.classList.add('is-cut');
      // The day axis: the latest day first, each label whole or not at all.
      const days = dayLabels.filter(shown).reverse();
      const anywhere = { left: -Infinity, top: -Infinity, right: Infinity, bottom: Infinity };
      placeLabels(
        days.map((d) => [rel(d)]),
        anywhere,
      ).forEach((c, i) => {
        if (c === undefined) days[i].classList.add('is-cut');
      });
      if (t !== null) show(t);
    };
    let queued = 0;
    const refit = () => {
      cancelAnimationFrame(queued);
      queued = requestAnimationFrame(fit);
    };
    new ResizeObserver(refit).observe(plot);
    document.fonts?.ready.then(refit).catch(() => {});
  }
</script>
