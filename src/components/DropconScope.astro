  /* Which way is hot, at the plot's top and bottom edges. */
  .sc-dir { position: absolute; left: 6px; padding: 3px 5px; color: var(--lc); background: rgba(7, 6, 15, 0.82); white-space: nowrap; }
  .sc-dir.top { top: 6px; }
  .sc-dir.bottom { bottom: 6px; }

  /* Launch names, stacked in rows at the top of the plot, each on its own dashed line. */
  .sc-flag { position: absolute; top: calc(6px + var(--row) * 22px); height: 18px; margin-left: 4px; padding: 1px 5px; font-size: var(--fs-xs); line-height: 16px; color: var(--text); white-space: nowrap; background: rgba(7, 6, 15, 0.82); border-left: 2px solid var(--lab); transition: color var(--fast) var(--ease), background var(--fast) var(--ease); }
  .sc-flag i { font-style: normal; color: var(--lab); }
  .sc-flag.flip { margin-left: 0; transform: translateX(calc(-100% - 4px)); border-left: 0; border-right: 2px solid var(--lab); }
  .sc-flag.is-near { color: #fff; background: color-mix(in srgb, var(--lab) 26%, #07060f); }
  .scope:not(.fitted) .sc-flag.unplaced { display: none; }
  .is-cut { visibility: hidden; }

  /* Where the current scale starts, and while its line is young, how much of it there is. */
  .sc-vline { position: absolute; top: 0; bottom: 0; border-left: 1px dashed color-mix(in srgb, var(--lvl) 60%, transparent); }
  .sc-v3 { position: absolute; bottom: 6px; display: grid; gap: 4px; padding: 3px 6px; border-left: 2px solid var(--lvl); white-space: nowrap; background: rgba(7, 6, 15, 0.88); }
  .sc-v3 b { font-family: var(--font-head); font-size: var(--fs-tiny); font-weight: 400; letter-spacing: 0.06em; color: var(--lvl); }
  .sc-v3 > span { font-size: var(--fs-xs); line-height: 1; color: var(--text); }
  .sc-v3.young { --off: 10px; bottom: auto; top: calc(var(--vy) * 1%); transform: translate(calc(-100% - 10px), calc(-100% - var(--off))); border-left: 0; border-right: 2px solid var(--lvl); text-align: right; }
  .sc-v3.young.below { transform: translate(calc(-100% - 10px), var(--off)); }
  .sc-v3 .yl-short { display: none; }

  /* Level changes on the line: where it crossed a band and stayed. A tick joins the flag to the step. */
  .sc-change { position: absolute; z-index: 2; --tx: -100%; --ty: calc(-100% - 8px); transform: translate(var(--tx), var(--ty)); padding: 3px 5px; font-family: var(--font-head); font-size: var(--fs-tiny); letter-spacing: 0.04em; color: var(--lc); white-space: nowrap; background: rgba(7, 6, 15, 0.92); border: 1px solid color-mix(in srgb, var(--lc) 70%, transparent); box-shadow: 0 0 8px color-mix(in srgb, var(--lc) 30%, transparent); }
  .sc-change.right { --tx: 0px; }
  .sc-change[data-side='below'] { --ty: 8px; }
  .sc-change::after { content: ''; position: absolute; right: -1px; top: 100%; height: 9px; border-right: 1px solid var(--lc); }
  .sc-change.right::after { right: auto; left: -1px; border-right: 0; border-left: 1px solid var(--lc); }
  .sc-change[data-side='below']::after { top: auto; bottom: 100%; }
  .sc-change[data-side='above']:not([data-side0='above'])::after, .sc-change[data-side='below']:not([data-side0='below'])::after { display: none; }

  /* NOW: the right edge, a pulsing dot at the live score, and a leader into the number. None of it
     takes the pointer, so hovering the edge reads the plot underneath. */
  .sc-nowline { position: absolute; top: 0; bottom: 0; right: 0; width: 0; border-right: 1px dashed color-mix(in srgb, var(--lvl) 55%, transparent); }
  .sc-dot { position: absolute; z-index: 4; right: -5px; top: calc(var(--y) * 1%); width: 10px; height: 10px; margin-top: -5px; background: var(--lvl); box-shadow: 0 0 10px var(--lvl), 0 0 2px #fff; pointer-events: none; }
  .scope:not(.ok) .sc-dot { background: var(--bg); border: 2px dashed var(--muted); box-shadow: none; }
  .sc-dot::after { content: ''; position: absolute; inset: -2px; border: 2px solid var(--lvl); opacity: 0; }
  .sc-nowtag { display: none; }

  .sc-needle-col { grid-area: needle; position: relative; pointer-events: none; }
  .sc-needle-col::before { content: ''; position: absolute; left: -6px; width: 22px; height: 2px; top: calc(var(--y) * 1%); margin-top: -1px; background: var(--lvl); box-shadow: 0 0 6px var(--lvl); }
  .scope.no-signal .sc-needle-col::before { display: none; }
  .scope:not(.ok) .sc-needle-col::before { background: none; border-top: 2px dashed var(--muted); box-shadow: none; }
  .sc-needle { position: absolute; left: 18px; right: 0; display: flex; flex-direction: column; gap: 6px; top: clamp(0px, calc(var(--y) * 1% - var(--num) * 0.5), calc(100% - var(--num) - var(--eq-h))); pointer-events: auto; }
  /* A low reading puts the score above the number, so the number stays level with the dot. */
  .scope.low .sc-needle { flex-direction: column-reverse; top: clamp(0px, calc(var(--y) * 1% - var(--num) * 0.5 - var(--eq-h) - 6px), calc(100% - var(--num) - var(--eq-h) - 6px)); }
  .scope.no-signal .sc-needle { top: calc(50% - var(--num) * 0.5); }
  .dc-num { font-size: var(--num); line-height: 1; height: var(--num); color: var(--lvl); text-shadow: 0 0 8px currentColor, 0 0 2px currentColor; }
  .scope:not(.ok) .dc-num { text-shadow: none; }
  .sc-eq { display: grid; gap: 4px; min-height: var(--eq-h); align-content: start; font-family: var(--font-head); font-size: var(--fs-tiny); letter-spacing: 0.06em; line-height: 1.4; color: var(--muted); }
  .scope.low .sc-eq { align-content: end; }
  .sc-eq b { font-family: var(--font-mono); font-size: var(--fs-metric); font-weight: 400; letter-spacing: 0; line-height: 1; color: #fff; }
  .sc-eq .of { margin-right: 6px; font-family: var(--font-mono); font-size: var(--fs-lg); letter-spacing: 0; color: var(--muted); }
  .sc-eq b.word { font-family: var(--font-head); font-size: var(--fs-tiny); letter-spacing: 0.06em; color: var(--text); margin-right: 6px; }
  .sc-eq-level { color: var(--lvl); }
  .scope:not(.ok) .sc-eq-level { color: var(--muted); }

  .sc-rail { grid-area: marks; position: relative; border-bottom: 1px solid var(--line2); }
  .sc-mark { position: absolute; top: 4px; transform: translateX(-50%); font-size: 16px; line-height: 1; text-shadow: 0 0 6px currentColor; transition: transform var(--fast) var(--ease); }
  .sc-mark::before { content: ''; position: absolute; left: 50%; top: -5px; height: 5px; border-left: 1px solid currentColor; }
  .sc-mark.is-near { transform: translateX(-50%) scale(1.35); text-shadow: 0 0 10px currentColor, 0 0 2px #fff; }
  .sc-rail-note { position: absolute; left: 6px; top: 8px; color: var(--muted); }
  .sc-days { grid-area: days; position: relative; height: 16px; margin-top: 4px; font-family: var(--font-head); font-size: var(--fs-tiny); color: var(--muted); }
  .sc-days > span { position: absolute; top: 0; white-space: nowrap; }
  .sc-daylabel { transform: translateX(-50%); }
  .sc-daylabel.late { transform: translateX(-100%); }
  .sc-days > .sc-ctag { z-index: 2; top: -3px; padding: 3px 5px; color: #000; background: #fff; box-shadow: 0 0 8px rgba(255, 255, 255, 0.5); }
  .sc-ctag[hidden] { display: none; }

  /* Scrubber: a hairline and a probe on the reading; the words go in the readout. */
  .sc-cursor { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .sc-cursor[hidden] { display: none; }
  .sc-cursor::before { content: ''; position: absolute; top: 0; bottom: 0; left: var(--cx); border-left: 1px solid rgba(255, 255, 255, 0.75); box-shadow: 0 0 6px rgba(255, 255, 255, 0.5); }
  .sc-probe { position: absolute; left: var(--cx); top: calc(var(--cy) * 1%); width: 8px; height: 8px; margin: -4px 0 0 -4px; background: var(--probe, #fff); box-shadow: 0 0 8px var(--probe, #fff); }
  .sc-probe[hidden] { display: none; }

  .sc-empty { position: absolute; inset: 0; display: grid; place-content: center; gap: 8px; padding: 12px; text-align: center; background: rgba(7, 6, 15, 0.55); z-index: 1; }
  .sc-empty b { font-size: var(--fs-tiny); letter-spacing: 0.08em; color: var(--yellow); }
  .sc-empty span { font-size: var(--fs-xs); color: var(--text); max-width: 34ch; }

  .sc-sweep { display: none; }

  /* What the reader is looking at, in one plain paragraph under the instrument. */
  .dc-what { grid-area: what; margin: 12px 0 0; font-size: var(--fs-sm); line-height: 1.3; color: var(--text); }
  .dc-what .tiny { margin-right: 6px; color: var(--cyan); }
  .dc-what .nf { font-weight: 400; font-family: var(--font-head); font-size: var(--fs-tiny); letter-spacing: 0.06em; color: var(--yellow); }
  .dc-key { grid-area: key; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 18px; margin: 6px 0 0; font-size: var(--fs-xs); color: var(--muted); }
  .k-item i { display: inline-block; margin-right: 6px; font-style: normal; }
  .k-line { width: 18px; height: 3px; vertical-align: 4px; background: linear-gradient(90deg, var(--l5), var(--l4), var(--l3), var(--l2), var(--l1)); box-shadow: 0 0 4px rgba(255, 226, 28, 0.6); }
  .k-launch { color: var(--text); }
  .k-hatch { width: 16px; height: 12px; vertical-align: -1px; border: 1px dashed rgba(138, 132, 184, 0.6); background: repeating-linear-gradient(135deg, rgba(138, 132, 184, 0.4) 0 2px, transparent 2px 5px); }
  .sc-table { grid-area: table; margin: 4px 0 0; min-width: 0; }
  .sc-table summary { color: var(--cyan); padding: 6px 0; display: inline-block; }
  .sc-table summary::before { content: '+ '; }
  .sc-table[open] summary::before { content: '- '; }
  .sc-table .table-scroll { max-height: 280px; overflow: auto; margin-top: 6px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 12px; align-items: start; }
  .sc-table tr.old td { color: var(--muted); }

  @media (prefers-reduced-motion: no-preference) {
    /* The oscilloscope sweep: the beam crosses the plot once and the trace is inked behind it. */
    .sc-sweep { display: block; position: absolute; top: 0; bottom: 0; left: 0; width: 2px; z-index: 2; background: var(--lvl, #fff); box-shadow: 0 0 12px var(--lvl, #fff), 0 0 3px #fff; opacity: 0; animation: sc-sweep var(--sweep) cubic-bezier(0.45, 0, 0.2, 1) 200ms both; }
    .sc-sweep::before { content: ''; position: absolute; top: 0; bottom: 0; right: 2px; width: 80px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--lvl, #fff) 18%, transparent)); }
    .sc-ink { animation: sc-ink var(--sweep) cubic-bezier(0.45, 0, 0.2, 1) 200ms both; }
    .sc-change, .sc-v3 { animation: sc-fade 360ms var(--ease) calc(var(--sweep) + 60ms) both; }
    /* The readout's terminal cursor blinks while the reading is live. */
    .sc-readout:not(.is-scrub) .sc-what::after { animation: sc-blink 1060ms steps(1, end) infinite; }
    .sc-dot { animation: sc-pop 260ms var(--ease) calc(var(--sweep) + 120ms) both; }
    .scope.ok .sc-dot::after { animation: sc-pulse 1800ms ease-out calc(var(--sweep) + 400ms) infinite; }
    .scope.ok .seg.on { animation: sc-breathe 2800ms ease-in-out calc(var(--sweep) + 400ms) infinite; }
    .sc-needle-col::before { animation: sc-leader 300ms var(--ease) calc(var(--sweep) + 60ms) both; transform-origin: left center; }
    /* When the beam reaches NOW the number flares, like a phosphor struck again, then settles. */
    .scope.ok .dc-num { animation: sc-flare 520ms steps(6, end) calc(var(--sweep) + 120ms) both; }
    @keyframes sc-sweep {
      0% { left: 0; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { left: 100%; opacity: 0; }
    }
    @keyframes sc-ink {
      from { clip-path: inset(0 100% 0 0); }
      to { clip-path: inset(0 0 0 0); }
    }
    @keyframes sc-blink {
      0%, 49% { opacity: 0.85; }
      50%, 100% { opacity: 0; }
    }
    @keyframes sc-fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes sc-pop {
      from { transform: scale(0); }
      to { transform: none; }
    }
    @keyframes sc-pulse {
      0% { transform: scale(1); opacity: 0.9; }
      100% { transform: scale(3.2); opacity: 0; }
    }
    @keyframes sc-breathe {
      0%, 100% { box-shadow: 0 0 10px var(--c), 0 0 2px var(--c); }
      50% { box-shadow: 0 0 20px var(--c), 0 0 4px var(--c); }
    }
    @keyframes sc-flare {
      0% { text-shadow: 0 0 8px currentColor, 0 0 2px currentColor; }
      30% { text-shadow: 0 0 22px currentColor, 0 0 6px #fff; opacity: 0.75; }
      60% { opacity: 1; }
      100% { text-shadow: 0 0 8px currentColor, 0 0 2px currentColor; }
    }
    @keyframes sc-leader {
      from { transform: scaleX(0); }
      to { transform: none; }
    }
  }

  /* Phones: the number goes above the plot, which takes the full width; a NOW tag marks the edge. */
  @media (max-width: 640px) {
    .scope {
      --plot-h: 140px;
      --num: 64px;
      grid-template-columns: 20px 18px 30px minmax(0, 1fr);
      grid-template-rows: auto auto auto auto auto var(--plot-h) 22px auto auto auto;
      grid-template-areas:
        'num num num name'
        'num num num eq'
        'head head head head'
        'what what what what'
        'read read read read'
        'rail ticks stage stage'
        '. . marks marks'
        '. . days days'
        'key key key key'
        'table table table table';
      column-gap: 4px;
    }
    .dc-lede, .sc-needle-col, .sc-needle { display: contents; }
    .sc-needle-col::before { content: none; }
    .dc-num { grid-area: num; align-self: center; margin-right: 8px; }
    .dc-name { grid-area: name; align-self: end; }
    .sc-eq { grid-area: eq; min-height: 0; margin-top: 6px; gap: 2px; }
    .sc-eq b { font-size: var(--fs-lg); }
    .sc-eq .of { font-size: var(--fs-sm); margin-right: 4px; }
    .dc-headline { grid-area: head; margin: 8px 0 0; font-size: var(--fs-sm); }
    .dc-what { margin: 8px 0 10px; font-size: var(--fs-xs); line-height: 1.2; }
    /* Three fixed rows (time, reading, launches) so a long line never moves the plot under a finger. */
    .sc-readout { height: 74px; grid-template-rows: 12px 20px 32px; gap: 2px; margin-bottom: 8px; padding: 0 8px; }
    .sc-r1 { display: contents; }
    .sc-rname, .sc-hint { display: none; }
    .sc-what { white-space: nowrap; }
    .sc-r2 { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 16px; }
    .sc-cap { display: none; }
    .sc-ticks span.end { display: none; }
    .sc-dot { right: -4px; }
    .sc-nowtag { display: block; position: absolute; z-index: 4; right: 10px; top: calc(var(--y) * 1%); transform: translateY(calc(-100% - 6px)); padding: 3px 5px; color: var(--lvl); background: rgba(7, 6, 15, 0.9); border: 1px solid var(--lvl); pointer-events: none; }
    .sc-nowtag b { font-weight: 400; }
    .scope:not(.ok) .sc-nowtag { color: var(--muted); border-style: dashed; border-color: var(--muted); }
    .sc-days .mon { display: none; }
    .sc-dir.top, .sc-dir.bottom { left: 4px; }
    .scope:not(.fitted) .sc-flag { display: none; }
    .dc-key { gap: 2px 12px; margin-top: 10px; }
    .sc-v3 .yl-long, .sc-change .cf-when { display: none; }
    .sc-v3 .yl-short { display: inline; }
