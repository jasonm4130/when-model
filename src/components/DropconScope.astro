---
/**
 * The DROPCON instrument: the level now and how it got here, as one piece. The 5-level scale is the
 * plot's vertical axis, the lead score's week runs across it, and the line ends at the NOW edge in
 * the big number. Server-rendered SVG and HTML; the script below turns the plot into a slider whose
 * readout names each hour, and never touches the number: that is always NOW.
 */
import type { HistoryResponseBody } from '../app/load-dashboard';
import type { Dashboard } from '../domain/dashboard';
import { LEVEL_BANDS, type DropconLevel } from '../domain/dropcon';
import { INSTRUMENT_WIDTH, LAUNCH_NEAR_MS, buildInstrument, type ScrubPoint } from '../domain/instrument';
import { stripDay, stripHour } from '../domain/history';
import { LEVEL_NAMES } from '../domain/levels';
import { SOURCE } from '../domain/sources';
import { estimateFlagWidth, flagCandidates, placeLabels, type Box } from '../ui/labels';
import { dropconName, dropconNumber } from '../ui/odds';
import { launchLine, nowReadout, type ScrubData, type ScrubKind } from '../ui/readout';
interface Props {
  d: Dashboard;
  history?: HistoryResponseBody;
  now?: number;
}
const { d, history, now = Date.now() } = Astro.props;
const c = d.dropcon;
const launchesOk = d.sources.find((s) => s.name === SOURCE.openrouter)?.ok ?? false;
const inst = buildInstrument({
  points: history?.points ?? [],
  ok: history?.ok ?? false,
  now,
  currentVersion: d.measurement.algorithmVersion,
  live: { state: c.state, score: c.score, level: c.level, at: d.generatedAt },
  launches: d.landed.releases.map((r) => ({ at: r.firstListedAt, labId: r.labId, lab: r.lab, name: r.name })),
  launchesOk,
});
const ok = c.state === 'ok';
// Band edges top to bottom: 100–75 is level 1, …, 15–0 is level 5.
const edges = [100, ...LEVEL_BANDS, 0];
const bands = edges.slice(0, -1).map((top, i) => ({ level: (i + 1) as DropconLevel, top, bottom: edges[i + 1] }));
const pct = (x: number) => `${(x / INSTRUMENT_WIDTH) * 100}%`;
const segClass = (n: number) => {
  if (c.state === 'no-signal') return 'seg dim';
  if (c.state === 'floor') return `seg dim${n === c.level ? ' floor' : ''}`;
  return `seg${n === c.level ? ' on' : ''}`;
};
const scaleLabel =
  c.state === 'no-signal'
    ? 'DROPCON: no signal'
    : c.state === 'floor'
      ? `DROPCON floor: ${c.level} of 5 with the odds offline`
      : `DROPCON ${c.level} of 5`;
const bandRange = (b: { top: number; bottom: number }) =>
  b.top === 100 ? `${b.bottom}+` : b.bottom === 0 ? `below ${b.top}` : `${b.bottom}–${b.top - 1}`;

// What each hatched or empty stretch says, at three widths: the plot picks the one that fits whole.
const zoneText = (z: (typeof inst.zones)[number]) =>
  z.kind === 'old'
    ? { head: `v${z.version} · OLD SCALE`, sub: 'another formula, not comparable', min: `v${z.version}` }
    : z.kind === 'outage'
      ? { head: 'ODDS OFFLINE', sub: 'level held, not measured', min: '✕' }
      : { head: 'NO RECORD', sub: z.x === 0 ? `captures start ${stripDay(z.to)}` : 'no captures', min: '' };

// The scrubber's data and the readout it starts from (the same functions the browser runs).
const K: Record<ScrubPoint['kind'], ScrubKind> = { current: 'c', old: 'o', outage: 'x' };
const data: ScrubData = {
  from: inst.from,
  to: inst.to,
  version: inst.currentVersion,
  history: inst.state,
  launchesOk: inst.launchesOk,
  ...(inst.recordedFrom ? { recordFrom: Date.parse(inst.recordedFrom) } : {}),
  near: LAUNCH_NEAR_MS,
  pts: inst.scrub.map((p) => [K[p.kind], p.h, p.e, p.score, p.level ?? 0, p.held ? 1 : 0, p.version]),
  launches: inst.launches.map((l) => [Date.parse(l.at), l.name, l.lab, l.glyph, l.color]),
  live: { state: c.state, at: Date.parse(d.generatedAt), score: c.score, level: c.level },
};
const rest = nowReadout(data);
const restNear = launchLine(data);

// The current version's start: a quiet tag once its line explains itself, a callout while it is young.
const cur = inst.current;
const v3 = cur && cur.x > INSTRUMENT_WIDTH * 0.03 ? cur : undefined;
const readings = cur ? `${cur.count} hourly reading${cur.count === 1 ? '' : 's'}` : '';
const youngBelow = (cur?.y ?? inst.now.y) < 58;
const hhmm = inst.currentSince ? stripHour(inst.currentSince).slice(-6) : '';

// First paint places launch names on a reference 1000 x 236 px plot with estimated widths; the
// script measures the real plot and places them again (src/ui/labels.ts either way).
const REF: Box = { left: 0, top: 0, right: INSTRUMENT_WIDTH, bottom: 236 };
const flagText = (l: (typeof inst.launches)[number]) => `${l.glyph} ${l.name}`;
const dirTop: Box = { left: 0, top: 0, right: 180, bottom: 24 };
const changeBoxes: Box[] = inst.changes.map((ch) => {
  const w = ch.text.length * 8 + 12;
  const y = (ch.y / 100) * REF.bottom;
  const left = ch.side === 'left' ? ch.x - w : ch.x;
  return ch.dir === 'up'
    ? { left, right: left + w, top: y - 28, bottom: y - 8 }
    : { left, right: left + w, top: y + 8, bottom: y + 28 };
});
const rows = placeLabels(
  inst.launches.map((l) => flagCandidates(l.x, estimateFlagWidth(flagText(l)), l.flip)),
  REF,
  [dirTop, ...changeBoxes],
);

const tableRows = inst.scrub.slice().reverse();
---
<div
  class:list={['scope', c.state, `hist-${inst.state}`, { young: cur?.young, low: inst.now.y > 55, high: inst.now.y < 20 }]}
  data-scope={JSON.stringify(data)}
  style={`--y:${inst.now.y}`}
>
  <div class="dc-lede">
    <p class="dc-name head">{dropconName(c)}</p>
    <p class="dc-headline">{c.headline}</p>
  </div>

  <div class="sc-needle-col">
    <div class="sc-needle">
      <div class="dc-num head" data-num>{dropconNumber(c)}</div>
      <p class="sc-eq">
        {ok ? (
          <>
            <span class="sc-eq-score"><b>{c.score}</b><span class="of">/100</span> LEAD SCORE</span>
            <span class="sc-eq-level"><span aria-hidden="true">→ </span><span class="sr-only">sets </span>LEVEL {c.level} OF 5</span>
          </>
        ) : c.state === 'floor' ? (
          <>
            <span class="sc-eq-score"><b class="word">FLOOR</b> ODDS OFFLINE</span>
            <span class="sc-eq-level">NOT A MEASUREMENT</span>
          </>
        ) : (
          <span class="sc-eq-score"><b class="word">NO SIGNAL</b></span>
        )}
      </p>
    </div>
  </div>

  <div class="sc-readout" data-readout data-tone={rest.tone} style={rest.tone === 'ok' && rest.level ? `--rl:var(--l${rest.level})` : undefined}>
    <p class="sc-r1">
      <b class="sc-when" data-r-when>{rest.when}</b>
      <span class="sc-what"><span data-r-what>{rest.what}</span><span class="sc-rname" data-r-name>{rest.name ? ` · ${rest.name}` : ''}</span></span>
      <span class="sc-hint tiny" data-hint hidden aria-hidden="true">◀ ▶ HOVER, DRAG OR ARROW KEYS</span>
    </p>
    <p class="sc-r2" data-r-near>{restNear}</p>
  </div>

  <span class="sc-cap sc-cap-level tiny" aria-hidden="true">LEVEL</span>
  <span class="sc-cap sc-cap-plot tiny" aria-hidden="true">LEAD SCORE <span class="muted">0–100 · HOURLY · LAST 7 DAYS</span></span>
  <span class="sc-cap sc-cap-now tiny" aria-hidden="true">NOW</span>

  <div class="dc-scale" role="img" aria-label={scaleLabel}>
    {bands.map((b, i) => (
      <div class={`${segClass(b.level)} l${b.level}`} data-seg={b.level} style={`--c:${ok ? `var(--l${b.level})` : 'var(--muted)'}; --i:${i}`} title={`DROPCON ${b.level} · ${LEVEL_NAMES[b.level]} · score ${bandRange(b)}`}>
        <span>{b.level}</span>
      </div>
    ))}
  </div>
  <div class="sc-ticks" aria-hidden="true">
    {edges.map((v) => <span class:list={[{ end: v === 100 || v === 0 }]} style={`top:${100 - v}%`}>{v}</span>)}
  </div>

  <div class="sc-stage">
    <div class="sc-plot" data-plot role="img" aria-label={inst.summary}>
      <svg class="sc-bg" viewBox={`0 0 ${INSTRUMENT_WIDTH} 100`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {bands.map((b) => (
          <rect class:list={['sc-band', `l${b.level}`, { on: ok && b.level === c.level }]} x="0" y={100 - b.top} width={INSTRUMENT_WIDTH} height={b.top - b.bottom} />
        ))}
        {LEVEL_BANDS.map((edge) => <line class="sc-guide" x1="0" x2={INSTRUMENT_WIDTH} y1={100 - edge} y2={100 - edge} />)}
        {inst.ticks.map((t) => <line class="sc-day" x1={t.x} x2={t.x} y1="0" y2="100" />)}
      </svg>
      {inst.zones.map((z) => {
        const t = zoneText(z);
        return (
          <div class={`sc-zone ${z.kind}`} style={`left:${pct(z.x)}; width:${pct(z.w)}`} aria-hidden="true">
            <span class="sc-zlabel" data-label="zone">
              <span class="zl-full"><b>{t.head}</b><span>{t.sub}</span></span>
              <b class="zl-head">{t.head}</b>
              {t.min && <b class="zl-min">{t.min}</b>}
            </span>
          </div>
        );
      })}
      <span class="sc-dir top l1 tiny" data-label="fixed" aria-hidden="true">▲ 1 · RELEASE SURGE</span>
      <span class="sc-dir bottom l5 tiny" data-label="fixed" aria-hidden="true">▼ 5 · QUIET ORBIT</span>
      {/* Labels sit under the ink, so a high or low trace is never hidden behind one. */}
      {inst.launches.map((l, i) => (
        <span
          class:list={['sc-flag', { flip: l.flip, unplaced: rows[i] === undefined }]}
          style={`left:${pct(l.x)}; --row:${rows[i] ?? 0}; --lab:${l.color}`}
          data-launch={i}
          data-label="flag"
          aria-hidden="true"
        ><i>{l.glyph}</i> {l.name}</span>
      ))}
      {v3 && <span class="sc-vline" style={`left:${pct(v3.x)}`} aria-hidden="true"></span>}
      {v3 && (v3.young ? (
        <span class:list={['sc-v3 young', youngBelow ? 'below' : 'above']} style={`left:${pct(v3.x)}; --vy:${v3.y}`} data-label="fixed" aria-hidden="true">
          <b><span class="yl-long">v{inst.currentVersion} SCALE FROM {stripHour(inst.currentSince!).toUpperCase()}</span><span class="yl-short">v{inst.currentVersion} FROM {hhmm}</span></b>
          <span>{readings} so far{inst.now.joined && <span class="yl-long"> · updates every 15 min</span>}</span>
        </span>
      ) : (
        <span class="sc-v3" style={`left:${pct(v3.x)}`} data-label="fixed" aria-hidden="true"><b>v{inst.currentVersion} SCALE</b></span>
      ))}
      <div class="sc-ink" aria-hidden="true">
        <svg viewBox={`0 0 ${INSTRUMENT_WIDTH} 100`} preserveAspectRatio="none" focusable="false">
          <defs>
            <linearGradient id="sc-level-ink" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="100">
              {bands.flatMap((b) => [
                <stop class={`l${b.level}`} offset={`${100 - b.top}%`} />,
                <stop class={`l${b.level}`} offset={`${100 - b.bottom}%`} />,
              ])}
            </linearGradient>
          </defs>
          {inst.launches.map((l, i) => (
            <line class="sc-launch" data-launch={i} x1={l.x} x2={l.x} y1="0" y2="100" style={`stroke:${l.color}`} />
          ))}
          {inst.traces.map((t) => <path class="sc-area" d={t.area} />)}
          {inst.traces.map((t) => <path class="sc-glow" d={t.line} />)}
          {inst.traces.map((t) => <path class="sc-line" d={t.line} />)}
        </svg>
      </div>
      {/* Level changes sit over the ink, beside the step where the line was not. */}
      {inst.changes.map((ch) => {
        const words = ch.text.split(' ');
        return (
          <span
            class:list={['sc-change', `l${ch.level}`, ch.side]}
            style={`left:${pct(ch.x)}; top:${ch.y}%`}
            data-side={ch.dir === 'up' ? 'above' : 'below'}
            data-side0={ch.dir === 'up' ? 'above' : 'below'}
            data-label="fixed"
            aria-hidden="true"
          ><span class="cf-dir">{words.slice(0, 2).join(' ')}</span><span class="cf-when"> {words.slice(2).join(' ')}</span></span>
        );
      })}
      <span class="sc-nowline" aria-hidden="true"></span>
      <span class="sc-sweep" aria-hidden="true"></span>
      <div class="sc-cursor" data-cursor hidden aria-hidden="true">
        <span class="sc-probe" data-probe hidden></span>
      </div>
      {inst.state !== 'ok' && (
        <div class="sc-empty" aria-hidden="true">
          <b class="head">{inst.state === 'empty' ? 'NO READINGS YET' : 'HISTORY OFFLINE'}</b>
          <span>{inst.state === 'empty'
            ? `v${inst.currentVersion} history starts ${stripDay(now)}: the 15-minute capture writes the first point.`
            : 'The score series could not be read. The level shown is live.'}</span>
        </div>
      )}
    </div>
    {c.state !== 'no-signal' && <span class:list={['sc-dot', { joined: inst.now.joined }]} aria-hidden="true"></span>}
    {c.state !== 'no-signal' && (
      <span class="sc-nowtag tiny" aria-hidden="true">NOW <b>{dropconNumber(c)}</b></span>
    )}
  </div>

  <div class="sc-rail" aria-hidden="true">
    {inst.launches.map((l, i) => (
      <span class="sc-mark" data-launch={i} style={`left:${pct(l.x)}; color:${l.color}`} title={`${l.name} · ${l.lab} · ${stripHour(l.at)}`}>{l.glyph}</span>
    ))}
    {!inst.launchesOk && <span class="sc-rail-note tiny">LAUNCH LISTINGS OFFLINE</span>}
  </div>
  <div class="sc-days" aria-hidden="true">
    {inst.ticks.map((t) => {
      const [day, mon] = t.label.split(' ');
      return <span class:list={['sc-daylabel', { late: t.x > 930 }]} style={`left:${pct(t.x)}`}>{day}<span class="mon"> {mon}</span></span>;
    })}
    <span class="sc-ctag" data-ctag hidden></span>
  </div>

<p class="dc-what">
  <b class="tiny">WHAT IS THIS?</b> DROPCON reads Polymarket's odds on frontier model releases into a
  0–100 lead score. The score's band sets the level, 5 (quiet) to 1 (release surge); the line is that
  score over time. It is a lead score, <b class="nf">NOT A FORECAST</b>. <a href="#dc-adds">How it adds up</a> · <a href="/backtest">/backtest</a>
</p>
<p class="dc-key">
  <span class="k-item"><i class="k-line" aria-hidden="true"></i>lead score, coloured by its level</span>
  <span class="k-item"><i class="k-launch" aria-hidden="true">◆</i>frontier launch (first OpenRouter listing): context only, the score has not been shown to predict launches</span>
  <span class="k-item"><i class="k-hatch" aria-hidden="true"></i>older scoring, not comparable</span>
</p>

<details class="sc-table">
  <summary class="tiny">THE WEEK AS A TABLE</summary>
  <div class="table-scroll" role="region" tabindex="0" aria-label="DROPCON readings and launches, last 7 days">
    <table>
      <caption class="sr-only">DROPCON hourly readings, newest first, and frontier launches in the same 7 days</caption>
      <thead><tr><th scope="col">HOUR (UTC)</th><th scope="col">SCORE</th><th scope="col">LEVEL</th></tr></thead>
      <tbody>
        {ok && <tr><td>NOW · {stripHour(d.generatedAt)}</td><td>{c.score}</td><td>{c.level}</td></tr>}
        {tableRows.map((p) => (
          <tr class:list={[{ old: p.kind === 'old' }]}>
            <td>{stripHour(new Date(p.h).toISOString())}</td>
            <td>{p.kind === 'outage' ? 'odds offline' : p.kind === 'old' ? `${p.score} (v${p.version}, old scale)` : p.score}</td>
            <td>{p.kind === 'old' ? '—' : `${p.level}${p.held ? ' (held)' : ''}`}</td>
          </tr>
        ))}
        {!tableRows.length && (
          <tr><td colspan="3">{inst.state === 'unavailable' ? 'The score series could not be read.' : 'No readings recorded in these 7 days.'}</td></tr>
        )}
      </tbody>
    </table>
    {inst.launches.length > 0 && (
      <table>
        <caption class="sr-only">Frontier launches listed on OpenRouter in the same 7 days</caption>
        <thead><tr><th scope="col">LISTED (UTC)</th><th scope="col">LAUNCH</th><th scope="col">LAB</th></tr></thead>
        <tbody>
          {[...inst.launches].reverse().map((l) => <tr><td>{stripHour(l.at)}</td><td>{l.name}</td><td>{l.lab}</td></tr>)}
        </tbody>
      </table>
    )}
  </div>
</details>
</div>

<style>
  .scope {
    --l1: var(--red);
    --l2: var(--orange);
    --l3: var(--yellow);
    --l4: var(--cyan);
    --l5: var(--green);
    --plot-h: 236px;
    --needle-w: 212px;
    --num: 120px;
    --eq-h: 52px;
    --sweep: 1500ms;
    position: relative;
    display: grid;
    grid-template-columns: 30px 28px minmax(0, 1fr) var(--needle-w);
    grid-template-rows: auto auto auto var(--plot-h) 26px auto auto auto auto;
    grid-template-areas:
      'lede lede lede lede'
      'read read read .'
      'lcap lcap pcap ncap'
      'rail ticks stage needle'
      '. . marks .'
      '. . days .'
      'what what what what'
      'key key key key'
      'table table table table';
    column-gap: 6px;
  }
  .l1 { --lc: var(--l1); }
  .l2 { --lc: var(--l2); }
  .l3 { --lc: var(--l3); }
  .l4 { --lc: var(--l4); }
  .l5 { --lc: var(--l5); }

  /* The name of the level and why, on one line where it fits. */
  .dc-lede { grid-area: lede; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 22px; margin-bottom: 12px; }
  .dc-name { font-size: var(--fs-head); line-height: 1.4; color: var(--lvl); text-shadow: 0 0 6px color-mix(in srgb, var(--lvl) 50%, transparent); }
  .scope:not(.ok) .dc-name { text-shadow: none; }
  .dc-headline { font-size: var(--fs-lg); line-height: 1.2; color: #fff; }

  /* The readout: what the cursor is on, NOW at rest. Fixed height, so scrubbing never moves the plot. */
  .sc-readout { --rl: var(--lvl); grid-area: read; display: grid; grid-template-rows: 22px 20px; align-content: center; gap: 2px; min-width: 0; height: 54px; margin-bottom: 10px; padding: 0 10px; border: 1px solid var(--line2); border-left: 3px solid var(--rl); background: linear-gradient(90deg, color-mix(in srgb, var(--rl) 8%, transparent), transparent 60%), rgba(5, 4, 12, 0.7); box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.6); }
  .sc-readout[data-tone='old'], .sc-readout[data-tone='none'] { --rl: var(--muted); }
  .sc-readout[data-tone='outage'] { --rl: var(--red); }
  .sc-readout.is-scrub { border-color: rgba(255, 255, 255, 0.35); border-left-color: var(--rl); }
  .sc-r1 { display: flex; align-items: baseline; gap: 12px; min-width: 0; white-space: nowrap; overflow: hidden; }
  .sc-when { flex: none; font-family: var(--font-head); font-size: var(--fs-tiny); font-weight: 400; letter-spacing: 0.06em; color: var(--rl); }
  .sc-readout.is-scrub .sc-when { color: #fff; }
  .sc-what { min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: var(--fs-md); color: #fff; }
  .sc-readout[data-tone='old'] .sc-what, .sc-readout[data-tone='none'] .sc-what { color: var(--text); }
  .sc-rname { color: var(--rl); }
  .sc-what::after { content: ''; display: inline-block; width: 0.5em; height: 0.9em; margin-left: 4px; vertical-align: -1px; background: var(--rl); opacity: 0; }
  .sc-hint { margin-left: auto; flex: none; color: var(--muted); }
  .sc-hint[hidden] { display: none; }
  .sc-r2 { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: var(--fs-xs); color: var(--muted); }

  .sc-cap { padding-bottom: 8px; color: var(--text); white-space: nowrap; overflow: hidden; }
  .sc-cap-level { grid-area: lcap; color: var(--muted); }
  .sc-cap-plot { grid-area: pcap; }
  .sc-cap-now { grid-area: ncap; padding-left: 18px; color: var(--lvl); }

  /* The DROPCON scale, standing up: each level's segment is as tall as its score band. */
  .dc-scale { grid-area: rail; display: grid; grid-template-rows: 25fr 20fr 20fr 20fr 15fr; gap: 2px; }
  .seg { display: grid; place-items: center; font-family: var(--font-head); font-size: var(--fs-tiny); color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); background: color-mix(in srgb, var(--c) 10%, transparent); transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease), outline-color var(--fast) var(--ease); outline: 1px solid transparent; outline-offset: 1px; }
  .seg:hover { border-color: var(--c); }
  .seg.on { background: var(--c); border-color: var(--c); color: #000; box-shadow: 0 0 10px var(--c), 0 0 2px var(--c); }
  .seg.dim { border-style: dashed; background: transparent; }
  .seg.floor { border: 2px solid var(--muted); }
  .seg.is-probe { outline-color: #fff; }

  .sc-ticks { grid-area: ticks; position: relative; font-family: var(--font-head); font-size: var(--fs-tiny); color: var(--muted); }
  .sc-ticks span { position: absolute; right: 0; transform: translateY(-50%); line-height: 1; }

  .sc-stage { grid-area: stage; position: relative; min-width: 0; }
  .sc-plot { position: absolute; inset: 0; border: 1px solid var(--line2); background: rgba(5, 4, 12, 0.6); box-shadow: inset 0 0 28px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(0, 0, 0, 0.5), 0 0 18px color-mix(in srgb, var(--lvl) 10%, transparent); overflow: hidden; touch-action: pan-y; }
  .sc-plot[role='slider'] { cursor: crosshair; }
  .sc-plot:focus-visible { outline: 2px solid var(--yellow); outline-offset: 2px; }
  .sc-plot svg, .sc-ink { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sc-band { fill: var(--lc); opacity: 0.045; }
  .sc-band.on { opacity: 0.12; }
  .sc-guide { stroke: var(--line2); stroke-width: 1; stroke-dasharray: 2 5; vector-effect: non-scaling-stroke; }
  .sc-day { stroke: rgba(138, 132, 184, 0.14); stroke-width: 1; vector-effect: non-scaling-stroke; }
  #sc-level-ink stop { stop-color: var(--lc); }
  .sc-area { fill: url(#sc-level-ink); opacity: 0.16; shape-rendering: crispEdges; }
  .sc-glow { fill: none; stroke: url(#sc-level-ink); stroke-width: 7; opacity: 0.4; filter: blur(3px); vector-effect: non-scaling-stroke; }
  .sc-line { fill: none; stroke: url(#sc-level-ink); stroke-width: 2.5; stroke-linejoin: miter; vector-effect: non-scaling-stroke; }
  .sc-launch { stroke-width: 1; stroke-dasharray: 3 3; opacity: 0.55; vector-effect: non-scaling-stroke; transition: opacity var(--fast) var(--ease); }
  .sc-launch.is-near { opacity: 1; stroke-dasharray: none; }

  /* Stretches with no line on this axis: hatched or dark. The label shows whole, or not at all. */
  .sc-zone { position: absolute; top: 0; bottom: 0; overflow: hidden; border-right: 1px dashed rgba(138, 132, 184, 0.45); container: zone / inline-size; }
  .sc-zone.unrecorded { background: rgba(7, 6, 15, 0.72); }
  .sc-zone.old { background: repeating-linear-gradient(135deg, rgba(138, 132, 184, 0.16) 0 2px, transparent 2px 8px), rgba(7, 6, 15, 0.6); }
  .sc-zone.outage { background: repeating-linear-gradient(45deg, rgba(255, 51, 85, 0.16) 0 2px, transparent 2px 8px), rgba(7, 6, 15, 0.5); }
  .sc-zlabel { position: absolute; left: 6px; bottom: 28px; max-width: calc(100% - 12px); }
  .sc-zlabel > * { display: none; white-space: nowrap; }
  .sc-zlabel b { font-family: var(--font-head); font-size: var(--fs-tiny); font-weight: 400; letter-spacing: 0.06em; color: var(--muted); }
  .zl-full { gap: 5px; }
  .zl-full span { font-size: var(--fs-xs); color: var(--muted); }
  @container zone (min-width: 250px) {
    .sc-zlabel > .zl-full { display: grid; }
  }
  @container zone (min-width: 140px) and (max-width: 249.98px) {
    .sc-zlabel > .zl-head { display: block; }
  }
  @container zone (min-width: 40px) and (max-width: 139.98px) {
    .sc-zlabel > .zl-min { display: block; }
