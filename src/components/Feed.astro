---
import type { Dashboard } from '../lib/dashboard';
import { ago } from '../lib/format';
import { X_WATCHLIST } from '../lib/labs';
interface Props { d: Dashboard }
const { d } = Astro.props;
const now = Date.now();
const labels: Record<string, string> = { hn: 'HN', openai: 'OPENAI', deepmind: 'DEEPMIND', anthropic: 'ANTHROPIC', github: 'GITHUB', papers: 'PAPERS' };
const colors: Record<string, string> = { hn: 'var(--orange)', openai: 'var(--green)', deepmind: 'var(--blue)', anthropic: '#ff7a1a', github: 'var(--muted)', papers: 'var(--yellow)' };
const alerts = d.feed.filter((f) => f.alert).length;
---
<section class="section wrap">
  <div class="grid feed-grid">
    <div class="panel">
      <div class="panel-head">
        <h2><span>◍</span>OSINT FEED</h2>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <span class="pill live">AUTO</span>
          <span class="pill">{d.feed.length} REPORTS · <span class="glow-m">{alerts} ALERTS</span></span>
        </div>
      </div>
      <div class="feed" data-feed>
        {d.feed.map((f) => (
          <a class={`item ${f.alert ? 'alert' : ''}`} href={f.url} target="_blank" rel="noopener">
            <span class="src tiny" style={`color:${colors[f.source]}`}>{labels[f.source]}</span>
            <span class="ttl">{f.alert && <span class="glow-m">⚠ </span>}{f.title}</span>
            <span class="when muted" data-time={f.publishedAt}>{ago(f.publishedAt, now)}</span>
            {f.meta && <span class="meta muted">{f.meta}</span>}
          </a>
        ))}
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2><span>✕</span>X WATCHLIST</h2><span class="pill warn">NO FREE API · CLICK THROUGH</span></div>
      <p class="muted" style="margin:0 0 10px;font-size:18px">X killed free read access, so we can't ingest the vague-posts. These are the accounts that leak first.</p>
      <ul class="xlist">
        {X_WATCHLIST.map((a) => (
          <li><a href={`https://x.com/${a.handle}`} target="_blank" rel="noopener">@{a.handle}</a><span class="muted"> — {a.why}</span></li>
        ))}
      </ul>
      <div class="panel-head" style="margin-top:16px"><h2><span>◌</span>SOURCE HEALTH</h2></div>
      <ul class="health">
        {d.sources.map((s) => <li><span class={s.ok ? 'glow-g' : 'err'}>{s.ok ? '●' : '○'}</span> {s.name}{!s.ok && <span class="muted"> — {s.error}</span>}</li>)}
      </ul>
    </div>
  </div>
</section>
<style>
  .feed-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  @media (max-width: 900px) { .feed-grid { grid-template-columns: 1fr; } }
  .feed { max-height: 640px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line2) transparent; }
  .item { display: grid; grid-template-columns: 78px 1fr auto; gap: 4px 10px; padding: 8px 4px; border-bottom: 1px dotted rgba(74,63,138,0.5); color: var(--text); align-items: baseline; }
  .item:hover { background: rgba(0,229,255,0.05); text-shadow: none; }
  .item.alert { border-left: 2px solid var(--magenta); padding-left: 8px; }
  .src { padding-top: 3px; }
  .ttl { font-size: 20px; }
  .when { font-size: 16px; white-space: nowrap; }
  .meta { grid-column: 2 / -1; font-size: 15px; }
  .xlist, .health { list-style: none; margin: 0; padding: 0; font-size: 19px; }
  .xlist li, .health li { padding: 4px 0; border-bottom: 1px dotted rgba(74,63,138,0.4); }
  .err { color: var(--red); }
  @media (max-width: 480px) { .item { grid-template-columns: 1fr auto; } .src { grid-column: 1 / -1; } }
</style>
<script>
  const rel = (iso: string) => {
    const s = Math.max(0, (Date.now() - Date.parse(iso)) / 1000);
    if (s < 60) return 'just now';
    if (s < 3600) return `${Math.floor(s / 60)}m ago`;
    if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
    const d = Math.floor(s / 86400); return d === 1 ? '1d ago' : `${d}d ago`;
  };
  const refresh = () => document.querySelectorAll<HTMLElement>('[data-time]').forEach((el) => { el.textContent = rel(el.dataset.time!); });
  setInterval(refresh, 30_000);
  // Full refresh every 5 minutes: the page is edge-cached and cheap to reload.
  setTimeout(() => { if (document.visibilityState === 'visible') location.reload(); else document.addEventListener('visibilitychange', () => location.reload(), { once: true }); }, 300_000);
</script>
