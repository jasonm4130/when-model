---
import type { Dashboard } from '../domain/dashboard';
import type { FeedSource } from '../domain/feed';
import { X_WATCHLIST } from '../domain/lab';
import { ago } from '../ui/format';
interface Props { d: Dashboard }
const { d } = Astro.props;
const now = Date.now();
const labels: Record<FeedSource, string> = { hn: 'HN', openai: 'OPENAI', deepmind: 'DEEPMIND', anthropic: 'ANTHROPIC', github: 'GITHUB', xai: 'XAI' };
const colors: Record<FeedSource, string> = { hn: 'var(--orange)', openai: 'var(--green)', deepmind: 'var(--blue)', anthropic: '#ff7a1a', github: 'var(--muted)', xai: 'var(--fg)' };
const alerts = d.feed.filter((f) => f.alert).length;
---
<section class="section wrap reveal">
  <div class="grid feed-grid">
    <div class="panel">
      <div class="panel-head">
        <h2><span>◍</span>OSINT FEED</h2>
        <div class="pills">
          <span class="pill live">AUTO</span>
          <span class="pill">{d.feed.length} REPORTS · <span class="glow-m">{alerts} ALERTS</span></span>
        </div>
      </div>
      {d.feed.length ? (
        <div class="feed scroll-y" data-feed>
          {d.feed.map((f, i) => (
            <a class={`row item ${f.alert ? 'alert' : ''}`} href={f.url} target="_blank" rel="noopener" style={`--i:${Math.min(i, 12)}`}>
              <span class="src tiny" style={`color:${colors[f.source]}`}>{labels[f.source]}</span>
              <span class="ttl">{f.alert && <span class="glow-m">⚠ </span>}{f.title}</span>
              <span class="when muted" data-time={f.publishedAt}>{ago(f.publishedAt, now)}</span>
              {f.meta && <span class="meta muted">{f.meta}</span>}
            </a>
          ))}
        </div>
      ) : <p class="empty">Every feed is down. That is itself a signal.</p>}
    </div>

    <div class="panel">
      <div class="panel-head"><h2><span>✕</span>X WATCHLIST</h2><span class="pill warn">NO FREE API · CLICK THROUGH</span></div>
      <p class="muted intro">X killed free read access, so we can't ingest the vague-posts. These are the accounts that leak first.</p>
      <ul class="list">
        {X_WATCHLIST.map((a) => (
          <li><a href={`https://x.com/${a.handle}`} target="_blank" rel="noopener">@{a.handle}</a><span class="muted"> — {a.why}</span></li>
        ))}
      </ul>
      <div class="panel-head sub-head"><h2><span>◌</span>SOURCE HEALTH</h2></div>
      <ul class="list health">
        {d.sources.map((s) => <li><span class={s.ok ? 'glow-g dot' : 'err dot'}>{s.ok ? '●' : '○'}</span> {s.name}{!s.ok && <span class="muted"> — {s.error}</span>}</li>)}
      </ul>
    </div>
  </div>
</section>
<style>
  .feed-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  @media (max-width: 900px) { .feed-grid { grid-template-columns: minmax(0, 1fr); } }
  .feed { max-height: 640px; }
  .item { display: grid; grid-template-columns: 78px 1fr auto; gap: 4px 10px; align-items: baseline; animation: rise 500ms var(--ease) both; animation-delay: calc(var(--i) * 40ms); }
  .src { padding-top: 3px; }
  .ttl { font-size: var(--fs-body); }
  .when { font-size: var(--fs-xs); white-space: nowrap; }
  .meta { grid-column: 2 / -1; font-size: 15px; }
  .intro { margin-bottom: 10px; font-size: var(--fs-sm); }
  .list { font-size: 19px; }
  .dot { display: inline-block; width: 1em; }
  @media (max-width: 480px) { .item { grid-template-columns: 1fr auto; } .src { grid-column: 1 / -1; } }
</style>
<script>
  const rel = (iso: string) => {
    const s = Math.max(0, (Date.now() - Date.parse(iso)) / 1000);
    if (s < 60) return 'just now';
    if (s < 3600) return `${Math.floor(s / 60)}m ago`;
    if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
    const d = Math.floor(s / 86400);
    return d === 1 ? '1d ago' : `${d}d ago`;
  };
  const refresh = () =>
    document.querySelectorAll<HTMLElement>('[data-time]').forEach((el) => {
      el.textContent = rel(el.dataset.time!);
    });
  setInterval(refresh, 30_000);
</script>
