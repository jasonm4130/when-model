---
import type { Dashboard } from '../domain/dashboard';
import { X_WATCHLIST } from '../domain/lab';
import { FEED_SOURCE_NAME } from '../domain/sources';
import { MOBILE_FEED, sourcePill } from '../ui/panels';
import FeedRow from './FeedRow.astro';
/** `feed` is the reports alone, `watch` the X watchlist; both by default. */
interface Props { d: Dashboard; now: number; show?: 'all' | 'feed' | 'watch' }
const { d, now, show = 'all' } = Astro.props;
const alerts = d.feed.filter((f) => f.alert).length;
const feedSources = Object.values(FEED_SOURCE_NAME);
const pill = sourcePill(d.sources, feedSources, d.generatedAt, now, 'FEEDS');
const first = d.feed.slice(0, MOBILE_FEED);
const rest = d.feed.slice(MOBILE_FEED);
/** Watchlist accounts shown before the fold. */
const WATCH_SHOWN = 5;
---
<section class={`feed-section show-${show}`} id={show === 'watch' ? 'watchlist' : 'feed'} aria-label={show === 'watch' ? 'X watchlist' : 'Lab blogs, SDK changelogs and Hacker News'}>
  <div class="grid feed-grid">
    {show !== 'watch' && <div class="panel feed-panel">
      <div class="panel-head">
        <h2>The feed</h2>
        <div class="pills">
          <span class={`pill ${pill.tone}`} title={pill.title} data-source-pill data-stale-at={pill.staleAt} data-stale-text={pill.staleText}>{pill.text}</span>
          <span class="pill">{d.feed.length} REPORTS · {alerts} ALERTS</span>
        </div>
      </div>
      {d.feed.length ? (
        <div class="feed" data-feed>
          {first.map((f, i) => <FeedRow f={f} i={i} now={now} />)}
          {rest.length > 0 && (
            <details class="fold">
              <summary class="fold-summary">{rest.length} MORE REPORTS</summary>
              {rest.map((f) => <FeedRow f={f} i={MOBILE_FEED} now={now} />)}
            </details>
          )}
        </div>
      ) : <p class="empty">{pill.state === 'down' ? 'Every feed is down. That is itself a signal.' : 'No reports yet.'}</p>}
    </div>}

    {show !== 'feed' && <div class="panel side">
      <div class="panel-head"><h2>X watchlist</h2><span class="pill">NO FREE API · CLICK THROUGH</span></div>
      <p class="intro">X killed free read access, so we can't ingest the vague-posts. These are the accounts that leak first.</p>
      <ul class="list watch">
        {X_WATCHLIST.slice(0, WATCH_SHOWN).map((a) => (
          <li><a href={`https://x.com/${a.handle}`} target="_blank" rel="noopener">@{a.handle}</a><span class="muted"> — {a.why}</span></li>
        ))}
      </ul>
      {X_WATCHLIST.length > WATCH_SHOWN && (
        <details class="fold">
          <summary class="fold-summary">{X_WATCHLIST.length - WATCH_SHOWN} MORE ACCOUNTS</summary>
          <ul class="list watch">
            {X_WATCHLIST.slice(WATCH_SHOWN).map((a) => (
              <li><a href={`https://x.com/${a.handle}`} target="_blank" rel="noopener">@{a.handle}</a><span class="muted"> — {a.why}</span></li>
            ))}
          </ul>
        </details>
      )}
    </div>}
  </div>
</section>
<style>
  .feed-section { scroll-margin-top: 16px; }
  .feed-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .show-feed .feed-grid, .show-watch .feed-grid { grid-template-columns: minmax(0, 1fr); }
  .feed { border-top: 1px solid var(--ink); }
  .intro { margin-bottom: 14px; font-size: var(--fs-sm); color: var(--ink-2); }
  .list { font-size: var(--fs-sm); line-height: 1.4; }
  .watch { border-top: 1px solid var(--ink); }
  .watch a { text-decoration: none; font-weight: 600; }
  .watch a:hover { text-decoration: underline; }
  /* A long handle breaks anywhere rather than running off a phone's screen. */
  .list li { overflow-wrap: anywhere; }
  @media (max-width: 900px) {
    .feed-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
