---
import type { Dashboard } from '../domain/dashboard';
import { X_WATCHLIST } from '../domain/lab';
import { FEED_SOURCE_NAME } from '../domain/sources';
import { MOBILE_FEED, sourcePill } from '../ui/panels';
import FeedRow from './FeedRow.astro';
interface Props { d: Dashboard }
const { d } = Astro.props;
const now = Date.now();
const alerts = d.feed.filter((f) => f.alert).length;
const feedSources = Object.values(FEED_SOURCE_NAME);
const pill = sourcePill(d.sources, feedSources, d.generatedAt, now, 'FEEDS');
const first = d.feed.slice(0, MOBILE_FEED);
const rest = d.feed.slice(MOBILE_FEED);
---
<section class="section wrap reveal">
  <div class="grid feed-grid">
    <div class="panel feed-panel">
      <div class="panel-head">
        <h2><span aria-hidden="true">◍</span>OSINT FEED</h2>
        <div class="pills">
          <span class={`pill ${pill.tone}`} title={pill.title} data-source-pill data-stale-at={pill.staleAt} data-stale-text={pill.staleText}>{pill.text}</span>
          <span class="pill">{d.feed.length} REPORTS · <span class="glow-m">{alerts} ALERTS</span></span>
        </div>
      </div>
      {d.feed.length ? (
        <div class="feed scroll-y" data-feed>
          {first.map((f, i) => <FeedRow f={f} i={i} now={now} />)}
          {rest.length > 0 && (
            <details class="fold fold-900">
              <summary class="fold-summary tiny">{rest.length} MORE REPORTS</summary>
              {rest.map((f) => <FeedRow f={f} i={MOBILE_FEED} now={now} />)}
            </details>
          )}
        </div>
      ) : <p class="empty">{pill.state === 'down' ? 'Every feed is down. That is itself a signal.' : 'No reports yet.'}</p>}
    </div>

    <div class="panel">
      <div class="panel-head"><h2><span aria-hidden="true">✕</span>X WATCHLIST</h2><span class="pill warn">NO FREE API · CLICK THROUGH</span></div>
      <p class="muted intro">X killed free read access, so we can't ingest the vague-posts. These are the accounts that leak first.</p>
      <ul class="list">
        {X_WATCHLIST.map((a) => (
          <li><a href={`https://x.com/${a.handle}`} target="_blank" rel="noopener">@{a.handle}</a><span class="muted"> — {a.why}</span></li>
        ))}
      </ul>
      <div class="panel-head sub-head"><h2><span aria-hidden="true">◌</span>SOURCE HEALTH</h2></div>
      <ul class="list">
        {d.sources.map((s) => (
          <li><span class={s.ok ? 'glow-g dot' : 'err dot'} aria-hidden="true">{s.ok ? '●' : '○'}</span><span class="sr-only">{s.ok ? 'Up: ' : 'Down: '}</span>{s.name}{!s.ok && <span class="muted"> — {s.error}</span>}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .feed-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .intro { margin-bottom: 10px; font-size: var(--fs-sm); }
  .list { font-size: var(--fs-md); }
  .dot { display: inline-block; width: 1em; }
  /* UI-17: the feed fills its panel, which the grid stretches to the watchlist beside it. */
  @media (min-width: 901px) {
    .feed-panel { display: flex; flex-direction: column; }
    .feed { flex: 1 1 0px; min-height: 640px; }
  }
  /* UI-10: below 900px an inner scroller traps the page's scroll, so the feed shows MOBILE_FEED items and an expander. */
  @media (max-width: 900px) {
    .feed-grid { grid-template-columns: minmax(0, 1fr); }
    .feed { overflow: visible; }
  }
</style>
<script>
  import { ago } from '../ui/format';

  // Relative times and source pills age while the page stays open, and an edge-cached page can be minutes
  // old on arrival, so they are brought up to date at load and every 30 seconds after.
  const refresh = () => {
    const now = Date.now();
    document.querySelectorAll<HTMLElement>('[data-time]').forEach((el) => {
      el.textContent = ago(el.dataset.time!, now);
    });
    document.querySelectorAll<HTMLElement>('[data-source-pill][data-stale-at]').forEach((el) => {
      if (Date.parse(el.dataset.staleAt!) > now) return;
      el.textContent = el.dataset.staleText ?? el.textContent;
      el.classList.remove('live');
      el.classList.add('warn');
      el.removeAttribute('data-stale-at');
    });
  };
  refresh();
  setInterval(refresh, 30_000);
</script>
