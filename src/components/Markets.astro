---
import type { Dashboard } from '../domain/dashboard';
import { displayOutcomes, isPlaceholderOutcome } from '../domain/market';
import { pct, usd } from '../ui/format';
import { outcomeOdds } from '../ui/odds';
interface Props { d: Dashboard }
const { d } = Astro.props;
const releases = d.markets.filter((m) => m.kind === 'release').slice(0, 14);
const boards = d.markets.filter((m) => m.kind === 'leaderboard' && m.slug !== d.bestModelMarket?.slug).slice(0, 10);
const other = d.markets.filter((m) => m.kind === 'other').slice(0, 10);
const best = d.bestModelMarket;
const bestRows = best ? [...best.outcomes].filter((o) => !o.closed && !isPlaceholderOutcome(o)).sort((a, b) => b.yes - a.yes).slice(0, 8) : [];
const oddsColor = (p: number) => (p >= 0.5 ? 'var(--green)' : p >= 0.2 ? 'var(--yellow)' : 'var(--muted)');
---
<section class="section wrap reveal">
  <div class="grid grid-2">
    <div class="panel">
      <div class="panel-head"><h2><span>◔</span>RELEASE MARKETS</h2><a class="pill live" href="https://polymarket.com?utm_source=whenmodel.com" target="_blank" rel="noopener">LIVE ODDS · POLYMARKET</a></div>
      {releases.length ? (
        <div class="mlist">
          {releases.map((m, i) => {
            const lab = d.labs.find((l) => l.id === m.labId);
            return (
              <a class="row" href={m.url} target="_blank" rel="noopener" style={`--lab:${lab?.color ?? 'var(--cyan)'}; --i:${i}`}>
                <div class="mtitle"><span class="mdot"></span>{m.title} <span class="muted vol">{usd(m.vol24)} 24h</span></div>
                <div class="outs">
                  {displayOutcomes(m, 4).map((o) => {
                    const odds = outcomeOdds(o);
                    return odds.thin
                      ? <span class="out"><b class="thin" title="Thin book: bid–ask range, not odds">{odds.text}</b> {o.label}</span>
                      : <span class="out"><b style={`color:${oddsColor(o.yes)}`}>{odds.text}</b> {o.label}</span>;
                  })}
                </div>
              </a>
            );
          })}
        </div>
      ) : <p class="empty">Polymarket unreachable. Odds return when it does.</p>}
    </div>

    <div class="stack">
      <div class="panel">
        <div class="panel-head"><h2><span>◆</span>BEST MODEL RACE</h2>{best && <span class="pill">{usd(best.vol24)} 24H VOL</span>}</div>
        {best ? (
          <>
            <a href={best.url} target="_blank" rel="noopener" class="best-title">{best.title}</a>
            <div class="race">
              {bestRows.map((o, i) => {
                const lab = d.labs.find((l) => l.polymarketCompany === o.label);
                return (
                  <div class="race-row" style={`--lab:${lab?.color ?? 'var(--cyan)'}; --i:${i}`}>
                    <span class="race-name">{o.label}</span>
                    <div class="bar"><i style={`width:${Math.max(1, o.yes * 100)}%`}></i></div>
                    <span class="race-pct num">{pct(o.yes)}</span>
                  </div>
                );
              })}
            </div>
          </>
        ) : <p class="empty">No "best model" market found.</p>}
      </div>

      <div class="panel">
        <div class="panel-head"><h2><span>◈</span>BENCHMARK & OTHER MARKETS</h2></div>
        {boards.length + other.length ? (
          <div class="mlist compact">
            {[...boards, ...other].slice(0, 12).map((m) => (
              <a class="row" href={m.url} target="_blank" rel="noopener">
                <div class="mtitle">{m.title} <span class="muted vol">{usd(m.vol24)}</span></div>
                <div class="outs">{displayOutcomes(m, 3).map((o) => {
                  const odds = outcomeOdds(o);
                  return <span class="out"><b class={odds.thin ? 'thin' : 'glow-c'} title={odds.thin ? 'Thin book: bid–ask range, not odds' : undefined}>{odds.text}</b> {o.label}</span>;
                })}</div>
              </a>
            ))}
          </div>
        ) : <p class="empty">Nothing else on the board.</p>}
      </div>
    </div>
  </div>
</section>
<style>
  .mlist { display: flex; flex-direction: column; }
  .row { --accent: var(--lab, var(--cyan)); }
  .row:hover { border-left-color: var(--accent); }
  .mtitle { font-size: var(--fs-body); display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .mdot { width: 8px; height: 8px; background: var(--lab); box-shadow: 0 0 8px var(--lab); display: inline-block; flex: none; align-self: center; }
  .vol { font-size: 15px; margin-left: auto; }
  .outs { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 3px; font-size: 17px; color: var(--muted); }
  .out b { font-weight: 400; }
  .out b.thin { color: var(--muted); }
  .compact .mtitle { font-size: var(--fs-sm); }
  .best-title { display: block; font-size: var(--fs-body); margin-bottom: 10px; color: var(--yellow); }
  .race-row { display: grid; grid-template-columns: 130px 1fr 56px; gap: 10px; align-items: center; padding: 4px 0; }
  .race-row .bar > i { background: var(--lab); box-shadow: 0 0 10px var(--lab); animation-delay: calc(var(--i) * 80ms); }
  .race-name { font-size: var(--fs-sm); color: var(--lab); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .race-pct { font-size: var(--fs-body); }
  @media (max-width: 480px) { .race-row { grid-template-columns: 90px 1fr 50px; } }
</style>
