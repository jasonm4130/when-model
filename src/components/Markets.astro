---
import type { Dashboard } from '../domain/dashboard';
import { SOURCE } from '../domain/sources';
import { pct, usd } from '../ui/format';
import { MOBILE_MARKETS, PANEL_ROWS, otherRows, raceRows, releaseRows, sourceOk, sourcePill } from '../ui/panels';
import MarketRow from './MarketRow.astro';
interface Props { d: Dashboard }
const { d } = Astro.props;
const releases = releaseRows(d);
const others = otherRows(d);
const best = d.bestModelMarket;
const bestRows = raceRows(d);
const up = sourceOk(d.sources, SOURCE.polymarket);
const pill = sourcePill(d.sources, [SOURCE.polymarket], d.generatedAt, Date.now());
const down = 'Polymarket unreachable. Odds return when it does.';
const labColor = (id?: string) => d.labs.find((l) => l.id === id)?.color;
---
<section class="section wrap reveal">
  <div class="grid grid-2">
    <div class="panel">
      <div class="panel-head">
        <h2><span aria-hidden="true">◔</span>RELEASE MARKETS</h2>
        <a class={`pill ${pill.tone}`} href="https://polymarket.com?utm_source=whenmodel.com" target="_blank" rel="noopener" title={pill.title} data-source-pill data-stale-at={pill.staleAt} data-stale-text={pill.staleText}>{pill.text}</a>
      </div>
      {releases.length ? (
        <div class="mlist">
          {releases.slice(0, MOBILE_MARKETS).map((m, i) => <MarketRow m={m} limit={PANEL_ROWS.releaseOutcomes} color={labColor(m.labId)} i={i} />)}
          {releases.length > MOBILE_MARKETS && (
            <details class="fold fold-480">
              <summary class="fold-summary tiny">{releases.length - MOBILE_MARKETS} MORE RELEASE MARKETS</summary>
              {releases.slice(MOBILE_MARKETS).map((m, i) => <MarketRow m={m} limit={PANEL_ROWS.releaseOutcomes} color={labColor(m.labId)} i={i + MOBILE_MARKETS} />)}
            </details>
          )}
        </div>
      ) : <p class="empty">{up ? 'No open release market right now.' : down}</p>}
    </div>

    <div class="stack">
      <div class="panel">
        <div class="panel-head"><h2><span aria-hidden="true">◆</span>BEST MODEL RACE</h2>{best && <span class="pill">{usd(best.vol24)} 24H VOL</span>}</div>
        {best ? (
          <>
            <a href={best.url} target="_blank" rel="noopener" class="best-title">{best.title}</a>
            <div class="race">
              {bestRows.map((o, i) => {
                const lab = d.labs.find((l) => l.polymarketCompany === o.label);
                return (
                  <div class="race-row" style={`--lab:${lab?.color ?? 'var(--cyan)'}; --i:${i}`}>
                    <span class="race-name">{o.label}</span>
                    <div class="bar"><i style={`width:${Math.max(1, o.yes * 100)}%`}></i></div>
                    <span class="race-pct num">{pct(o.yes)}</span>
                  </div>
                );
              })}
            </div>
          </>
        ) : <p class="empty">{up ? 'No "best model" market found.' : down}</p>}
      </div>

      <div class="panel">
        <div class="panel-head"><h2><span aria-hidden="true">◈</span>BENCHMARK & OTHER MARKETS</h2></div>
        {others.length ? (
          <div class="mlist">
            {others.slice(0, MOBILE_MARKETS).map((m) => <MarketRow m={m} limit={PANEL_ROWS.otherOutcomes} compact />)}
            {others.length > MOBILE_MARKETS && (
              <details class="fold fold-480">
                <summary class="fold-summary tiny">{others.length - MOBILE_MARKETS} MORE MARKETS</summary>
                {others.slice(MOBILE_MARKETS).map((m) => <MarketRow m={m} limit={PANEL_ROWS.otherOutcomes} compact />)}
              </details>
            )}
          </div>
        ) : <p class="empty">{up ? 'Nothing else on the board.' : down}</p>}
      </div>
    </div>
  </div>
</section>
<style>
  .mlist { display: flex; flex-direction: column; }
  .best-title { display: block; font-size: var(--fs-body); margin-bottom: 10px; color: var(--yellow); }
  .race-row { display: grid; grid-template-columns: 130px 1fr 56px; gap: 10px; align-items: center; padding: 4px 0; }
  .race-row .bar > i { background: var(--lab); box-shadow: 0 0 10px var(--lab); animation-delay: calc(var(--i) * 80ms); }
  .race-name { font-size: var(--fs-sm); color: var(--lab); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .race-pct { font-size: var(--fs-body); }
  @media (max-width: 480px) { .race-row { grid-template-columns: 90px 1fr 50px; } }
</style>
