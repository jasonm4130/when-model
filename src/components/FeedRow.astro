---
import type { FeedItem } from '../domain/feed';
import { ago } from '../ui/format';
import { FEED_LABELS } from '../ui/panels';
interface Props {
  f: FeedItem;
  /** Entrance stagger slot. */
  i: number;
  now: number;
}
const { f, i, now } = Astro.props;
---
<a class={`row item ${f.alert ? 'alert' : ''}`} href={f.url} target="_blank" rel="noopener" data-i={Math.min(i, 12)}>
  <span class="ttl">{f.alert && <><span class="flag" aria-hidden="true">Alert</span><span class="sr-only">Alert: </span></>}{f.title}</span>
  <span class="when mono" data-time={f.publishedAt}>{ago(f.publishedAt, now)}</span>
  <span class="meta mono"><span class="src">{FEED_LABELS[f.source]}</span>{f.meta && <> · {f.meta}</>}</span>
</a>
<style>
  .item { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'ttl when' 'meta meta'; gap: 2px var(--s4); align-items: baseline; padding: var(--s3) 0; }
  .ttl { grid-area: ttl; font-size: var(--t-base); line-height: 24px; overflow-wrap: anywhere; }
  .item:hover .ttl { text-decoration: underline; text-underline-offset: 3px; }
  .alert .ttl { font-weight: 600; }
  .flag { display: inline-block; margin-right: var(--s2); padding: 0 6px; font-size: var(--t-xs); line-height: 18px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; vertical-align: 1px; color: var(--ink); background: var(--notice); }
  .when { grid-area: when; font-size: var(--t-xs); line-height: 24px; white-space: nowrap; color: var(--ink-2); }
  /* One line, clipped: a symbol the mono face lacks (▲) falls back to a taller font and would open the row. */
  .meta { grid-area: meta; height: 18px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: var(--t-xs); line-height: 16px; letter-spacing: 0.02em; color: var(--ink-2); }
  .src { text-transform: uppercase; }
</style>
