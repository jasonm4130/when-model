---
import type { FeedItem } from '../domain/feed';
import { ago } from '../ui/format';
import { FEED_LABELS } from '../ui/panels';
interface Props {
  f: FeedItem;
  /** Entrance stagger slot. */
  i: number;
  now: number;
}
const { f, i, now } = Astro.props;
---
<a class={`row item ${f.alert ? 'alert' : ''}`} href={f.url} target="_blank" rel="noopener" style={`--i:${Math.min(i, 12)}`}>
  <span class="src tiny">{FEED_LABELS[f.source]}</span>
  <span class="ttl">{f.alert && <><span class="flag" aria-hidden="true">Alert</span><span class="sr-only">Alert: </span></>}{f.title}</span>
  <span class="when" data-time={f.publishedAt}>{ago(f.publishedAt, now)}</span>
  {f.meta && <span class="meta">{f.meta}</span>}
</a>
<style>
  .item { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; gap: 2px 16px; align-items: baseline; padding: 14px 0; }
  .src { color: var(--ink-2); }
  .ttl { font-size: var(--fs-lg); line-height: 1.3; overflow-wrap: anywhere; transition: color var(--fast) var(--ease); }
  .alert .ttl { font-weight: 650; }
  .flag { display: inline-block; margin-right: 8px; padding: 1px 5px; font-family: var(--font-label); font-size: var(--fs-pill); font-weight: 700; font-stretch: 112.5%; letter-spacing: 0.08em; text-transform: uppercase; vertical-align: 0.2em; color: var(--paper); background: var(--accent-ink); }
  .when { font-size: var(--fs-xs); white-space: nowrap; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .meta { grid-column: 2 / -1; font-size: var(--fs-xs); color: var(--ink-2); }
  @media (prefers-reduced-motion: no-preference) {
    .item { animation: rise 500ms var(--ease) both; animation-delay: calc(var(--i) * 30ms); }
  }
  /* Phones: the title and its age first, then the source beside the meta. */
  @media (max-width: 480px) {
    .item { grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'ttl ttl when' 'src meta meta'; column-gap: 10px; }
    .ttl { grid-area: ttl; font-size: var(--fs-md); }
    .when { grid-area: when; }
    .src { grid-area: src; }
    .meta { grid-area: meta; }
  }
</style>
