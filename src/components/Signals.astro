---
import type { Dashboard } from '../domain/dashboard';
import { LABS } from '../domain/lab';
import { ago } from '../ui/format';
import { sourcePill } from '../ui/panels';
import { SOURCE } from '../domain/sources';
import { EARLY_WARNING_SOURCES, LANDED_LAB_FEEDS, LANDED_SOURCES, TRACK_LINES, daysShort, hoursAgo } from '../ui/signals';
interface Props { d: Dashboard; now?: number }
const { d, now = Date.now() } = Astro.props;
const w = d.earlyWarnings;
const l = d.landed;
const labName = (id?: string) => LABS.find((x) => x.id === id)?.short ?? id ?? '';
const LIMIT = 5;
/** Rows each list shows before its "more" fold. */
const SHOW = 3;
// The same pill every panel wears: LIVE, PARTIAL or DOWN from these sources, STALE once the data ages.
const ewPill = sourcePill(d.sources, EARLY_WARNING_SOURCES, d.generatedAt, now, 'SOURCES');
const landedPill = sourcePill(d.sources, LANDED_SOURCES, d.generatedAt, now, 'SOURCES');
const leaksDown = w.leaks.sources.filter((s) => !s.ok).length > 0;
const openrouterDown = !w.stealth.ok;
const labFeeds: readonly string[] = LANDED_LAB_FEEDS;
const labFeedsDown = d.sources.filter((s) => labFeeds.includes(s.name) && !s.ok).length;
const allLeaksDown = w.leaks.sources.length > 0 && w.leaks.sources.every((s) => !s.ok);
const hnDown = d.sources.some((s) => s.name === SOURCE.hnLaunches && !s.ok);
const streamWhen = (h: number | undefined) => (h === undefined ? 'no start time' : h >= 0 ? `in ${Math.round(h)}h` : 'started');
const stealthItems = w.stealth.items.slice(0, LIMIT);
const leakItems = w.leaks.items.slice(0, LIMIT);
const streamItems = w.broadcasts.items.slice(0, LIMIT);
const archItems = w.architectures.items.slice(0, LIMIT);
const announceItems = l.announcements.slice(0, LIMIT);
const storyItems = l.stories.slice(0, LIMIT);
const more = (n: number) => `${n} more`;
---
<section class="signals" aria-label="Early warnings and landed launches">
  <div class="cols">
    <div class="panel sig-panel">
      <div class="panel-head">
        <h2>Early warnings</h2>
        <div class="pills">
          <span class={`pill ${ewPill.tone}`} title={ewPill.title} data-source-pill data-stale-at={ewPill.staleAt} data-stale-text={ewPill.staleText}>{ewPill.text}</span>
        </div>
      </div>

      <div class="sig" id="ew-stealth">
        <h3 class="sig-head">Unmarked trains <span class="count">{openrouterDown ? 'OPENROUTER DOWN' : w.stealth.items.length}</span></h3>
        <p class="track" title={w.stealth.track.summary}><span class="label">Track</span> {TRACK_LINES.stealth}</p>
        {stealthItems.slice(0, SHOW).map((s) => (
          <a class="sig-row" href={s.url ?? `https://openrouter.ai/${s.id}`} target="_blank" rel="noopener">
            <span class="sig-main">{s.name}</span>
            <span class="sig-when">{daysShort(s.daysInStealth)} in stealth</span>
            <span class="sig-meta">OpenRouter · lab unknown{s.claimsFrontier ? ' · claims frontier' : ''}</span>
          </a>
        ))}
        {stealthItems.length > SHOW && (
          <details class="fold sig-fold">
            <summary class="fold-summary">{more(stealthItems.length - SHOW)}</summary>
            {stealthItems.slice(SHOW).map((s) => (
              <a class="sig-row" href={s.url ?? `https://openrouter.ai/${s.id}`} target="_blank" rel="noopener">
                <span class="sig-main">{s.name}</span>
                <span class="sig-when">{daysShort(s.daysInStealth)} in stealth</span>
                <span class="sig-meta">OpenRouter · lab unknown{s.claimsFrontier ? ' · claims frontier' : ''}</span>
              </a>
            ))}
          </details>
        )}
        {w.stealth.items.length === 0 && <p class="sig-empty">{openrouterDown ? 'OpenRouter is unreachable, so stealth slots are unknown right now.' : 'No anonymous slots on OpenRouter right now.'}</p>}
      </div>

      <div class="sig" id="ew-leaks">
        <h3 class="sig-head">Leaks <span class="count">{w.leaks.items.length}{leaksDown ? ' · SOURCE DOWN' : ''}</span></h3>
        <p class="track" title={w.leaks.track.summary}><span class="label">Track</span> {TRACK_LINES.leaks}</p>
        {!w.leaks.checkedAgainstListings && <p class="sig-note">OpenRouter is down, so models that already listed were not filtered out.</p>}
        {leakItems.slice(0, SHOW).map((x) => (
          <a class="sig-row" href={x.url} target="_blank" rel="noopener">
            <span class="sig-main">{x.title}</span>
            <span class="sig-when" data-time={x.publishedAt}>{ago(x.publishedAt, now)}</span>
            <span class="sig-meta">{x.sourceName}{x.labId ? ` · ${labName(x.labId)}` : ''}</span>
          </a>
        ))}
        {leakItems.length > SHOW && (
          <details class="fold sig-fold">
            <summary class="fold-summary">{more(leakItems.length - SHOW)}</summary>
            {leakItems.slice(SHOW).map((x) => (
              <a class="sig-row" href={x.url} target="_blank" rel="noopener">
                <span class="sig-main">{x.title}</span>
                <span class="sig-when" data-time={x.publishedAt}>{ago(x.publishedAt, now)}</span>
                <span class="sig-meta">{x.sourceName}{x.labId ? ` · ${labName(x.labId)}` : ''}</span>
              </a>
            ))}
          </details>
        )}
        {w.leaks.items.length === 0 && <p class="sig-empty">{allLeaksDown ? 'Both leak sources are unreachable right now.' : 'No unlisted leaks in the last two weeks.'}</p>}
      </div>

      <div class="sig" id="ew-streams">
        <h3 class="sig-head">Scheduled streams <span class="count">{w.broadcasts.items.length}{w.broadcasts.ok ? '' : ' · FEED DOWN'}</span></h3>
        <p class="track" title={w.broadcasts.track.summary}><span class="label">Track</span> {TRACK_LINES.broadcasts}</p>
        {streamItems.slice(0, SHOW).map((b) => (
          <a class="sig-row" href={b.url} target="_blank" rel="noopener">
            <span class="sig-main">{b.title}</span>
            <span class="sig-when">{streamWhen(b.startsInHours)}</span>
            <span class="sig-meta">{b.channel} on YouTube{b.confirmed === false ? ' · first poll' : ''}</span>
          </a>
        ))}
        {streamItems.length > SHOW && (
          <details class="fold sig-fold">
            <summary class="fold-summary">{more(streamItems.length - SHOW)}</summary>
            {streamItems.slice(SHOW).map((b) => (
              <a class="sig-row" href={b.url} target="_blank" rel="noopener">
                <span class="sig-main">{b.title}</span>
                <span class="sig-when">{streamWhen(b.startsInHours)}</span>
                <span class="sig-meta">{b.channel} on YouTube{b.confirmed === false ? ' · first poll' : ''}</span>
              </a>
            ))}
          </details>
        )}
        {w.broadcasts.items.length === 0 && <p class="sig-empty">{w.broadcasts.ok ? 'No upcoming streams on the watched lab channels.' : 'The lab YouTube feeds did not all answer; no stream found in those that did.'}</p>}
      </div>

      <div class="sig" id="ew-arch">
        <h3 class="sig-head">Pending architectures <span class="count">{w.architectures.ok ? w.architectures.items.length : 'REGISTRY DOWN'}</span></h3>
        <p class="track" title={w.architectures.track.summary}><span class="label">Track</span> {TRACK_LINES.architectures}</p>
        {!w.architectures.checkedAgainstListings && <p class="sig-note">OpenRouter is down, so shipped architectures were not cleared.</p>}
        {archItems.slice(0, SHOW).map((a) => (
          <div class="sig-row">
            <span class="sig-main">{a.module}</span>
            <span class="sig-when">{daysShort(a.daysPending)} pending</span>
            <span class="sig-meta">transformers · {labName(a.labId)}{a.frontier ? ' · frontier lab' : ''}</span>
          </div>
        ))}
        {archItems.length > SHOW && (
          <details class="fold sig-fold">
            <summary class="fold-summary">{more(archItems.length - SHOW)}</summary>
            {archItems.slice(SHOW).map((a) => (
              <div class="sig-row">
                <span class="sig-main">{a.module}</span>
                <span class="sig-when">{daysShort(a.daysPending)} pending</span>
                <span class="sig-meta">transformers · {labName(a.labId)}{a.frontier ? ' · frontier lab' : ''}</span>
              </div>
            ))}
          </details>
        )}
        {w.architectures.items.length === 0 && <p class="sig-empty">{w.architectures.ok ? 'No merged model architecture is waiting on a listing.' : 'The transformers registry is unreachable right now.'}</p>}
      </div>

      {w.events.items.length > 0 && (
        <div class="sig" id="ew-events">
          <h3 class="sig-head">Keynote windows <span class="count">{w.events.items.length}</span></h3>
          <p class="track" title={w.events.track.summary}><span class="label">Track</span> {TRACK_LINES.events}</p>
          {w.events.items.map((e) => (
            <a class="sig-row" href={e.source} target="_blank" rel="noopener">
              <span class="sig-main">{e.label}</span>
              <span class="sig-when">{e.hoursToStart >= 0 ? `in ${Math.round(e.hoursToStart)}h` : 'under way'}</span>
              <span class="sig-meta">{labName(e.labId)} · markets already price known keynotes</span>
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="panel sig-panel" id="landed">
      <div class="panel-head">
        <h2>Recent arrivals</h2>
        <div class="pills">
          <span class={`pill ${landedPill.tone}`} title={landedPill.title} data-source-pill data-stale-at={landedPill.staleAt} data-stale-text={landedPill.staleText}>{landedPill.text}</span>
        </div>
      </div>
      <p class="sig-intro">{l.summary}. Launches that already happened are listed, never scored.</p>

      <div class="sig">
        <h3 class="sig-head">Listed on OpenRouter · 7 days <span class="count">{openrouterDown ? 'OPENROUTER DOWN' : l.releases.length}</span></h3>
        {l.releases.slice(0, SHOW).map((r) => (
          <a class="sig-row" href={r.models[0]?.url ?? 'https://openrouter.ai/models'} target="_blank" rel="noopener">
            <span class="sig-main landed-name">{r.name}</span>
            <span class="sig-when">listed {hoursAgo(r.hoursAgo)}</span>
            <span class="sig-meta">{r.lab}</span>
          </a>
        ))}
        {l.releases.length > SHOW && (
          <details class="fold sig-fold">
            <summary class="fold-summary">{more(l.releases.length - SHOW)}</summary>
            {l.releases.slice(SHOW).map((r) => (
              <a class="sig-row" href={r.models[0]?.url ?? 'https://openrouter.ai/models'} target="_blank" rel="noopener">
                <span class="sig-main landed-name">{r.name}</span>
                <span class="sig-when">listed {hoursAgo(r.hoursAgo)}</span>
                <span class="sig-meta">{r.lab}</span>
              </a>
            ))}
          </details>
        )}
        {l.releases.length === 0 && <p class="sig-empty">{openrouterDown ? 'OpenRouter is unreachable, so this week’s listings are unknown.' : 'No frontier launch listed on OpenRouter in the last 7 days.'}</p>}
      </div>

      <div class="sig">
        <h3 class="sig-head">Lab announcements <span class="count">{l.announcements.length}{labFeedsDown ? ` · ${labFeedsDown} FEED${labFeedsDown === 1 ? '' : 'S'} DOWN` : ''}</span></h3>
        {announceItems.slice(0, SHOW).map((a) => (
          <a class="sig-row" href={a.url} target="_blank" rel="noopener">
            <span class="sig-main">{a.title}</span>
            <span class="sig-when" data-time={a.seenAt}>{ago(a.seenAt, now)}</span>
            <span class="sig-meta">{a.source.toUpperCase()}{a.precision === 'day' ? ' · dated by day' : ''}</span>
          </a>
        ))}
        {announceItems.length > SHOW && (
          <details class="fold sig-fold">
            <summary class="fold-summary">{more(announceItems.length - SHOW)}</summary>
            {announceItems.slice(SHOW).map((a) => (
              <a class="sig-row" href={a.url} target="_blank" rel="noopener">
                <span class="sig-main">{a.title}</span>
                <span class="sig-when" data-time={a.seenAt}>{ago(a.seenAt, now)}</span>
                <span class="sig-meta">{a.source.toUpperCase()}{a.precision === 'day' ? ' · dated by day' : ''}</span>
              </a>
            ))}
          </details>
        )}
        {l.announcements.length === 0 && <p class="sig-empty">No launch posts on the labs’ own feeds in the last 7 days.</p>}
      </div>

      <div class="sig">
        <h3 class="sig-head">Hacker News launch stories <span class="count">{hnDown ? 'HN DOWN' : l.stories.length}</span></h3>
        {storyItems.slice(0, SHOW).map((s) => (
          <a class="sig-row" href={s.url} target="_blank" rel="noopener">
            <span class="sig-main">{s.title}</span>
            <span class="sig-when">{s.score} pts</span>
            <span class="sig-meta">Hacker News</span>
          </a>
        ))}
        {storyItems.length > SHOW && (
          <details class="fold sig-fold">
            <summary class="fold-summary">{more(storyItems.length - SHOW)}</summary>
            {storyItems.slice(SHOW).map((s) => (
              <a class="sig-row" href={s.url} target="_blank" rel="noopener">
                <span class="sig-main">{s.title}</span>
                <span class="sig-when">{s.score} pts</span>
                <span class="sig-meta">Hacker News</span>
              </a>
            ))}
          </details>
        )}
        {l.stories.length === 0 && <p class="sig-empty">{hnDown ? 'Hacker News is unreachable right now.' : 'No release story over the points bar this week.'}</p>}
      </div>
    </div>
  </div>
</section>
<style>
  .sig-intro { max-width: 56ch; margin-top: var(--s3); font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .sig { scroll-margin-top: 16px; margin-top: var(--s6); }
  #landed { scroll-margin-top: 16px; }
  /* Each notice names itself, then its count, then its track record in one quiet line. */
  .sig-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s1) var(--s3); font-size: var(--t-md); line-height: 28px; font-weight: 700; letter-spacing: -0.01em; }
  .sig-head .count { font-family: var(--mono); font-size: var(--t-sm); line-height: 20px; font-weight: 500; letter-spacing: 0; color: var(--ink-2); }
  .track { max-width: 64ch; margin: var(--s1) 0 var(--s2); font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .track .label { margin-right: var(--s2); color: var(--ink); }
  .sig-note, .sig-empty { padding: var(--s2) 0 var(--s2) var(--s3); border-left: 2px solid var(--rule-soft); font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .sig-empty { margin-top: var(--s1); }
  /* One layout for every row: what, then when (never wrapped), then where from. */
  .sig-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'main when' 'meta when'; column-gap: var(--s4); row-gap: 2px; padding: var(--s3) 0; border-bottom: 1px solid var(--rule-soft); color: var(--ink); text-decoration: none; font-size: var(--t-base); line-height: 24px; }
  .sig-row:first-of-type { border-top: 1px solid var(--rule-soft); }
  a.sig-row:hover { text-decoration: none; }
  a.sig-row:hover .sig-main { text-decoration: underline; text-underline-offset: 3px; }
  a.sig-row:focus-visible { outline-offset: -2px; }
  .sig-main { grid-area: main; overflow-wrap: anywhere; }
  .landed-name { font-weight: 600; }
  .sig-meta { grid-area: meta; font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .sig-when { grid-area: when; align-self: start; font-family: var(--mono); font-size: var(--t-xs); line-height: 24px; white-space: nowrap; text-align: right; color: var(--ink-2); }
</style>
