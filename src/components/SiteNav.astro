---
/**
 * The site's tabs. The current page's tab is underlined, set heavier, and carries aria-current; a
 * line's own page marks Lines as its section (aria-current="true"). One row from 390px; narrower,
 * the six tabs sit in a 3 × 2 block, never wider than the page.
 */
import { NAV, navKey, type SiteView } from '../ui/site';
interface Props { view: SiteView }
const { view } = Astro.props;
const current = navKey(view);
const exact = view.page !== 'lab';
---
<nav class="site-nav" aria-label="Site">
  <ul class="tabs">
    {NAV.map((item) => {
      const on = item.key === current;
      return (
        <li>
          <a class:list={['tab', { on }]} href={item.href} aria-current={on ? (exact ? 'page' : 'true') : undefined}>{item.label}</a>
        </li>
      );
    })}
  </ul>
</nav>
<style>
  .site-nav { min-width: 0; }
  .tabs { display: flex; flex-wrap: wrap; gap: 0 var(--s5); }
  .tab { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--t-sm); line-height: 20px; font-weight: 500; color: var(--ink); white-space: nowrap; }
  .tab:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .tab.on { font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .tab:focus-visible { outline-offset: 0; }
  @media (max-width: 900px) {
    .tabs { justify-content: space-between; gap: 0 var(--s3); }
  }
  @media (max-width: 480px) {
    .tab { font-size: 13px; }
  }
  /* The narrowest phones: two rows of three, each tab a full 44px target. */
  @media (max-width: 389.98px) {
    .tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--s3); }
    .tab { justify-self: start; }
  }
</style>
