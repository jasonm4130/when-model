---
import type { Backtest } from '../../scripts/backtest/build';
import { pct } from '../../scripts/backtest/view';

/**
 * Wave 1's check of Polymarket on its own questions: each rung's price h hours before its deadline
 * against how that rung resolved. Still valid under v3, which asks a different question (any
 * frontier launch), so the page keeps it beside the v3 results and labels it.
 */
interface Props {
  rungCalibration: Backtest['markets']['rungCalibration'];
}
const { rungCalibration } = Astro.props;
const beats = rungCalibration.every((r) => r.market.skill > 0);
const signed = (n: number) => (n > 0 ? `+${n.toFixed(3)}` : n < 0 ? `−${Math.abs(n).toFixed(3)}` : '0');
---
<div class="table-scroll">
  <table>
    <caption class="sr-only">Polymarket's own calibration: each rung's price a fixed time before its deadline against how the rung resolved.</caption>
    <thead>
      <tr>
        <th scope="col">Priced before deadline</th>
        <th scope="col" class="num">Skill</th>
        <th scope="col" class="num">Brier</th>
        <th scope="col" class="num">Rungs</th>
        <th scope="col" class="num">Resolved Yes</th>
      </tr>
    </thead>
    <tbody>
      {rungCalibration.map((r) => (
        <tr>
          <th scope="row">{r.horizonH}h</th>
          <td class={`num ${r.market.skill > 0 ? 'good' : r.market.skill < 0 ? 'bad' : ''}`}>{signed(r.market.skill)}</td>
          <td class="num">{r.market.brier.toFixed(4)}</td>
          <td class="num">{r.rungs}</td>
          <td class="num">{pct(r.yesRate)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="muted note">
  Skill against always forecasting that horizon's Yes rate, over every frontier-lab rung in the wave-1 pull. On their own questions the markets {beats ? 'beat' : 'do not all beat'} their base rate. The trouble is the question: a rung asks whether one named model ships by a date, so it sits near zero while other frontier models list, and it moves after leaks rather than ahead of them.
</p>
<style>
  .good { color: var(--green); }
  .bad { color: var(--red); }
  .note { margin-top: 8px; font-size: var(--fs-xs); max-width: 95ch; }
</style>
