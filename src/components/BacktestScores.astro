---
import type { Backtest, HorizonScore } from '../../scripts/backtest/build';
import { labById, type LabId } from '../domain/lab';
import { pct } from '../../scripts/backtest/view';
import BacktestReliability from './BacktestReliability.astro';

interface Props {
  calibration: readonly HorizonScore[];
  rungCalibration: Backtest['markets']['rungCalibration'];
}
const { calibration, rungCalibration } = Astro.props;
const forecasts = calibration[0]?.scores.map((s) => s.forecast) ?? [];
const score = (h: HorizonScore, name: string) => h.scores.find((s) => s.forecast === name);
const labs = calibration[0]?.byLab.map((l) => l.labId) ?? [];
const labRow = (labId: LabId) => calibration.map((h) => h.byLab.find((l) => l.labId === labId));
const signed = (n: number | undefined) => (n === undefined ? '—' : n > 0 ? `+${n.toFixed(3)}` : n < 0 ? `−${Math.abs(n).toFixed(3)}` : '0');
const misses = calibration
  .filter((h) => h.coverage)
  .map((h) => `under 10% in ${h.coverage.listedUnder10} of ${h.coverage.listedHours} at ${h.horizonH}h (${pct(h.coverage.listedUnder10 / Math.max(h.coverage.listedHours, 1))}), ${h.coverage.listedNoOdds} of them with no rung due at all`)
  .join('; ');
---
<div class="table-scroll">
  <table>
    <caption class="sr-only">Brier score and skill against the base rate for "a frontier lab lists a model on OpenRouter within the window".</caption>
    <thead>
      <tr>
        <th scope="col">Forecast</th>
        {calibration.map((h) => (
          <>
            <th scope="col" class="num">Brier {h.horizonH}h</th>
            <th scope="col" class="num">Skill {h.horizonH}h</th>
          </>
        ))}
      </tr>
    </thead>
    <tbody>
      {forecasts.map((name) => (
        <tr>
          <th scope="row">{name}</th>
          {calibration.map((h) => (
            <>
              <td class="num">{score(h, name)?.brier.toFixed(4)}</td>
              <td class={`num ${(score(h, name)?.skill ?? 0) > 0 ? 'good' : (score(h, name)?.skill ?? 0) < 0 ? 'bad' : ''}`}>{signed(score(h, name)?.skill)}</td>
            </>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="muted note">
  Base rates: {calibration.map((h) => `${pct(h.baseRate)} within ${h.horizonH}h (${h.samples} hours)`).join(', ')}. Skill is 1 − Brier ÷ Brier of always forecasting the base rate; above zero beats it. The raw market maximum loses to the base rate because each rung prices one named model, while the outcome counts any new listing from a frontier lab. In the hours when a listing did land, the market read {misses}. Taking the larger of the market price and the base rate edges ahead of it.
</p>

<BacktestReliability horizons={calibration} />

<h3 class="tiny sub">Skill by lab (market max vs that lab's own base rate)</h3>
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th scope="col">Lab</th>
        {calibration.map((h) => (
          <>
            <th scope="col" class="num">Base {h.horizonH}h</th>
            <th scope="col" class="num">Skill {h.horizonH}h</th>
            <th scope="col" class="num">Hours with odds, {h.horizonH}h</th>
          </>
        ))}
      </tr>
    </thead>
    <tbody>
      {labs.map((labId) => (
        <tr>
          <th scope="row">{labById(labId)?.name ?? labId}</th>
          {labRow(labId).map((l) => (
            <>
              <td class="num">{pct(l?.baseRate)}</td>
              <td class={`num ${(l?.market.skill ?? 0) > 0 ? 'good' : (l?.market.skill ?? 0) < 0 ? 'bad' : ''}`}>{signed(l?.market.skill)}</td>
              <td class="num">{l?.hoursWithOdds ?? 0}</td>
            </>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<h3 class="tiny sub">Polymarket's own calibration (price h hours before each rung's deadline vs how that rung resolved)</h3>
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th scope="col">Horizon</th>
        <th scope="col" class="num">Rungs</th>
        <th scope="col" class="num">Resolved Yes</th>
        <th scope="col" class="num">Brier</th>
        <th scope="col" class="num">Skill</th>
      </tr>
    </thead>
    <tbody>
      {rungCalibration.map((r) => (
        <tr>
          <th scope="row">{r.horizonH}h</th>
          <td class="num">{r.rungs}</td>
          <td class="num">{pct(r.yesRate)}</td>
          <td class="num">{r.market.brier.toFixed(4)}</td>
          <td class={`num ${r.market.skill > 0 ? 'good' : r.market.skill < 0 ? 'bad' : ''}`}>{signed(r.market.skill)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="muted note">
  On their own questions the markets beat their own base rate. The trouble is the question: a rung asks whether one named model ships by a date, so it sits near zero while other frontier models list, and its price moves after leaks, not before them.
</p>
<style>
  .note { margin-top: 8px; font-size: var(--fs-xs); max-width: 90ch; }
  .sub { color: var(--muted); margin: 18px 0 8px; }
  .good::before { content: '\25B2 '; color: var(--muted); font-size: 12px; }
  .bad::before { content: '\25BC '; color: var(--muted); font-size: 12px; }
</style>
