---
import type { Dashboard } from '../domain/dashboard';
import { pct } from '../ui/format';
interface Props { d: Dashboard }
const { d } = Astro.props;
const okCount = d.sources.filter((s) => s.ok).length;
const status = okCount === d.sources.length ? 'OPERATIONAL' : okCount > d.sources.length / 2 ? 'DEGRADED' : 'IMPAIRED';
const statusClass = status === 'OPERATIONAL' ? 'glow-g' : status === 'DEGRADED' ? 'glow-y' : 'err';
const ticker = [
  ...d.labs.filter((l) => l.weekOdds).map((l) => `${l.name.toUpperCase()}: ${pct(l.weekOdds!.p)} ODDS OF A DROP BY ${l.weekOdds!.label.toUpperCase()}`),
  ...d.drops.slice(0, 6).map((x) => `NEW ON OPENROUTER: ${x.name.toUpperCase()} (${x.lab.toUpperCase()})`),
  ...d.feed.filter((f) => f.alert).slice(0, 6).map((f) => `${f.source.toUpperCase()}: ${f.title.toUpperCase()}`),
];
/** The page reloads itself on this cadence; the statusbar counts it down. */
const REFRESH_SECONDS = 300;
---
<header class="hero">
  <div class="statusbar wrap">
    <div class="left">
      <span class={`tiny status-live ${statusClass}`}>STATUS: {status}</span>
      <span class="tiny muted">{d.labs.length} LABS · {okCount}/{d.sources.length} SOURCES · {d.markets.length} MARKETS</span>
    </div>
    <div class="right">
      <span class="tiny muted">SYNC <span data-synced={d.generatedAt}>{d.generatedAt.slice(11, 19)}Z</span> · NEXT <span class="glow-y" data-refresh={REFRESH_SECONDS}>{`${Math.floor(REFRESH_SECONDS / 60)}:00`}</span></span>
      <span class="tiny muted">UTC</span> <span class="clock glow-c" data-clock>{d.generatedAt.slice(11, 19)}Z</span>
    </div>
  </div>
  <div class="wrap hero-inner">
    <div class="title-block">
      <div class="tiny glow-m">▌▌ FRONTIER MODEL RELEASE INTELLIGENCE ▐▐</div>
      <h1 class="logo"><span class="w">WHEN</span><span class="m">MODEL</span><span class="q">?</span></h1>
      <p class="tag-line">Intel by the weights. Watching the labs so you don't have to.</p>
    </div>
    <div class="hero-side">
      <div class="tiny muted">POWERED BY</div>
      <div class="brands">
        <a href="https://polymarket.com?utm_source=whenmodel.com" rel="noopener" target="_blank">Polymarket</a>
        <a href="https://openrouter.ai" rel="noopener" target="_blank">OpenRouter</a>
        <a href="https://huggingface.co" rel="noopener" target="_blank">Hugging Face</a>
        <a href="https://news.ycombinator.com" rel="noopener" target="_blank">Hacker News</a>
      </div>
      <a class="pill" href="/api/dashboard.json">◈ JSON API</a>
    </div>
  </div>
  <div class="ticker-wrap">
    <div class="ticker-controls">
      <button class="ticker-toggle tiny" type="button" data-ticker-toggle aria-pressed="false" aria-controls="ticker-track">PAUSE TICKER</button>
    </div>
    <div class="marquee mono glow-y" data-ticker>
      <p class="sr-only">Ticker: {ticker.join('. ')}</p>
      <div id="ticker-track" aria-hidden="true"><span class="ticker-group">{ticker.map((t) => <span class="ticker-item">▶ {t}</span>)}</span><span class="ticker-group ticker-copy">{ticker.map((t) => <span class="ticker-item">▶ {t}</span>)}</span></div>
    </div>
  </div>
</header>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(7,6,15,0) 0%, rgba(7,6,15,0.2) 60%, var(--bg) 100%),
      repeating-linear-gradient(90deg, rgba(255,43,214,0.12) 0 1px, transparent 1px 80px),
      repeating-linear-gradient(0deg, rgba(0,229,255,0.10) 0 1px, transparent 1px 40px);
    border-bottom: 2px solid var(--line);
  }
  /* A fixed horizon grid keeps the CRT character without competing with the data. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -40px 0 0 0;
    background: repeating-linear-gradient(0deg, rgba(0,229,255,0.08) 0 1px, transparent 1px 40px);
    pointer-events: none;
  }
  .statusbar, .hero-inner { position: relative; }
  .statusbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-block: 10px; flex-wrap: wrap; border-bottom: 1px solid var(--line-soft); }
  .statusbar .left, .statusbar .right { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; }
  .clock { font-size: 22px; font-variant-numeric: tabular-nums; }
  .hero-inner { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding-block: 34px 26px; flex-wrap: wrap; }
  .logo { font-size: clamp(30px, 6.5vw, 74px); line-height: 1; margin: 14px 0 12px; animation: rise 700ms var(--ease) both; }
  .logo .w { color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.5), 4px 4px 0 var(--blue); }
  .logo .m { color: var(--magenta); text-shadow: 0 0 12px var(--magenta), 4px 4px 0 var(--cyan); }
  .logo .q { color: var(--yellow); text-shadow: 0 0 7px rgba(255, 226, 28, 0.5); }
  .tag-line { font-size: var(--fs-lg); color: var(--cyan); letter-spacing: 0.04em; animation: rise 700ms var(--ease) 120ms both; }
  .hero-side { text-align: right; display: flex; flex-direction: column; gap: 8px; align-items: flex-end; animation: rise 700ms var(--ease) 200ms both; }
  .brands { display: flex; gap: 14px; flex-wrap: wrap; justify-content: flex-end; font-size: var(--fs-body); }
  .brands a { border-bottom: 1px dotted var(--line2); }
  .status-live::before { content: '◉'; margin-right: 5px; }
  .ticker-toggle { min-height: 44px; padding: 6px 8px; color: var(--yellow); background: var(--bg2); border: 1px solid var(--line2); cursor: pointer; }
  .ticker-toggle[aria-pressed="true"] { color: var(--text); border-color: var(--cyan); }
  @media (max-width: 700px) { .hero-side { align-items: flex-start; text-align: left; } .brands { justify-content: flex-start; } }
  @media (max-width: 480px) {
    .statusbar { gap: 6px; padding-block: 7px; }
    .statusbar .left, .statusbar .right { gap: 8px; }
    .hero-inner { padding-block: 18px 16px; gap: 10px; }
    .logo { margin: 8px 0; }
    .tag-line { font-size: var(--fs-sm); }
    .hero-side { width: 100%; flex-direction: row; align-items: center; }
    .hero-side > .tiny { display: none; }
    .brands { flex: 1; gap: 8px; font-size: var(--fs-xs); }
  }
</style>
<script>
  const clock = document.querySelector('[data-clock]');
  const refresh = document.querySelector<HTMLElement>('[data-refresh]');
  const ticker = document.querySelector<HTMLElement>('[data-ticker]');
  const tickerToggle = document.querySelector<HTMLButtonElement>('[data-ticker-toggle]');
  const total = Number(refresh?.dataset.refresh ?? 300);
  const started = Date.now();
  const tick = () => {
    if (clock) clock.textContent = new Date().toISOString().slice(11, 19) + 'Z';
    const left = Math.max(0, total - Math.floor((Date.now() - started) / 1000));
    if (refresh) refresh.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
    if (left === 0) reload();
  };
  // The page is edge-cached and cheap to reload; wait for a visible tab so a background tab doesn't churn.
  let reloading = false;
  const reload = () => {
    if (reloading) return;
    reloading = true;
    if (document.visibilityState === 'visible') location.reload();
    else document.addEventListener('visibilitychange', () => location.reload(), { once: true });
  };
  tick();
  setInterval(tick, 1000);
  tickerToggle?.addEventListener('click', () => {
    const paused = tickerToggle.getAttribute('aria-pressed') !== 'true';
    tickerToggle.setAttribute('aria-pressed', String(paused));
    tickerToggle.textContent = paused ? 'RESUME TICKER' : 'PAUSE TICKER';
    ticker?.classList.toggle('is-paused', paused);
  });
</script>
