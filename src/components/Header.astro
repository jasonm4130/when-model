---
import type { Dashboard } from '../domain/dashboard';
import { dashboardFingerprint } from '../ui/fingerprint';
import { BEST_EFFORT_SOURCES } from '../domain/sources';
interface Props { d: Dashboard }
const { d } = Astro.props;
const okCount = d.sources.filter((s) => s.ok).length;
// The count covers every source; the status only those the dashboard depends on.
const core = d.sources.filter((s) => !BEST_EFFORT_SOURCES.has(s.name));
const coreOk = core.filter((s) => s.ok).length;
const status = coreOk === core.length ? 'OPERATIONAL' : coreOk > core.length / 2 ? 'DEGRADED' : 'IMPAIRED';
const statusClass = status === 'OPERATIONAL' ? 'ok' : 'warn';
/** The client polls /api/dashboard.json on this cadence and compares a fingerprint before offering a reload. */
const REFRESH_SECONDS = 300;
/** What this render shows, so the poll can tell data the reader has never seen from data they have. */
const fingerprint = dashboardFingerprint(d);
---
<header class="masthead">
  <div class="wrap mast">
    <div class="statusbar">
      <span class="left">
        <span class={`tiny status-live ${statusClass}`}>STATUS: {status}</span>
        <span class="tiny muted counts">{d.labs.length} LABS · {okCount}/{d.sources.length} SOURCES · {d.markets.length} MARKETS</span>
      </span>
      <span class="right">
        <span class="tiny muted sync">SYNC <span data-synced={d.generatedAt}>{d.generatedAt.slice(11, 19)}Z</span> · NEXT <span class="next" data-refresh={REFRESH_SECONDS}>{`${Math.floor(REFRESH_SECONDS / 60)}:00`}</span></span>
        <span class="clock tiny" data-clock>{d.generatedAt.slice(11, 19)}Z</span>
        <button type="button" class="tiny refresh-toggle" data-refresh-toggle aria-pressed="false"><span data-refresh-verb>PAUSE</span><span class="rt-noun"> AUTO-REFRESH</span></button>
        <span class="refresh-status" aria-live="polite" data-reload-status data-fingerprint={fingerprint}></span>
      </span>
    </div>
    <div class="brand">
      <h1 class="wordmark">when<span class="m">model</span><span class="sr-only">: frontier model release intelligence</span></h1>
      <p class="tag-line">Intel by the weights. Watching the labs so you don't have to.</p>
    </div>
  </div>
</header>
<style>
  .masthead { border-bottom: 1px solid var(--ink); }
  .mast { display: grid; gap: 2px; padding-bottom: 14px; }
  /* A dateline across the top, as on a newspaper, then the wordmark. */
  .statusbar { display: flex; justify-content: space-between; align-items: center; gap: 0 24px; flex-wrap: wrap; border-bottom: 1px solid var(--rule-soft); }
  .statusbar .left, .statusbar .right { display: flex; align-items: center; gap: 0 20px; flex-wrap: wrap; }
  .statusbar .right { margin-left: auto; }
  .brand { display: flex; align-items: baseline; justify-content: space-between; gap: 4px 20px; flex-wrap: wrap; min-width: 0; padding-top: 12px; }
  /* The wordmark is the display face at its narrowest, "model" in the one colour. */
  .wordmark { font-size: 40px; line-height: 1; color: var(--ink); }
  .wordmark .m { color: var(--accent); }
  .tag-line { font-size: var(--fs-sm); font-style: italic; color: var(--ink-2); }
  .status-live { display: inline-flex; align-items: center; gap: 7px; color: var(--ink); }
  .status-live::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--ink); }
  .status-live.warn { color: var(--accent-ink); }
  .status-live.warn::before { background: var(--accent); }
  .clock, .next { font-variant-numeric: tabular-nums; }
  .clock { color: var(--ink); }
  .refresh-toggle { min-height: 44px; padding: 0 2px; color: var(--ink); background: none; border: 0; cursor: pointer; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.35em; text-decoration-color: var(--line2); }
  .refresh-toggle:hover { color: var(--accent-ink); text-decoration-color: currentColor; }
  .refresh-toggle[aria-pressed="true"] { color: var(--accent-ink); }
  .refresh-status { display: inline-flex; }
  @media (max-width: 480px) {
    /* UI-06: a phone keeps the wordmark, the status, the clock and the pause, so the level starts right under them. */
    .mast { padding-bottom: 8px; }
    .brand { padding-top: 6px; }
    .wordmark { font-size: 30px; }
    .tag-line, .counts, .sync { display: none; }
    .statusbar, .statusbar .right { gap: 0 14px; }
    /* The pause stays: a 44px target that reads PAUSE, while its accessible name keeps AUTO-REFRESH. */
    .refresh-toggle { min-width: 44px; }
    .rt-noun { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  }
</style>
<script>
  import { dashboardFingerprint } from '../ui/fingerprint';

  const clock = document.querySelector('[data-clock]');
  const refresh = document.querySelector<HTMLElement>('[data-refresh]');
  const refreshToggle = document.querySelector<HTMLButtonElement>('[data-refresh-toggle]');
  const reloadStatus = document.querySelector<HTMLElement>('[data-reload-status]');
  const total = Number(refresh?.dataset.refresh ?? 300);

  // UI-11: a hard `location.reload()` every 5 minutes collapsed open <details> and dropped focus.
  // Poll instead, compare a fingerprint that ignores generatedAt, and only reload on our own initiative
  // when nothing the reader is doing would be interrupted.
  const STORAGE_KEY = 'whenmodel:autoRefreshPaused';
  const readPaused = (): boolean => {
    try {
      return localStorage.getItem(STORAGE_KEY) === 'true';
    } catch {
      return false; // private browsing, a full quota, or a disabled store: default to refreshing
    }
  };
  const writePaused = (next: boolean) => {
    try {
      localStorage.setItem(STORAGE_KEY, String(next));
    } catch {
      /* the toggle still works for this tab even if it can't persist */
    }
  };
  let autoRefreshPaused = readPaused();
  const refreshVerb = refreshToggle?.querySelector<HTMLElement>('[data-refresh-verb]');
  const showPaused = () => {
    refreshToggle?.setAttribute('aria-pressed', String(autoRefreshPaused));
    if (refreshVerb) refreshVerb.textContent = autoRefreshPaused ? 'RESUME' : 'PAUSE';
  };
  showPaused();

  // The baseline is what this page rendered, not the first poll: a tab opened in the background and read
  // twenty minutes later must still offer the data it has never shown.
  let baseline = reloadStatus?.dataset.fingerprint || null;
  let pendingReload = false;

  const showReloadPill = () => {
    if (pendingReload || !reloadStatus) return;
    pendingReload = true;
    const pill = document.createElement('button');
    pill.type = 'button';
    pill.className = 'pill warn';
    pill.textContent = 'NEW DATA · RELOAD';
    pill.addEventListener('click', () => location.reload());
    reloadStatus.replaceChildren(pill);
  };

  const poll = async () => {
    if (document.visibilityState !== 'visible') return;
    try {
      const res = await fetch('/api/dashboard.json', { cache: 'no-store' });
      if (!res.ok) return;
      const body: unknown = await res.json();
      if (!body || typeof body !== 'object') return;
      const fp = dashboardFingerprint(body);
      if (baseline === null) {
        baseline = fp; // no rendered fingerprint to compare with: this poll becomes the baseline
        return;
      }
      if (fp !== baseline) {
        baseline = fp;
        showReloadPill();
      }
    } catch {
      // offline, an aborted fetch or a body that isn't JSON: the next interval tries again
    }
  };

  // A reader typing in the FAQ search, mid-drag, or with a details panel open shouldn't be yanked away.
  let lastActivity = Date.now();
  const markActive = () => {
    lastActivity = Date.now();
  };
  for (const type of ['pointerdown', 'keydown', 'touchstart', 'scroll']) {
    document.addEventListener(type, markActive, { passive: true });
  }
  const isFocusInControl = (): boolean => {
    const active = document.activeElement;
    if (!active || active === document.body) return false;
    return active.closest('a, button, input, select, textarea, summary, [tabindex]') !== null;
  };
  const isIdle = (): boolean =>
    Date.now() - lastActivity >= 60_000 && !document.querySelector('details[open]') && !isFocusInControl();
  const maybeAutoReload = () => {
    if (pendingReload && !autoRefreshPaused && isIdle()) location.reload();
  };
  setInterval(maybeAutoReload, 5_000);

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') poll();
  });

  let started = Date.now();
  const tick = () => {
    if (clock) clock.textContent = new Date().toISOString().slice(11, 19) + 'Z';
    const left = Math.max(0, total - Math.floor((Date.now() - started) / 1000));
    if (refresh) refresh.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
    if (left === 0) {
      started = Date.now();
      poll();
    }
  };
  tick();
  setInterval(tick, 1000);

  refreshToggle?.addEventListener('click', () => {
    autoRefreshPaused = !autoRefreshPaused;
    writePaused(autoRefreshPaused);
    showPaused();
  });
</script>
