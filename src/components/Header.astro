---
import type { Dashboard } from '../domain/dashboard';
import { dayLabel } from '../ui/departures';
import { pageFingerprint } from '../ui/fingerprint';
import { BEST_EFFORT_SOURCES } from '../domain/sources';
import type { PageView, SiteView } from '../ui/site';
import SiteNav from './SiteNav.astro';
interface Props {
  /** The dashboard this page rendered. /backtest reads none: it gets no status and never polls. */
  d?: Dashboard;
  view: SiteView;
}
const { d, view } = Astro.props;
// The status covers only the sources the dashboard depends on; the footer counts every one.
const core = d ? d.sources.filter((s) => !BEST_EFFORT_SOURCES.has(s.name)) : [];
const coreOk = core.filter((s) => s.ok).length;
const status = coreOk === core.length ? 'OPERATIONAL' : coreOk > core.length / 2 ? 'DEGRADED' : 'IMPAIRED';
const statusClass = status === 'OPERATIONAL' ? 'ok' : 'warn';
/**
 * What this page shows, so the poll can tell data the reader has never seen from data they have.
 * Each page hashes only its own slice: a change only /radar shows never offers NEW DATA on `/`.
 */
const pageView: PageView | undefined = view.page === 'backtest' || view.page === 'not-found' ? undefined : view;
const fingerprint = d && pageView ? pageFingerprint(d, pageView) : undefined;
const built = d ? Date.parse(d.generatedAt) : undefined;
---
<header class="top">
  <div class="wrap top-row">
    <a class="wordmark" href="/">whenmodel<span class="sr-only">: frontier model release intelligence, home</span></a>
    <SiteNav view={view} />
    {d && built !== undefined && (
      <div class="top-right">
        <span class={`status-live ${statusClass}`} title={`${coreOk} of ${core.length} core sources answered this build`}><span class="sr-only">Sources </span>{status}</span>
        <span class="when mono"><span class="day">{dayLabel(built, built)} · </span><b class="clock" data-clock>{d.generatedAt.slice(11, 16)}Z</b></span>
        <button type="button" class="refresh-toggle" data-refresh-toggle aria-pressed="false"><span data-refresh-verb>PAUSE</span><span class="rt-noun"> AUTO-REFRESH</span></button>
        <span class="refresh-status" aria-live="polite" data-reload-status data-fingerprint={fingerprint} data-view={JSON.stringify(pageView)}></span>
      </div>
    )}
  </div>
</header>
<style>
  .top { border-bottom: 2px solid var(--rule); }
  .top-row { display: flex; align-items: center; gap: var(--s2) var(--s6); min-height: 64px; flex-wrap: wrap; }
  .wordmark { font-size: var(--t-md); line-height: 28px; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; }
  .wordmark:hover { text-decoration: none; }
  .top-right { display: flex; align-items: center; gap: var(--s4); margin-left: auto; font-size: var(--t-sm); line-height: 20px; color: var(--ink-2); }
  .status-live { display: inline-flex; align-items: center; gap: var(--s2); font-size: var(--t-xs); line-height: 16px; font-weight: 600; letter-spacing: 0.08em; color: var(--ink); white-space: nowrap; }
  .status-live::before { content: ''; width: 8px; height: 8px; background: var(--ink); }
  .status-live.warn::before { background: var(--notice); outline: 1.5px solid var(--ink); }
  .when { white-space: nowrap; }
  .when b { font-weight: 500; color: var(--ink); }
  .refresh-toggle { min-height: 44px; min-width: 44px; padding: 0 var(--s1); background: none; border: 0; cursor: pointer; font-size: var(--t-xs); line-height: 16px; font-weight: 600; letter-spacing: 0.08em; color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--rule-soft); }
  .refresh-toggle:hover { text-decoration-color: currentColor; }
  .refresh-toggle[aria-pressed='true'] { background: var(--notice); text-decoration: none; padding: 0 var(--s2); }
  .refresh-status { display: inline-flex; }
  .refresh-status:empty { display: none; }
  @media (max-width: 1100px) {
    .when .day { display: none; }
  }
  @media (max-width: 900px) {
    .top-row { padding-top: var(--s2); padding-bottom: 0; column-gap: var(--s3); }
    .top-row > :global(.site-nav) { order: 3; flex-basis: 100%; }
    .top-right { gap: var(--s3); }
    .rt-noun { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  }
  @media (max-width: 359.98px) {
    .top-right { gap: var(--s2); }
  }
</style>
<script>
  import { monthName, weekdayName } from '../domain/dates';
  import { pageFingerprint } from '../ui/fingerprint';
  import { ago } from '../ui/format';
  import type { PageView } from '../ui/site';

  const clock = document.querySelector('[data-clock]');
  const clockDay = document.querySelector('.when .day');
  const refresh = document.querySelector<HTMLElement>('[data-refresh]');
  const refreshToggle = document.querySelector<HTMLButtonElement>('[data-refresh-toggle]');
  const reloadStatus = document.querySelector<HTMLElement>('[data-reload-status]');
  // Which page this is: the poll hashes the same slice of the dashboard the server rendered here.
  const view = ((): PageView | undefined => {
    try {
      return JSON.parse(reloadStatus?.dataset.view ?? '') as PageView;
    } catch {
      return undefined; // /backtest: no dashboard, nothing to poll
    }
  })();
  const total = Number(refresh?.dataset.refresh ?? 300);

  // UI-11: a hard `location.reload()` every 5 minutes collapsed open <details> and dropped focus.
  // Poll instead, compare a fingerprint that ignores generatedAt, and only reload on our own initiative
  // when nothing the reader is doing would be interrupted.
  const STORAGE_KEY = 'whenmodel:autoRefreshPaused';
  const readPaused = (): boolean => {
    try {
      return localStorage.getItem(STORAGE_KEY) === 'true';
    } catch {
      return false; // private browsing, a full quota, or a disabled store: default to refreshing
    }
  };
  const writePaused = (next: boolean) => {
    try {
      localStorage.setItem(STORAGE_KEY, String(next));
    } catch {
      /* the toggle still works for this tab even if it can't persist */
    }
  };
  let autoRefreshPaused = readPaused();
  const refreshVerb = refreshToggle?.querySelector<HTMLElement>('[data-refresh-verb]');
  const showPaused = () => {
    refreshToggle?.setAttribute('aria-pressed', String(autoRefreshPaused));
    if (refreshVerb) refreshVerb.textContent = autoRefreshPaused ? 'RESUME' : 'PAUSE';
  };
  showPaused();

  // The baseline is what this page rendered, not the first poll: a tab opened in the background and read
  // twenty minutes later must still offer the data it has never shown.
  let baseline = reloadStatus?.dataset.fingerprint || null;
  let pendingReload = false;

  const showReloadPill = () => {
    if (pendingReload || !reloadStatus) return;
    pendingReload = true;
    const pill = document.createElement('button');
    pill.type = 'button';
    pill.className = 'pill warn';
    pill.textContent = 'NEW DATA · RELOAD';
    pill.addEventListener('click', () => location.reload());
    reloadStatus.replaceChildren(pill);
  };

  const poll = async () => {
    if (!view || document.visibilityState !== 'visible') return;
    try {
      const res = await fetch('/api/dashboard.json', { cache: 'no-store' });
      if (!res.ok) return;
      const body: unknown = await res.json();
      if (!body || typeof body !== 'object') return;
      const fp = pageFingerprint(body, view);
      if (baseline === null) {
        baseline = fp; // no rendered fingerprint to compare with: this poll becomes the baseline
        return;
      }
      if (fp !== baseline) {
        baseline = fp;
        showReloadPill();
      }
    } catch {
      // offline, an aborted fetch or a body that isn't JSON: the next interval tries again
    }
  };

  // A reader typing in the FAQ search, mid-drag, or with a details panel open shouldn't be yanked away.
  let lastActivity = Date.now();
  const markActive = () => {
    lastActivity = Date.now();
  };
  for (const type of ['pointerdown', 'keydown', 'touchstart', 'scroll']) {
    document.addEventListener(type, markActive, { passive: true });
  }
  const isFocusInControl = (): boolean => {
    const active = document.activeElement;
    if (!active || active === document.body) return false;
    return active.closest('a, button, input, select, textarea, summary, [tabindex]') !== null;
  };
  const isIdle = (): boolean =>
    Date.now() - lastActivity >= 60_000 && !document.querySelector('details[open]') && !isFocusInControl();
  const maybeAutoReload = () => {
    if (pendingReload && !autoRefreshPaused && isIdle()) location.reload();
  };
  setInterval(maybeAutoReload, 5_000);

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') poll();
  });

  let started = Date.now();
  const tick = () => {
    const at = new Date();
    if (clock) clock.textContent = at.toISOString().slice(11, 16) + 'Z';
    if (clockDay) clockDay.textContent = `${weekdayName(at)} ${at.getUTCDate()} ${monthName(at)} · `;
    const left = Math.max(0, total - Math.floor((Date.now() - started) / 1000));
    if (refresh) refresh.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
    if (left === 0) {
      started = Date.now();
      poll();
    }
  };
  tick();
  setInterval(tick, 1000);

  refreshToggle?.addEventListener('click', () => {
    autoRefreshPaused = !autoRefreshPaused;
    writePaused(autoRefreshPaused);
    showPaused();
  });

  // Relative times and source pills age while the page stays open, and an edge-cached page can be
  // minutes old on arrival, so every page brings them up to date at load and every 30 seconds after.
  const age = () => {
    const now = Date.now();
    document.querySelectorAll<HTMLElement>('[data-time]').forEach((el) => {
      el.textContent = ago(el.dataset.time!, now);
    });
    document.querySelectorAll<HTMLElement>('[data-source-pill][data-stale-at]').forEach((el) => {
      if (Date.parse(el.dataset.staleAt!) > now) return;
      el.textContent = el.dataset.staleText ?? el.textContent;
      el.classList.remove('live');
      el.classList.add('warn');
      el.removeAttribute('data-stale-at');
    });
  };
  age();
  setInterval(age, 30_000);
</script>
